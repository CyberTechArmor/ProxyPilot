# ProxyPilot Environment Configuration — canonical key list
#
# This file is the source of truth for which environment variables
# ProxyPilot expects. install.sh generates a populated .env from this
# template; update.sh compares against it on every upgrade and appends
# any newly-introduced keys with a `# TODO` placeholder so existing
# installs don't silently start without required configuration.
#
# Never commit a real .env file. Real secrets live only in /opt/proxypilot/.env
# (or wherever the install was placed) with mode 0600.

# Server Configuration
PORT=3001
NODE_ENV=production
DOMAIN=admin.example.com

# Authentication — generate via: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_BYTES_RANDOM
SESSION_SECRET=CHANGE_ME_64_BYTES_RANDOM

# DB-at-rest encryption key for TOTP secrets and other sensitive
# columns. 32 bytes hex. Generate via: openssl rand -hex 32
# Losing this key means existing TOTP secrets cannot be decrypted —
# every user will need to re-enroll their authenticator.
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Admin User (consumed only on first boot to seed the user row)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Database — lives in a dedicated subdirectory so the surrounding
# `data/` directory can stay world-traversable for Caddy. The DB
# directory itself is locked to 0700 by db.js on every boot; the DB
# file to 0600. Pre-update SQLite backups are placed alongside it.
DATABASE_PATH=/data/db/proxypilot.db

# Account lockout (consumed by routes/auth.js)
# - MAX_FAILURES: lock the account after this many failed attempts
# - FAILURE_WINDOW_MIN: failures outside this window restart the
#   streak counter (so a slow drip of typos doesn't accumulate)
# - LOCKOUT_MIN: how long the lock holds before the user can retry
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MIN=30
LOGIN_LOCKOUT_MIN=30

# Session lifetime (consumed by middleware/auth.js)
# - TTL_HOURS: absolute upper bound on a single login (re-login
#   required past this regardless of activity)
# - IDLE_HOURS: sliding inactivity window. Any authenticated request
#   resets it; idle past this many hours = session revoked.
# - RETENTION_DAYS: how long revoked / expired session rows stick
#   around for forensics before sweepStaleSessions() reaps them.
SESSION_TTL_HOURS=24
SESSION_IDLE_HOURS=4
SESSION_RETENTION_DAYS=30

# Streaming-terminal limits (consumed by routes/terminal-ws.js)
# - MAX_SESSIONS: refuse a 4th concurrent terminal from the same user
# - IDLE_TIMEOUT_MS: kill any session idle for >15 min
# - OUTPUT_BACKPRESSURE_BYTES: pause the PTY when ws.bufferedAmount
#   crosses this high-water mark, so a runaway producer (`yes`,
#   `find /`) can't self-DoS the browser tab.
TERMINAL_MAX_SESSIONS=3
TERMINAL_IDLE_TIMEOUT_MS=900000
TERMINAL_OUTPUT_BACKPRESSURE_BYTES=1000000

# Caddy Configuration Path
CADDY_SITES_DIR=/etc/caddy/sites
CADDY_CONFIG_FILE=/etc/caddy/Caddyfile
# Operator-owned directory for hand-written Caddy snippets that
# ProxyPilot must never rewrite. Imported from the main Caddyfile.
CADDY_CUSTOM_DIR=/etc/caddy/custom
ACME_EMAIL=

# Phase B host-side agent: route Caddy adapt + reload through
# proxypilot-agent (true) or the legacy nsenter execOnHost path
# (false). Phase B is dual-tracked: the new path is wired but
# disabled by default. Phase F flips this to `true` after burn-in
# on production. Leave it at `false` until then.
PROXYPILOT_USE_AGENT_FOR_CADDY=false

# ── Mock2 (dev/build module) — absence-by-installation (ADR-001) ──
# Mock2 is the reverse-trust dev-plane module (project containers the
# orchestrator writes into directly). It is OFF by default and MUST be
# absent on production hosts. Three layers gate it, checked at boot:
#   1. Pin file /etc/proxypilot/mock2.production.pin — if present, Mock2 is
#      hard-off no matter what this flag says (a warning is logged). The
#      operator creates the pin; ProxyPilot never writes it.
#   2. This flag. When false: no /api/mock2 route, no data/db/mock2.db file,
#      no model-credential store, no nav entry — a disabled host behaves
#      byte-for-byte like one that never shipped the module.
#   3. Enabling also requires at least one model connector before the runner
#      will do work (env var AND presence of credentials).
# A fresh install.sh now enables Mock2 by default (still prompts; the pin file
# forces it off). update.sh appends this key as `false` to existing hosts and
# never touches an existing value, so upgrades never SILENTLY enable it — an
# operator opts an upgrading host in explicitly with `update.sh --enable-mock2`.
MOCK2_ENABLED=false

# Runtime data root for Mock2 (per-project bare git repos, framework seed,
# per-domain certs — populated by later phases). Created only when Mock2 is
# enabled. Note: the Mock2 SQLite state file itself lives next to the main
# DB at data/db/mock2.db, not here.
MOCK2_DATA_DIR=/var/lib/proxypilot/mock2

# Directory for Mock2-owned Caddy site files (Phase M1). Mock2 writes one file
# per parent domain here and adds a single `import <dir>/*.caddy` line to the
# main Caddyfile — it never touches the per-service /etc/caddy/sites tree or the
# operator's /etc/caddy/custom tree. Only written on an enabled host.
MOCK2_CADDY_DIR=/etc/caddy/mock2

# This host's public IP(s), comma-separated (Phase M1). Used to cross-check that
# a parent domain's wildcard DNS actually points here before requesting a probe
# certificate. Leave blank to skip the cross-check (the wildcard still has to
# resolve to *something*, it just isn't compared to this host's address). Also
# cross-checks a project's custom-domain A record (Phase M2).
MOCK2_PUBLIC_IP=

# Base Incus image for Mock2 project containers (Phase M2). Each project is
# launched unprivileged as m2-<id> on its own per-project bridge (Phase M4) from
# this image. Only used on an enabled host; override for hosts that mirror
# images elsewhere.
MOCK2_BASE_IMAGE=images:debian/12

# Filtering egress proxy port (Phase M4, ADR-010). Each project container is
# fenced to a default-deny bridge and reaches the internet ONLY through the
# host's squid proxy on this port (HTTP(S)_PROXY is baked into the container
# env). squid is installed only when Mock2 is enabled (scripts/mock2-enable-
# egress.sh, run by install.sh on enable). If you change this, re-run that
# script so squid's http_port matches. Default is squid's standard 3128.
MOCK2_EGRESS_PROXY_PORT=3128

# Egress policy mode (Phase M4, ADR-010). 'allowlist' (default) restricts each
# project container to its per-project allowlisted hosts. 'allow-all' is MONITOR
# mode: every project bridge may reach any host, but egress is still funneled
# through squid so its access log records every destination — use it to discover
# what to allow, then switch back to enforce. This is the default when no admin
# has set the mode in the UI (Project → Egress); the stored setting overrides it.
MOCK2_EGRESS_MODE=allowlist

# Integration-gate mode (the block/approve loop relief valve). Controls what the
# integration-truthfulness gate does with a build it would block at finish:
#   'enforce' (default) — block until an admin resolves it (the safe posture).
#   'pending'           — deploy the build instead and record the outstanding
#                         LIVE checks as pending-operator-verification, so you can
#                         test the running app; the honesty check moves to a human
#                         live check rather than being dropped.
#   'monitor'           — record the findings but never block or pend; the build
#                         completes so you can see it run. Loosest.
# This is the default when no admin has set the mode in the UI (Admin queue →
# Integration gate mode); the stored setting overrides it.
MOCK2_INTEGRATION_GATE_MODE=enforce

# Path to squid's access log on the host, read (best-effort, read-only) to show
# a project's egress traffic in the UI (Project → Egress → Traffic log). Default
# is Debian's standard location.
MOCK2_EGRESS_ACCESS_LOG=/var/log/squid/access.log

# Which build runner drives a mock2 build cycle. Unset/empty (the default) uses the
# hand-rolled, provider-agnostic loop — unchanged behavior. Set to "sdk" to drive the
# cycle with the Claude Agent SDK (@anthropic-ai/claude-agent-sdk) instead — Phase 1 of
# docs/agent-sdk-migration.md. The SDK path needs an Anthropic build_runner connector
# AND the SDK installed out-of-band (it is intentionally NOT a package.json dependency
# because its zod@^4 peer conflicts with the backend's zod@^3):
#   cd admin/backend && npm install @anthropic-ai/claude-agent-sdk --no-save --legacy-peer-deps
# Fully reversible by clearing this flag; with the flag unset the SDK is never imported.
BUILD_RUNNER=

# Web search for the build chat's ASK lane (questions about the codebase /
# bounded read-and-run tasks). Uses the Claude API's SERVER-SIDE web_search tool:
# the search runs inside Anthropic's infrastructure during the model call, so
# the project fence stays sealed and no extra credentials are needed. Anthropic
# connectors only (other providers never get the tool). Default ON for the ask
# lane; set 'off' to disable. Billed by Anthropic per search on top of tokens.
MOCK2_WEB_SEARCH=on

# Same, for the BUILD runner (the audited change cycles). Default OFF — builds
# stay deterministic unless the operator opts in. Set 'on' to let build cycles
# look up e.g. API documentation mid-build (Anthropic connectors only).
MOCK2_RUNNER_WEB_SEARCH=off

# No-progress circuit breaker threshold (harness safety, both runners). A build cycle
# that makes no progress for this many consecutive turns — no tool call, near-identical
# repeated responses, or the same action with no state change — is auto-halted as
# BLOCKED (needs attention, resumable) instead of re-prompting forever. Small single
# digit; default 3, clamped to >=2. See docs/agent-sdk-migration.md.
BUILD_NO_PROGRESS_LIMIT=3

# ---- e2e/journey smoke gate connectors (relevance-gated escalation) ----
# After a build deploys, a smoke gate runs the cheap HTTP/API journey check ALWAYS.
# Two heavier connectors escalate ONLY when the change's diff/metadata warrants them
# (browser: user-facing render/flow paths → rendered-DOM interaction checks from the
# project's state/ui-checks.json; db: data/state paths → migrations applied to a COPY
# of the database + a boot check) — never on every cycle. Both are ON by default
# (a UI regression once shipped through five green gates because nothing exercised
# the rendered DOM), and a warranted-but-unrunnable connector FAILS the cycle rather
# than silently passing. The browser connector needs `playwright` installed in
# admin/backend (npm install playwright) + a Chromium; without it, triggered cycles
# fail visibly until it is installed or the connector is explicitly disabled.
# Every run/skip + reason is logged on the cycle. See docs/agent-sdk-migration.md.
SMOKE_BROWSER_ENABLED=true       # drive the deployed UI via Playwright on a browser trigger
SMOKE_DB_ENABLED=true            # migration dry-run on a DB copy + boot check on a data trigger
SMOKE_GATE_ENFORCING=false       # true → a failing always-on HTTP layer fails the cycle
SMOKE_REQUIRE_TRIGGERED=true     # a warranted-but-disabled/unavailable connector fails the cycle
# Optional: point the browser connector at a system/pre-provisioned Chromium
# instead of the revision the installed playwright package would download:
# SMOKE_BROWSER_EXECUTABLE=/usr/bin/chromium
# Optional comma-separated glob overrides (defaults cover public/**, *.html/css/jsx,
# migrations/**, *.sql, schema/seed/bootstrap, etc.):
# SMOKE_BROWSER_GLOBS=public/**,**/*.html,**/*.css
# SMOKE_DB_GLOBS=migrations/**,**/*.sql,**/schema/**
