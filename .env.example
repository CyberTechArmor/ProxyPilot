# ProxyPilot Environment Configuration — canonical key list
#
# This file is the source of truth for which environment variables
# ProxyPilot expects. install.sh generates a populated .env from this
# template; update.sh compares against it on every upgrade and appends
# any newly-introduced keys with a `# TODO` placeholder so existing
# installs don't silently start without required configuration.
#
# Never commit a real .env file. Real secrets live only in /opt/proxypilot/.env
# (or wherever the install was placed) with mode 0600.

# Server Configuration
PORT=3001
NODE_ENV=production
DOMAIN=admin.example.com

# Authentication — generate via: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64_BYTES_RANDOM
SESSION_SECRET=CHANGE_ME_64_BYTES_RANDOM

# DB-at-rest encryption key for TOTP secrets and other sensitive
# columns. 32 bytes hex. Generate via: openssl rand -hex 32
# Losing this key means existing TOTP secrets cannot be decrypted —
# every user will need to re-enroll their authenticator.
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS

# Admin User (consumed only on first boot to seed the user row)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_TOTP_SECRET=

# Database — lives in a dedicated subdirectory so the surrounding
# `data/` directory can stay world-traversable for Caddy. The DB
# directory itself is locked to 0700 by db.js on every boot; the DB
# file to 0600. Pre-update SQLite backups are placed alongside it.
DATABASE_PATH=/data/db/proxypilot.db

# Account lockout (consumed by routes/auth.js)
# - MAX_FAILURES: lock the account after this many failed attempts
# - FAILURE_WINDOW_MIN: failures outside this window restart the
#   streak counter (so a slow drip of typos doesn't accumulate)
# - LOCKOUT_MIN: how long the lock holds before the user can retry
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_MIN=30
LOGIN_LOCKOUT_MIN=30

# Session lifetime (consumed by middleware/auth.js)
# - TTL_HOURS: absolute upper bound on a single login (re-login
#   required past this regardless of activity)
# - IDLE_HOURS: sliding inactivity window. Any authenticated request
#   resets it; idle past this many hours = session revoked.
# - RETENTION_DAYS: how long revoked / expired session rows stick
#   around for forensics before sweepStaleSessions() reaps them.
SESSION_TTL_HOURS=24
SESSION_IDLE_HOURS=4
SESSION_RETENTION_DAYS=30

# Streaming-terminal limits (consumed by routes/terminal-ws.js)
# - MAX_SESSIONS: refuse a 4th concurrent terminal from the same user
# - IDLE_TIMEOUT_MS: kill any session idle for >15 min
# - OUTPUT_BACKPRESSURE_BYTES: pause the PTY when ws.bufferedAmount
#   crosses this high-water mark, so a runaway producer (`yes`,
#   `find /`) can't self-DoS the browser tab.
TERMINAL_MAX_SESSIONS=3
TERMINAL_IDLE_TIMEOUT_MS=900000
TERMINAL_OUTPUT_BACKPRESSURE_BYTES=1000000

# Caddy Configuration Path
CADDY_SITES_DIR=/etc/caddy/sites
CADDY_CONFIG_FILE=/etc/caddy/Caddyfile
# Operator-owned directory for hand-written Caddy snippets that
# ProxyPilot must never rewrite. Imported from the main Caddyfile.
CADDY_CUSTOM_DIR=/etc/caddy/custom
ACME_EMAIL=

# Phase B host-side agent: route Caddy adapt + reload through
# proxypilot-agent (true) or the legacy nsenter execOnHost path
# (false). Phase B is dual-tracked: the new path is wired but
# disabled by default. Phase F flips this to `true` after burn-in
# on production. Leave it at `false` until then.
PROXYPILOT_USE_AGENT_FOR_CADDY=false

# ── Mock2 (dev/build module) — absence-by-installation (ADR-001) ──
# Mock2 is the reverse-trust dev-plane module (project containers the
# orchestrator writes into directly). It is OFF by default and MUST be
# absent on production hosts. Three layers gate it, checked at boot:
#   1. Pin file /etc/proxypilot/mock2.production.pin — if present, Mock2 is
#      hard-off no matter what this flag says (a warning is logged). The
#      operator creates the pin; ProxyPilot never writes it.
#   2. This flag. When false: no /api/mock2 route, no data/db/mock2.db file,
#      no model-credential store, no nav entry — a disabled host behaves
#      byte-for-byte like one that never shipped the module.
#   3. Enabling also requires at least one model connector before the runner
#      will do work (env var AND presence of credentials).
# update.sh appends this key as `false` to existing hosts and never touches
# an existing value, so upgrades never silently enable it.
MOCK2_ENABLED=false

# Runtime data root for Mock2 (per-project bare git repos, framework seed,
# per-domain certs — populated by later phases). Created only when Mock2 is
# enabled. Note: the Mock2 SQLite state file itself lives next to the main
# DB at data/db/mock2.db, not here.
MOCK2_DATA_DIR=/var/lib/proxypilot/mock2
