# legacy-peer-deps: required so `npm install` / `npm ci` succeed with
# @anthropic-ai/claude-agent-sdk in dependencies (the Claude build harness).
# The SDK declares a zod@^4 PEER while this backend pins zod@^3 — a hard
# ERESOLVE under npm's default peer resolution. The SDK bundles its own runtime
# and does not load the app's zod for the query() surface we use (verified by
# the harness smoke test), so skipping peer enforcement here is safe. Committed
# so every install path — install.sh, update.sh, the Dockerfile builder, and a
# plain `npm install` — resolves identically without extra flags.
legacy-peer-deps=true
