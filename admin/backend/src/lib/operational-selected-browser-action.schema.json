{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proxypilot:browser-action:proposal:v1",
  "description": "Draft configuration contract. Import/save does not authorize execution or approve effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "attempt_id",
    "fence",
    "ordinal",
    "policy_sha256",
    "snapshot_ref",
    "candidate_ref",
    "approval_ref",
    "operation"
  ],
  "properties": {
    "schema": {
      "const": "proxypilot.browser-action.proposal.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "fence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "policy_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "candidate_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "approval_ref": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "destination_id",
            "url"
          ],
          "properties": {
            "kind": {
              "const": "navigate"
            },
            "destination_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "url": {
              "type": "string",
              "minLength": 8,
              "maxLength": 2048,
              "pattern": "^https?://[^\\s\\\\]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope",
            "selection_ref"
          ],
          "properties": {
            "kind": {
              "const": "read"
            },
            "scope": {
              "enum": [
                "visible_page",
                "selection"
              ]
            },
            "selection_ref": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref"
          ],
          "properties": {
            "kind": {
              "const": "click"
            },
            "element_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "dx",
            "dy"
          ],
          "properties": {
            "kind": {
              "const": "scroll"
            },
            "dx": {
              "type": "integer",
              "minimum": -2000,
              "maximum": 2000
            },
            "dy": {
              "type": "integer",
              "minimum": -2000,
              "maximum": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "input_ref"
          ],
          "properties": {
            "kind": {
              "const": "type"
            },
            "element_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "input_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "max_ms"
          ],
          "properties": {
            "kind": {
              "const": "wait"
            },
            "max_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "resource_ref"
          ],
          "properties": {
            "kind": {
              "const": "download"
            },
            "resource_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "selection_ref"
          ],
          "properties": {
            "kind": {
              "const": "copy"
            },
            "selection_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "clipboard_ref"
          ],
          "properties": {
            "kind": {
              "const": "paste"
            },
            "element_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "clipboard_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "area",
            "selection_ref"
          ],
          "properties": {
            "kind": {
              "const": "screenshot"
            },
            "area": {
              "enum": [
                "viewport",
                "selection"
              ]
            },
            "selection_ref": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9_-]+$"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "element_ref",
            "asset_ref"
          ],
          "properties": {
            "kind": {
              "const": "upload"
            },
            "element_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "asset_ref": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256",
                "mime_type",
                "byte_count"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mime_type": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "byte_count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "form_ref",
            "field_set_sha256"
          ],
          "properties": {
            "kind": {
              "const": "submit"
            },
            "form_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "field_set_sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
