# ---------------------------------------------------------------------------
# Base application configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# REQUIRED. PostgreSQL is the system of record.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# REQUIRED IN PRODUCTION. The canonical origin for emailed links (password
# resets, one-time sign-in). Deliberately NOT derived from request headers:
# trusting Host lets an attacker trigger a reset for someone else and have the
# genuine email carry a link to their domain. Production refuses to mint a link
# when this is unset.
APP_BASE_URL=https://portal.example.com

PORT=6525

# Where uploaded bytes and the encryption key live (the dataset itself is in
# PostgreSQL; these are blobs and the master key).
APP_DATA_DIR=./data

# Set to 1 ONLY when a trusted reverse proxy sits in front. Off, the socket
# address is used — a header can be forged, and every IP-keyed rate limit
# depends on this being truthful.
TRUSTED_PROXY=0

# Force the Secure flag on session cookies even when the app cannot see TLS
# itself (it is set automatically for direct TLS or X-Forwarded-Proto: https).
FORCE_SECURE_COOKIES=0

# ---------------------------------------------------------------------------
# Read-only SQL access (Admin → Integration → Database access)
# ---------------------------------------------------------------------------
# The name of the SELECT-only role the app provisions for reporting consumers.
READONLY_DB_ROLE=app_readonly
#
# For the app to issue/rotate that credential itself, its own role needs:
#     ALTER ROLE <app_role> CREATEROLE;
# It never needs superuser. If you would rather not grant CREATEROLE, provision
# the role by hand with scripts/provision-readonly.sql — the app will detect the
# missing privilege and say so instead of failing opaquely.

# Upload limits
MAX_UPLOAD_BYTES=26214400
MAX_ASSET_BYTES=5242880

# Sessions
# SESSION_PRUNE_GRACE_MS=86400000

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The acceptance suite TRUNCATES EVERY TABLE on start. Point it at a throwaway
# database, never a deployment's.
# TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5432/app_test
