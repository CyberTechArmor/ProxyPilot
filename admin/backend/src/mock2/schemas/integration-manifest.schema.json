{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mock2/integration-manifest",
  "title": "Mock2 integration manifest (state/integrations.json)",
  "description": "Versioned declaration of every external capability. Define appends confirmed entries; the integration gate, egress check, and operator-verification checklist all reference these entries. Source discovery backstops it — an undeclared outbound integration is a gate failure.",
  "type": "object",
  "required": ["schema_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "subsystem", "actions", "destination", "transport", "provenance", "live_verification", "egress"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "description": "stable identifier, e.g. workforce-provider" },
        "subsystem": { "type": "string", "description": "the src/<subsystem>/ the capability lives in" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "operation"],
            "properties": {
              "name": { "type": "string", "description": "e.g. test-connection, sync-workers" },
              "operation": { "type": "string", "description": "e.g. tls-and-oauth, fetch-and-persist" }
            }
          }
        },
        "destination": {
          "type": "object",
          "required": ["source", "key"],
          "properties": {
            "source": { "enum": ["env", "db", "db-config", "config", "unknown"] },
            "key": { "type": "string", "description": "e.g. adp.apiBaseUrl + adp.workersEndpoint" }
          }
        },
        "transport": { "type": "string", "description": "e.g. https-mtls, https, ldaps, grpc" },
        "provenance": {
          "type": "object",
          "required": ["response_to_output"],
          "properties": {
            "response_to_output": { "enum": ["required", "not_applicable"], "description": "required = persisted/returned data must derive from the transport response" }
          }
        },
        "live_verification": {
          "type": "object",
          "required": ["required"],
          "properties": { "required": { "type": "boolean" } }
        },
        "egress": {
          "type": "object",
          "required": ["classification"],
          "properties": { "classification": { "enum": ["public", "private", "local"] } }
        },
        "contract_test": { "type": ["string", "null"], "description": "path to the in-fence negative-path contract test" },
        "fixtures": {
          "type": "object",
          "properties": { "test_only_config": { "type": "array", "items": { "type": "string" } } }
        },
        "bootstrapped": { "type": "boolean", "description": "true when proposed by source discovery, pending operator confirmation" }
      }
    }
  }
}
