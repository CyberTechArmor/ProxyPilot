# proxypilot-agent — host-side RPC bridge for the ProxyPilot admin
# dashboard. The dashboard container connects via the Unix socket at
# /run/proxypilot-agent/proxypilot-agent.sock; this service binary
# listens there and dispatches incoming JSON-line RPC requests.
#
# The agent serves a partial set of typed operations. The web backend still
# has host-root authority: docs/core/security-host-boundary.md tracks S6.
# Kernel peer credentials allow only host UID 0 by default. A reviewed native
# or user-namespace deployment needs a root-owned unit override listing its
# host-observed backend UID; socket group membership alone is insufficient.
#
# IMPORTANT — boot-time race fix.
# The socket lives INSIDE a systemd-managed RuntimeDirectory rather
# than at /run/proxypilot-agent.sock directly. The original layout
# put the socket at the root of /run, which races with Docker on
# host reboot: if the dashboard container starts before this unit
# binds the socket, Docker's bind-mount auto-creates the path as an
# empty DIRECTORY, and the agent then fails to listen there with
# "bind: address already in use". The container then mounts an empty
# directory instead of a socket — both halves break.
#
# RuntimeDirectory=proxypilot-agent makes systemd create
# /run/proxypilot-agent/ as a real directory (mode 0750, owned by
# proxypilot-agent:proxypilot-agent) BEFORE ExecStart runs. Docker
# bind-mounts the directory rather than the socket file, so the
# socket inode is allowed to come and go inside it without affecting
# the mount. Before=docker.service makes systemd-managed Docker
# wait for us on boot.
#
[Unit]
Description=ProxyPilot host-side agent
After=network.target
# Boot order: agent must be ready before docker so the dashboard
# container's bind-mount of /run/proxypilot-agent/ resolves to the
# systemd-created RuntimeDirectory and not a Docker auto-create.
# `Before=docker.service` is silently ignored on hosts where Docker
# is not under systemd (e.g. snap-installed Docker).
Before=docker.service

[Service]
Type=simple
User=proxypilot-agent
Group=proxypilot-agent
ExecStart=/usr/local/bin/proxypilot-agent --socket=/run/proxypilot-agent/proxypilot-agent.sock --client-uids=0
Restart=on-failure
RestartSec=2
# Transport/resource limits, not an independent human-authorization boundary.
LimitNOFILE=512
TasksMax=128
MemoryMax=512M

# RuntimeDirectory is created by systemd at unit-start with the
# right ownership and mode, before ExecStart runs. The path is
# /run/<RuntimeDirectory>, so /run/proxypilot-agent/.
# RuntimeDirectoryPreserve=yes keeps the directory across systemctl
# stop/start cycles so Docker's bind-mount of the directory inode
# never goes stale.
#
# The second directory, /run/proxypilot-update/, is the self-update
# request drop box: the agent's update.request / update.check methods
# write request.json + a nonce file there (it is the only place the
# agent may write under ProtectSystem=strict besides /etc/caddy), and
# the root-owned proxypilot-update.path/.service pair picks the
# request up. 0750 + group proxypilot-agent means nothing else on the
# host can author a request. See docs/features/self-update.md.
RuntimeDirectory=proxypilot-agent proxypilot-update
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# The storage.* discovery methods (cmd/agent/methods/storage.go) run lsblk
# and `zpool import` label scanning, which read block devices directly;
# group `disk` owns /dev/sd*, /dev/nvme* on Debian/Ubuntu. smartctl still
# needs root (SG_IO / NVMe admin ioctls) and is filled in by the backend
# through its root path.
SupplementaryGroups=disk

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
RestrictRealtime=true

# Read/write paths the agent needs to drive caddy + incus + docker.
# /etc/caddy and /run are mandatory — Caddy is required, /run always
# exists. /var/lib/incus and /var/run/docker.sock are prefixed with
# `-` so a missing path is non-fatal: a minimal-install host without
# Incus (or a non-Docker host) won't refuse to start the unit. The
# methods that touch those paths land in Phases C and D — by then
# either the path exists, or the relevant feature flag stays off.
ReadWritePaths=/etc/caddy /run -/var/lib/incus -/var/run/docker.sock

[Install]
WantedBy=multi-user.target
