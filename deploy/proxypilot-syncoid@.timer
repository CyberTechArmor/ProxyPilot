# ProxyPilot — schedule for replication job %i. The per-job schedule is a
# drop-in written by set_replication_target:
#   /etc/systemd/system/proxypilot-syncoid@<name>.timer.d/schedule.conf
[Unit]
Description=ProxyPilot ZFS replication timer for job %i

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
