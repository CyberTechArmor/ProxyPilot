+  } finally { release(); }
+}
+
+/* The main branch as the remote has it, else the local one. */
+export function mainRef(git, wanted = process.env.MOCK2_QUEUE_MAIN) {
+  if (wanted) {
+    const commit = git.commit(wanted);
+    if (!commit) throw new QueueError(`--main ${wanted} names no commit`);
+    return { ref: wanted, commit };
+  }
+  const head = git.run(['symbolic-ref', '--quiet', 'refs/remotes/origin/HEAD'], { allowFail: true });
