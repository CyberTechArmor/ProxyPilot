+    if (isWord(a[k], 'UNIQUE', 'PRIMARY')) return includesWords(a, 'USING', 'INDEX') ? ok('constraint added USING INDEX') : no('unique or primary key built in place', 'it builds an index under a write lock: CREATE UNIQUE INDEX CONCURRENTLY first, then ADD CONSTRAINT … USING INDEX');
