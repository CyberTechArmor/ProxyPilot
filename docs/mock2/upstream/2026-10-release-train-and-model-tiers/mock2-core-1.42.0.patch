+}
+const COLUMN_OPTION = ['NULL', 'NOT', 'DEFAULT', 'COLLATE', 'CONSTRAINT', 'GENERATED', 'UNIQUE', 'PRIMARY', 'CHECK', 'REFERENCES', 'IDENTITY', 'STORAGE', 'COMPRESSION'];
+
+/* Decides ADD [COLUMN] [IF NOT EXISTS] name type [options]: refused unless every part is on the allow-list. */
+function addColumn(a, k) {
