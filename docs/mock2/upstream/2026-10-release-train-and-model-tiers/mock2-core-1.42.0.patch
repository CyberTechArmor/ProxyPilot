diff --git a/core/mock2/tests/gates-runner.test.mjs b/core/mock2/tests/gates-runner.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..16d1eff12e8de40628bafba04c583ba7c17f53d2
--- /dev/null
+++ b/core/mock2/tests/gates-runner.test.mjs
@@ -0,0 +1,255 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { parsePrompt, substitute } from '../templates/repo/.mock2/bin/gates.mjs';
+
+// The gate runner (1.42.0, L42-8): a release prompt's gates run through `.mock2/bin/gates.mjs`, which passes
+// values between commands itself (`SAVE`, `${SAVED:NAME}`), refuses placeholder text and empty values before
+// running anything, keeps saved values in `.mock2/evidence/gates/<prompt-hash>.json`, honours `done-when:`
+// (exit 3), runs only `readonly: true` gates in a dry run and never runs a section out of order without --resume.
+const GATES = fileURLToPath(new URL('../templates/repo/.mock2/bin/gates.mjs', import.meta.url));
+
+function repo() {
+  const dir = mkdtempSync(join(tmpdir(), 'mock2-gates-'));
+  spawnSync('git', ['init', '-q', dir]);
+  return dir;
+}
+const fence = (body) => `\`\`\`gate\n${body.trim()}\n\`\`\`\n`;
+function prompt(dir, text, name = 'prompt.md') { writeFileSync(join(dir, name), text); return name; }
+const gates = (dir, ...args) => spawnSync(process.execPath, [GATES, ...args], { cwd: dir, encoding: 'utf8' });
+
+const TWO_SECTIONS = `# Release
+
+## Step 0 — preconditions
+
+${fence(`
+gate: start
+run: echo ready
+readonly: true
+expect: ready
+SAVE TAG=echo "v1  two words *"
+`)}
+## Step 1 — act
+
+${fence(`
+done-when: test -f finished.txt
+gate: act
+run: printf '%s' \${SAVED:TAG} > acted.txt
+raw-saved: true
+gate: verify
+run: cat acted.txt
+readonly: true
+expect: \${SAVED:TAG}
+`)}`;
+
+test('L42-8 a placeholder in run:, expect: or SAVE is refused before anything runs, naming file:line (exit 2)', () => {
+  for (const [label, body, line] of [
+    ['run', 'gate: a\nrun: touch ran.txt\ngate: b\nrun: git show <pin>', 9],
+    ['expect', 'gate: a\nrun: touch ran.txt\ngate: b\nrun: echo x\nexpect: <digest>', 10],
+    ['SAVE', 'gate: a\nrun: touch ran.txt\nSAVE PIN=echo <…>', 8],
+    ['empty run', 'gate: a\nrun: touch ran.txt\ngate: b\nrun:', 9],
+    ['empty SAVE', 'gate: a\nrun: touch ran.txt\nSAVE PIN=', 8],
+    ['unfilled token', 'gate: a\nrun: touch ran.txt\ngate: b\nrun: git show {{pin}}', 9],
+  ]) {
+    const dir = repo();
+    try {
+      prompt(dir, `# R\n\n## Step 0 — x\n\n${fence(body)}`);
+      const r = gates(dir, 'prompt.md', '--section', '0');
+      assert.equal(r.status, 2, `${label}: ${r.stdout}${r.stderr}`);
+      assert.match(r.stderr, new RegExp(`prompt\\.md:${line}: `), `${label} names the line`);
+      assert.match(r.stderr, /nothing ran/);
+      assert.equal(existsSync(join(dir, 'ran.txt')), false, `${label}: no gate ran`);
+    } finally { rmSync(dir, { recursive: true, force: true }); }
+  }
+});
+
+test('L42-8 a value saved in one invocation is read by a later one, passed safely, and persisted as evidence', () => {
+  const dir = repo();
+  try {
+    prompt(dir, TWO_SECTIONS);
+    const first = gates(dir, 'prompt.md', '--section', '0');
+    assert.equal(first.status, 0, first.stdout + first.stderr);
+    assert.match(first.stdout, /^report: gates prompt\.md sha256:[0-9a-f]{12} section 0 — passed: 1\/1 passed — .* — evidence \.mock2\/evidence\/gates\/[0-9a-f]{64}\.json$/mu);
+    const files = readdirSync(join(dir, '.mock2/evidence/gates'));
+    assert.equal(files.length, 1);
+    const doc = JSON.parse(readFileSync(join(dir, '.mock2/evidence/gates', files[0]), 'utf8'));
+    assert.equal(doc.saved.TAG.value, 'v1  two words *');
+    const second = gates(dir, 'prompt.md', '--section', '1');
+    assert.equal(second.status, 0, second.stdout + second.stderr);
+    // No word splitting, no globbing: the value reached the command exactly.
+    assert.equal(readFileSync(join(dir, 'acted.txt'), 'utf8'), 'v1  two words *');
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 a saved value is never interpreted by the shell', () => {
+  const dir = repo();
+  try {
+    prompt(dir, `# R\n\n## Step 0 — x\n\n${fence(`
+gate: save
+SAVE X='$(touch pwned) \`touch pwned2\` ; touch pwned3'
+gate: use
+raw-saved: true
+run: printf '%s' \${SAVED:X} "in quotes \${SAVED:X}" "$(printf '%s' \${SAVED:X})"
+expect: $(touch pwned) \`touch pwned2\` ; touch pwned3in quotes $(touch pwned) \`touch pwned2\` ; touch pwned3$(touch pwned) \`touch pwned2\` ; touch pwned3
+`)}`);
+    const r = gates(dir, 'prompt.md', '--section', '0');
+    assert.equal(r.status, 0, r.stdout + r.stderr);
+    for (const f of ['pwned', 'pwned2', 'pwned3']) assert.equal(existsSync(join(dir, f)), false, `${f} was not created`);
+    assert.equal(substitute('a ${SAVED:X} "b ${SAVED:X}"').text, 'a "${MOCK2_SAVED_X}" "b ${MOCK2_SAVED_X}"');
+    assert.throws(() => substitute("echo '${SAVED:X}'"), /single quotes/);
+    const quoted = parsePrompt(`## Step 0\n\n${fence("gate: a\nSAVE X='1'\ngate: b\nrun: echo '${SAVED:X}'")}`);
+    assert.match(quoted.problems.map((p) => p.message).join(), /single quotes/);
+    const unknown = parsePrompt(`## Step 0\n\n${fence('gate: b\nrun: echo ${SAVED:NOPE}')}`);
+    assert.match(unknown.problems.map((p) => p.message).join(), /no SAVE NOPE= in this prompt produces it/);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 done-when true → exit 3 "already done"; a dry run executes only readonly gates and writes nothing', () => {
+  const dir = repo();
+  try {
+    prompt(dir, TWO_SECTIONS);
+    const dry = gates(dir, 'prompt.md', '--section', '1', '--dry-run');
+    assert.equal(dry.status, 0, dry.stdout + dry.stderr);
+    assert.match(dry.stdout, /act: not run \(dry run; not readonly\)/);
+    assert.match(dry.stdout, /verify: not run \(dry run; needs SAVED TAG/);
+    assert.equal(existsSync(join(dir, 'acted.txt')), false, 'the non-readonly gate did not run');
+    assert.equal(existsSync(join(dir, '.mock2')), false, 'a dry run writes no evidence');
+    writeFileSync(join(dir, 'finished.txt'), '');
+    const done = gates(dir, 'prompt.md', '--resume', '1');
+    assert.equal(done.status, 3, done.stdout + done.stderr);
+    assert.match(done.stdout, /already done/);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 a section runs out of order only with --resume', () => {
+  const dir = repo();
+  try {
+    prompt(dir, TWO_SECTIONS);
+    const refused = gates(dir, 'prompt.md', '--section', '1');
+    assert.equal(refused.status, 2);
+    assert.match(refused.stderr, /section 1 is out of order: section 0 has not passed .* --resume 1/);
+    assert.equal(existsSync(join(dir, 'acted.txt')), false);
+    const resumed = gates(dir, 'prompt.md', '--resume', '1');
+    // Resumed, the gate needing TAG (saved by section 0) fails rather than guessing it.
+    assert.equal(resumed.status, 1, resumed.stdout + resumed.stderr);
+    assert.match(resumed.stdout, /resumed out of order/);
+    assert.match(resumed.stdout, /needs SAVED TAG, which no earlier gate saved/);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 an expectation that fails stops at that gate (exit 1); a SAVE producing an empty value or placeholder text fails', () => {
+  const dir = repo();
+  try {
+    prompt(dir, `# R\n\n## Step 0 — x\n\n${fence(`
+gate: exit-code
+run: exit 4
+expect: exit 4
+gate: regex
+run: echo abc123
+expect: /^abc\\d+$/
+gate: wrong
+run: echo actual
+expect: wanted
+note: quoted on failure
+gate: never
+run: touch never.txt
+`)}`);
+    const r = gates(dir, 'prompt.md', '--section', '0');
+    assert.equal(r.status, 1);
+    assert.match(r.stdout, /exit-code: pass/);
+    assert.match(r.stdout, /regex: pass/);
+    assert.match(r.stdout, /wrong: FAIL — output "actual", expected "wanted"/);
+    assert.match(r.stdout, /note: quoted on failure/);
+    assert.equal(existsSync(join(dir, 'never.txt')), false);
+    for (const [cmd, why] of [['printf ""', /an empty value/], ["printf '\\074none\\076'", /placeholder text "<none>"/]]) {
+      prompt(dir, `# R\n\n## Step 0 — y\n\n${fence(`gate: s\nSAVE V=${cmd}`)}`, 'save.md');
+      const s = gates(dir, 'save.md', '--section', '0');
+      assert.equal(s.status, 1, s.stdout + s.stderr);
+      assert.match(s.stdout, why);
+    }
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 --check parses a prompt and runs nothing; prose fences and unnumbered sections hold no gates', () => {
+  const text = `# R\n\n\`\`\`text\ngate: not-a-gate\nrun: <anything>\n\`\`\`\n\n## Step 0 — a\n\n${fence('gate: a\nrun: echo \\\n  continued\nreadonly: true\nexpect: continued')}\n## Notes\n\nprose\n`;
+  const { sections, problems } = parsePrompt(text);
+  assert.deepEqual(problems, []);
+  assert.equal(sections.length, 1);
+  assert.equal(sections[0].gates[0].run.command, 'echo continued');
+  const outside = parsePrompt(`## Notes\n\n${fence('gate: a\nrun: true')}`);
+  assert.match(outside.problems[0].message, /before any numbered section heading/);
+});
+
+test('L42-8 a dry run checks no done-when: unless it is marked readonly, and tells a waiting command it is a dry run', () => {
+  const dir = repo();
+  try {
+    prompt(dir, `# R\n\n## Step 0 — x\n\n${fence(`
+done-when: touch DONE_WHEN_RAN; false
+gate: wait
+run: [ -n "$MOCK2_GATES_DRY_RUN" ] && echo reported || sleep 30
+readonly: true
+expect: reported
+`)}\n## Step 1 — y\n\n${fence(`
+done-when: test -f absent.txt
+readonly: true
+gate: g
+run: true
+readonly: true
+`)}`);
+    const dry = gates(dir, 'prompt.md', '--section', '0', '--dry-run');
+    assert.equal(dry.status, 0, dry.stdout + dry.stderr);
+    assert.match(dry.stdout, /done-when: not checked \(dry run; not readonly\)/);
+    assert.equal(existsSync(join(dir, 'DONE_WHEN_RAN')), false, 'the done-when command did not run');
+    assert.match(dry.stdout, /wait: pass/);
+    const marked = gates(dir, 'prompt.md', '--section', '1', '--dry-run');
+    assert.equal(marked.status, 0, marked.stdout + marked.stderr);
+    assert.match(marked.stdout, /done-when does not hold \(exit 1\)/, 'a readonly done-when runs in a dry run');
+    assert.equal(parsePrompt(readFileSync(join(dir, 'prompt.md'), 'utf8')).sections[1].doneWhen[0].readonly, true);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 a saved value outside the safe characters is refused before its command runs (exit 2), however a second shell is spelled; raw-saved: true opts a gate out', () => {
+  const dir = repo();
+  try {
+    for (const use of ['/bin/sh -c "echo ${SAVED:V}"', 'bash --norc -c "echo ${SAVED:V}"', 'printf %s ${SAVED:V} | xargs -I{} sh -c "echo {}"',
+      'echo "echo ${SAVED:V}" | sh', 'sh -c "echo ${SAVED:V}"', 'eval echo ${SAVED:V}']) {
+      prompt(dir, `# R\n\n## Step 0 — x\n\n${fence(`gate: s\nSAVE V='a$(touch PWNED)b'\ngate: use\nrun: ${use}`)}`);
+      const r = gates(dir, 'prompt.md', '--section', '0');
+      assert.equal(r.status, 2, `${use}: ${r.stdout}${r.stderr}`);
+      assert.match(r.stdout + r.stderr, /use: REFUSED — SAVED V holds characters other than letters, digits/);
+      assert.equal(existsSync(join(dir, 'PWNED')), false, use);
+      rmSync(join(dir, '.mock2'), { recursive: true, force: true });
+    }
+    // A safe value runs anywhere, also beside a command whose name starts like a shell's.
+    prompt(dir, `# R\n\n## Step 0 — x\n\n${fence("gate: s\nSAVE V='v1.2:abc/def@x'\ngate: use\nrun: ssh-keygen --version >/dev/null 2>&1; sh -c \"echo ${SAVED:V}\"\nexpect: v1.2:abc/def@x")}`);
+    const ok = gates(dir, 'prompt.md', '--section', '0');
+    assert.equal(ok.status, 0, ok.stdout + ok.stderr);
+    rmSync(join(dir, '.mock2'), { recursive: true, force: true });
+    // The opt-out: the quoting still keeps the value from the runner's own shell.
+    prompt(dir, `# R\n\n## Step 0 — x\n\n${fence("gate: s\nSAVE V='a$(touch PWNED)b'\ngate: use\nraw-saved: true\nrun: printf '%s' ${SAVED:V}\nexpect: a$(touch PWNED)b")}`);
+    const raw = gates(dir, 'prompt.md', '--section', '0');
+    assert.equal(raw.status, 0, raw.stdout + raw.stderr);
+    assert.equal(existsSync(join(dir, 'PWNED')), false);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-8 done-when: under a gate is a parse error; a readonly: at the top of the next block does not attach to an earlier done-when', () => {
+  const under = parsePrompt(`## Step 0\n\n${fence('gate: a\ndone-when: true\nrun: echo x')}`);
+  assert.match(under.problems.map((p) => p.message).join(), /done-when: is section-level: put it before the first gate: line of its block, not under gate a/);
+  assert.equal(under.sections[0].gates[0].run.command, 'echo x', 'the run: line stays with its gate');
+  const next = parsePrompt(`## Step 0\n\n${fence('done-when: test -f x')}\n${fence('readonly: true\ngate: a\nrun: true')}`);
+  assert.equal(next.sections[0].doneWhen[0].readonly, false);
+  assert.match(next.problems.map((p) => p.message).join(), /readonly: outside a gate/);
+});
+
+test('L42-8 the refusal for a <file redirection says how to write it; a whitespace-only SAVE literal is refused before anything runs', () => {
+  const redirect = parsePrompt(`## Step 0\n\n${fence('gate: a\nrun: sort <in.txt 2>err.txt')}`);
+  assert.match(redirect.problems[0].message, /placeholder text "<in\.txt 2>".*a shell redirection is written with a space after <, as `sort < in\.txt`/);
+  assert.deepEqual(parsePrompt(`## Step 0\n\n${fence('gate: a\nrun: sort < in.txt 2>err.txt')}`).problems, []);
+  const blank = parsePrompt(`## Step 0\n\n${fence("gate: a\nSAVE V='   '")}`);
+  assert.match(blank.problems[0].message, /SAVE V is empty/);
+});
diff --git a/core/mock2/tests/migration-guard.test.mjs b/core/mock2/tests/migration-guard.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a23a17b8a87852e6c8dc4d7918f53d96646edc2e
--- /dev/null
+++ b/core/mock2/tests/migration-guard.test.mjs
@@ -0,0 +1,169 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+// L42-14 (P14): the migration manifest has a stated format (one append-only line per migration: file, sha256,
+// classification, approval reference, lock footprint) and the deploy guard parses statements, allowing the
+// lock-friendly forms of §N.1 (NOT VALID then VALIDATE, concurrent index builds, a column dropped from NOT NULL)
+// and refusing DROP TABLE, a type rewrite, an unapproved entry and a changed file hash. Template: gen.mjs
+// migration-guard writes the guard module, the manifest and a test feeding each allowed and refused form; this
+// test runs that generated test (through a minimal stand-in for its test runner's API) as well as the guard.
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const { generate } = await import(pathToFileURL(join(site, 'core/mock2/templates/repo/.mock2/bin/gen.mjs')).href);
+const sha = (text) => createHash('sha256').update(text).digest('hex');
+
+// The generated test imports describe/it/expect from its runner; this stand-in maps them onto node:test.
+const RUNNER = `import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+export { describe, it };
+export function expect(actual) {
+  return { toBe: (e) => assert.equal(actual, e), toEqual: (e) => assert.deepEqual(actual, e), toMatch: (re) => assert.match(actual, re) };
+}
+`;
+async function generated(t) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-migration-guard-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  const r = await generate({ generator: 'migration-guard', root });
+  const write = (path, text) => { mkdirSync(dirname(join(root, path)), { recursive: true }); writeFileSync(join(root, path), text); };
+  write('node_modules/vitest/package.json', JSON.stringify({ name: 'vitest', type: 'module', exports: './index.mjs' }));
+  write('node_modules/vitest/index.mjs', RUNNER);
+  const guard = await import(pathToFileURL(join(root, 'src/db/migration-guard.mjs')).href);
+  const env = { ...process.env, MIGRATION_BASE_REF: 'no-such-ref' };
+  delete env.NODE_TEST_CONTEXT;
+  const runTest = () => spawnSync(process.execPath, ['--test', '--test-reporter=tap', 'src/db/migration-guard.test.mjs'], { cwd: root, encoding: 'utf8', env });
+  return { root, r, guard, write, runTest };
+}
+
+test('L42-14 gen migration-guard writes the guard, its test and the manifest with its stated format', async (t) => {
+  const { r, root, guard } = await generated(t);
+  assert.deepEqual(r.files.map((f) => [f.to, f.action]), [['src/db/migration-guard.mjs', 'wrote'], ['src/db/migration-guard.test.mjs', 'wrote'], ['src/db/migration-manifest.txt', 'wrote']]);
+  const manifest = readFileSync(join(root, 'src/db/migration-manifest.txt'), 'utf8');
+  assert.match(manifest, /Append-only: a released entry is never edited, removed or reordered/u);
+  assert.match(manifest, /file \| sha256:<64 hex of the file> \| additive, transition, contraction or destructive \| approval reference \| lock footprint/u);
+  assert.deepEqual(guard.parseManifest(manifest), { entries: [], problems: [] }, 'the shipped manifest is only comments');
+  assert.equal(guard.MANIFEST_FORMAT, '<file> | sha256:<64 hex> | <additive|transition|contraction|destructive> | <approval reference> | <lock footprint>');
+});
+
+test('L42-14 the guard parses statements: each lock-friendly form passes; DROP TABLE and a type rewrite are refused', async (t) => {
+  const { guard } = await generated(t);
+  const allowed = (sql, c = 'additive') => guard.guardStatements(sql, c).every((x) => x.allowed);
+  assert.ok(allowed('ALTER TABLE orders ADD CONSTRAINT fk FOREIGN KEY (c) REFERENCES customers (id) NOT VALID;'), 'NOT VALID');
+  assert.ok(allowed('ALTER TABLE orders VALIDATE CONSTRAINT fk;'), 'VALIDATE in a later migration');
+  assert.ok(allowed('CREATE INDEX CONCURRENTLY orders_c ON orders (c);'), 'concurrent index');
+  assert.ok(allowed('ALTER TABLE orders ALTER COLUMN note DROP NOT NULL;'), 'dropped from NOT NULL');
+  // Parsing, not text matching: the same words in a string, a quoted identifier, a dollar body or a comment are not statements.
+  assert.ok(allowed("COMMENT ON COLUMN orders.note IS 'DROP TABLE orders; ALTER COLUMN x TYPE int';\nCREATE FUNCTION f() RETURNS void AS $body$ DROP TABLE orders; $body$ LANGUAGE sql;\n-- DROP TABLE orders;\nALTER TABLE orders ADD COLUMN \"drop table\" text;"));
+  const refused = (sql, c = 'additive') => guard.guardStatements(sql, c).filter((x) => !x.allowed);
+  assert.match(refused('DROP TABLE orders;')[0].reason, /contraction or destructive/u);
+  assert.match(refused('ALTER TABLE orders ALTER COLUMN total TYPE bigint;')[0].reason, /rewrites the table/u);
+  assert.equal(refused('drop table orders').length, 1, 'case and a missing semicolon do not matter');
+  assert.equal(refused('ALTER TABLE orders ADD COLUMN a int, ALTER COLUMN b TYPE text;').length, 1, 'each action of one ALTER TABLE is decided');
+});
+
+test('L42-14 ADD is refused by default: only a plain column with NULL, COLLATE, a constant or stable DEFAULT (and NOT NULL beside it) passes', async (t) => {
+  const { guard } = await generated(t);
+  const refused = {
+    'ALTER TABLE orders ADD COLUMN id2 bigserial;': /serial type/u,
+    "ALTER TABLE orders ADD COLUMN n int DEFAULT nextval('s');": /nextval\(\) in a default/u,
+    'ALTER TABLE orders ADD COLUMN t text GENERATED ALWAYS AS (upper(name)) STORED;': /generated or identity/u,
+    'ALTER TABLE orders ADD COLUMN i int GENERATED ALWAYS AS IDENTITY;': /generated or identity/u,
+    'ALTER TABLE orders ADD COLUMN code text UNIQUE;': /index under a write lock/u,
+    'ALTER TABLE orders ADD COLUMN code text PRIMARY KEY;': /index under a write lock/u,
+    'ALTER TABLE orders ADD COLUMN q int CHECK (q > 0);': /NOT VALID/u,
+    'ALTER TABLE orders ADD COLUMN u uuid DEFAULT uuidv7();': /uuidv7\(\) in a default/u,
+    'ALTER TABLE orders ADD COLUMN u uuid DEFAULT gen_random_uuid();': /gen_random_uuid\(\) in a default/u,
+    'ALTER TABLE orders ADD COLUMN r float DEFAULT random();': /random\(\) in a default/u,
+    'ALTER TABLE orders ADD CONSTRAINT nn NOT NULL customer_id;': /NOT VALID/u,
+    'ALTER TABLE orders ADD COLUMN n int NOT NULL;': /nullable/u,
+    'ALTER TABLE orders ADD CONSTRAINT x EXCLUDE USING gist (r WITH &&);': /index under a write lock/u,
+    'ALTER TABLE orders ADD COLUMN n int STORAGE PLAIN;': /not a recognised/u,
+    'ALTER TABLE orders ADD COLUMN;': /not a recognised/u,
+    'ALTER TABLE orders ADD COLUMN n;': /not a recognised/u,
+  };
+  for (const [sql, reason] of Object.entries(refused)) {
+    const out = guard.guardStatements(sql, 'additive').filter((x) => !x.allowed);
+    assert.equal(out.length, 1, sql);
+    assert.match(out[0].reason, reason, sql);
+  }
+  for (const sql of ['ALTER TABLE orders ADD COLUMN created_at timestamptz NOT NULL DEFAULT now();', "ALTER TABLE orders ADD COLUMN tags jsonb DEFAULT '[]'::jsonb;",
+    'ALTER TABLE orders ADD COLUMN amount numeric(12,2) DEFAULT -1.5 NOT NULL;', 'ALTER TABLE orders ADD COLUMN label text COLLATE "C" NULL;',
+    'ALTER TABLE orders ADD COLUMN note text DEFAULT NULL;', 'ALTER TABLE orders ADD CONSTRAINT nn NOT NULL customer_id NOT VALID;']) {
+    assert.deepEqual(guard.guardStatements(sql, 'additive').filter((x) => !x.allowed), [], sql);
+  }
+});
+
+test('L42-14 a table this migration creates is matched by its schema-qualified name; PARTITION OF is refused', async (t) => {
+  const { guard } = await generated(t);
+  const refused = (sql) => guard.guardStatements(sql, 'additive').filter((x) => !x.allowed);
+  assert.match(refused('CREATE TABLE a.orders (id int);\nCREATE INDEX orders_id ON b.orders (id);')[0].reason, /existing table b\.orders/u);
+  assert.match(refused('CREATE TABLE orders (id int);\nCREATE INDEX orders_id ON public.orders (id);')[0].reason, /CONCURRENTLY/u, 'an unqualified and a qualified name are not assumed equal');
+  assert.deepEqual(refused('CREATE TABLE a.orders (id int);\nCREATE INDEX orders_id ON a.orders (id);'), []);
+  assert.match(refused('CREATE TABLE orders_2026 PARTITION OF orders FOR VALUES FROM (1) TO (2);')[0].reason, /ACCESS EXCLUSIVE lock on the parent/u);
+});
+
+test('L42-14 review bypasses: quoted names, a cast that hid a call, a domain default, an inner NOT valid, IF NOT EXISTS and a changed search path are refused', async (t) => {
+  const { guard } = await generated(t);
+  const refused = {
+    'ALTER TABLE o ADD COLUMN x "bigserial";': /serial type/u,
+    'ALTER TABLE o ADD COLUMN u uuid DEFAULT "gen_random_uuid"();': /"gen_random_uuid"\(\) in a default/u,
+    "ALTER TABLE o ADD COLUMN n int DEFAULT \"nextval\"('s');": /"nextval"\(\) in a default/u,
+    "ALTER TABLE o ADD COLUMN n bigint DEFAULT pg_catalog.\"nextval\"('s'::regclass);": /"nextval"\(\) in a default/u,
+    'ALTER TABLE o ADD COLUMN x int DEFAULT "Now"();': /"Now"\(\) in a default/u,
+    'ALTER TABLE o ADD COLUMN x5 boolean DEFAULT 0.5::float8 IS DISTINCT FROM random();': /random\(\) in a default/u,
+    "ALTER TABLE o ADD COLUMN b boolean DEFAULT 'f'::boolean OR random() < 0.5;": /random\(\) in a default/u,
+    'ALTER TABLE o ADD COLUMN x int DEFAULT 1::int BETWEEN random() AND 2;': /random\(\) in a default/u,
+    'ALTER TABLE o ADD COLUMN x int8 DEFAULT ((nextval(1)));': /nextval\(\) in a default/u,
+    'ALTER TABLE o ADD COLUMN v text DEFAULT CURRENT_USER;': /CURRENT_USER in a default/u,
+    'CREATE DOMAIN d AS uuid DEFAULT gen_random_uuid(); ALTER TABLE o ADD COLUMN x d;': /domain without a default/u,
+    'ALTER TABLE o ADD CONSTRAINT c CHECK (NOT valid);': /NOT VALID/u,
+    'ALTER TABLE o ADD CONSTRAINT nn NOT NULL valid;': /NOT VALID/u,
+    'CREATE TABLE IF NOT EXISTS o (id int); CREATE INDEX oi ON o (id);': /CONCURRENTLY/u,
+    'CREATE TABLE o (id int); SET search_path = b; CREATE INDEX oi ON o (id);': /CONCURRENTLY/u,
+  };
+  for (const [sql, reason] of Object.entries(refused)) {
+    const out = guard.guardStatements(sql, 'additive').filter((x) => !x.allowed);
+    assert.equal(out.length, 1, sql);
+    assert.match(out[0].reason, reason, sql);
+  }
+  for (const sql of ['ALTER TABLE o ADD COLUMN x double precision DEFAULT 1::double precision;', "ALTER TABLE o ADD COLUMN x timestamptz DEFAULT '2020-01-01'::timestamp(3) with time zone;",
+    "ALTER TABLE o ADD COLUMN x text[] DEFAULT '{}'::text[];", "ALTER TABLE o ADD COLUMN x varchar(20) DEFAULT 'a'::character varying(20);",
+    'ALTER TABLE o ADD COLUMN x timestamptz DEFAULT "now"();', "ALTER TABLE o ADD COLUMN x timestamptz DEFAULT now() AT TIME ZONE 'UTC';",
+    'ALTER TABLE o ADD CONSTRAINT c CHECK (x > 0) NOT VALID;', 'CREATE DOMAIN d AS text;', 'CREATE TABLE o (id int); CREATE INDEX oi ON o (id);']) {
+    assert.deepEqual(guard.guardStatements(sql, 'additive').filter((x) => !x.allowed), [], sql);
+  }
+});
+
+test('L42-14 the manifest: an unapproved entry and a changed file hash are refused; a released entry is append-only', async (t) => {
+  const { guard } = await generated(t);
+  const sql = 'CREATE TABLE invoices (id int);\n';
+  const entry = (approval = 'decision D-3', hash = sha(sql)) => `0001_invoices.sql | sha256:${hash} | additive | ${approval} | none (new objects only)`;
+  assert.deepEqual(guard.checkMigrations({ manifest: entry(), files: { '0001_invoices.sql': sql } }).problems, []);
+  for (const approval of ['-', 'none', '<approval>']) assert.match(guard.checkMigrations({ manifest: entry(approval), files: { '0001_invoices.sql': sql } }).problems[0].reason, /no approval reference/u);
+  assert.match(guard.checkMigrations({ manifest: entry(), files: { '0001_invoices.sql': `${sql}ALTER TABLE invoices ADD COLUMN a int;\n` } }).problems[0].reason, /changed since its manifest entry/u);
+  assert.match(guard.checkMigrations({ manifest: entry('decision D-9'), files: { '0001_invoices.sql': sql }, previousManifest: entry() }).problems[0].reason, /append-only/u);
+  assert.match(guard.checkMigrations({ manifest: '0001_invoices.sql | sha256:abc | additive', files: {} }).problems[0].reason, /expected 5 fields/u);
+});
+
+test('L42-14 the generated guard test passes, and fails on a repository migration the deploy would refuse', async (t) => {
+  const { write, runTest } = await generated(t);
+  let r = runTest();
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+  assert.match(r.stdout, /# pass 54\n# fail 0/u);
+  const good = "CREATE TABLE invoices (id int);\n--> statement-breakpoint\nCREATE INDEX invoices_id ON invoices (id);\n";
+  write('src/db/migrations/0001_invoices.sql', good);
+  write('src/db/migration-manifest.txt', `# manifest\n0001_invoices.sql | sha256:${sha(good)} | additive | decision D-3 | none (new objects only)\n`);
+  r = runTest();
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+  const bad = 'ALTER TABLE invoices ALTER COLUMN id TYPE bigint;\n';
+  write('src/db/migrations/0002_widen.sql', bad);
+  write('src/db/migration-manifest.txt', `0001_invoices.sql | sha256:${sha(good)} | additive | decision D-3 | none (new objects only)\n0002_widen.sql | sha256:${sha(bad)} | transition | decision D-4 | invoices, blocks reads and writes, the whole rewrite\n`);
+  r = runTest();
+  assert.equal(r.status, 1, 'the repository check fails before release');
+  assert.match(r.stdout, /not ok \d+ - every migration has an unchanged, approved entry and only allowed statements/u);
+  assert.match(r.stdout, /type change rewrites the table/u);
+});
