+
+describe('{{rule}} migration guard: the lock-friendly forms pass', () => {
+  for (const [name, sql, classification] of ALLOWED) it(`${name}`, () => {
+    expect(guardStatements(sql, classification).filter((r) => !r.allowed)).toEqual([]);
+  });
+});
+
+describe('{{rule}} migration guard: refused forms are refused, with the reason', () => {
+  for (const [name, sql, classification, reason] of REFUSED) it(`${name}`, () => {
+    const refused = guardStatements(sql, classification).filter((r) => !r.allowed);
+    expect(refused.length > 0).toBe(true);
+    expect(refused.map((r) => r.reason).join(' ')).toMatch(reason);
+  });
+});
+
+describe('{{rule}} migration manifest', () => {
+  const migration = 'CREATE TABLE invoices (id serial PRIMARY KEY);\n';
+  const line = (fields) => fields.join(' | ');
+  const good = line(['0001_invoices.sql', `sha256:${sha256(migration)}`, 'additive', 'decision D-3', 'none (new objects only)']);
+  it('an approved, unchanged entry passes', () => {
+    expect(checkMigrations({ manifest: good, files: { '0001_invoices.sql': migration } }).problems).toEqual([]);
+  });
+  it('a changed file hash is refused', () => {
+    expect(checkMigrations({ manifest: good, files: { '0001_invoices.sql': `${migration}-- edited\n` } }).problems[0].reason).toMatch(/changed since its manifest entry/u);
+  });
+  it('an unapproved entry is refused', () => {
+    const unapproved = line(['0001_invoices.sql', `sha256:${sha256(migration)}`, 'additive', '-', 'none (new objects only)']);
+    expect(checkMigrations({ manifest: unapproved, files: { '0001_invoices.sql': migration } }).problems[0].reason).toMatch(/no approval reference/u);
+  });
+  it('a migration without an entry is refused', () => {
+    expect(checkMigrations({ manifest: '', files: { '0001_invoices.sql': migration } }).problems[0].reason).toMatch(/no manifest entry/u);
+  });
+  it('a released entry is never edited', () => {
+    const edited = line(['0001_invoices.sql', `sha256:${sha256(migration)}`, 'additive', 'decision D-4', 'none (new objects only)']);
+    expect(checkMigrations({ manifest: edited, files: { '0001_invoices.sql': migration }, previousManifest: good }).problems.map((p) => p.reason).join(' ')).toMatch(/append-only/u);
+  });
+});
+
+describe('{{rule}} this repository\'s migrations meet the deploy guard', () => {
+  const dir = 'src/db/migrations', manifestPath = 'src/db/migration-manifest.txt';
+  it('every migration has an unchanged, approved entry and only allowed statements', () => {
+    if (!existsSync(dir) || !existsSync(manifestPath)) return;
+    const files = Object.fromEntries(readdirSync(dir).filter((f) => f.endsWith('.sql')).sort().map((f) => [f, readFileSync(join(dir, f), 'utf8')]));
+    let previousManifest = null;   // the manifest as the main branch has it: its released entries
+    try { previousManifest = execFileSync('git', ['show', `${process.env.MIGRATION_BASE_REF || 'origin/main'}:${manifestPath}`], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] }); } catch { /* no main branch copy yet */ }
+    expect(checkMigrations({ manifest: readFileSync(manifestPath, 'utf8'), files, previousManifest }).problems).toEqual([]);
+  });
+});
