+    return { value: { action: 'queued', entry, place: record.entries.length, warnings } };
+  });
+  if (value.action === 'refused') throw refuse(`not queued: ${branch} lacks the queue tip ahead of it (${short(value.tip)}, ${value.tipBranch}). Restack and run the final battery again (§M.10 item 2):\n  ${value.restack}`);
