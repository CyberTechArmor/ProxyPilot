+// The deploy guard's rule, applied by a test to every form it decides and to this repository's migrations, so a
+// migration the deploy would refuse fails here first (PRO current §N.11). Generated by gen.mjs migration-guard.
+import { describe, it, expect } from 'vitest';
+import { execFileSync } from 'node:child_process';
+import { existsSync, readdirSync, readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { checkMigrations, guardStatements, sha256 } from './migration-guard.mjs';
+
+const ALLOWED = [
+  ['a constraint added NOT VALID', 'ALTER TABLE orders ADD CONSTRAINT orders_customer_fk FOREIGN KEY (customer_id) REFERENCES customers (id) NOT VALID;', 'additive'],
+  ['VALIDATE in a later migration', 'ALTER TABLE orders VALIDATE CONSTRAINT orders_customer_fk;', 'additive'],
+  ['a check added NOT VALID', 'ALTER TABLE orders ADD CONSTRAINT orders_total_positive CHECK (total >= 0) NOT VALID;', 'additive'],
+  ['a concurrent index build', 'CREATE INDEX CONCURRENTLY IF NOT EXISTS orders_customer_idx ON orders (customer_id);', 'additive'],
+  ['a concurrent unique index, then the constraint USING INDEX', 'CREATE UNIQUE INDEX CONCURRENTLY orders_number_key ON orders (number);\nALTER TABLE orders ADD CONSTRAINT orders_number_unique UNIQUE USING INDEX orders_number_key;', 'additive'],
+  ['a column dropped from NOT NULL (expand step)', 'ALTER TABLE orders ALTER COLUMN note DROP NOT NULL;', 'additive'],
+  ['a new table and its index, with a lock timeout', "SET lock_timeout = '2s';\nCREATE TABLE invoices (id serial PRIMARY KEY, total numeric NOT NULL);\n--> statement-breakpoint\nCREATE INDEX invoices_total_idx ON invoices (total);", 'additive'],
+  ['a nullable column with a constant default', "ALTER TABLE orders ADD COLUMN channel text DEFAULT 'web';", 'additive'],
+  ['words inside strings and comments are not statements', "COMMENT ON TABLE orders IS 'never DROP TABLE orders; ALTER COLUMN x TYPE int';\n/* DROP TABLE orders; */", 'additive'],
+  ['a backfill in a transition migration', "UPDATE orders SET channel = 'web' WHERE channel IS NULL;", 'transition'],
+  ['a NOT NULL column beside a stable default', 'ALTER TABLE orders ADD COLUMN created_at timestamptz NOT NULL DEFAULT now();', 'additive'],
+  ['a column with a constant default, a cast and a collation', "ALTER TABLE orders ADD COLUMN IF NOT EXISTS amount numeric(12,2) DEFAULT 0 NOT NULL, ADD COLUMN tags jsonb DEFAULT '[]'::jsonb, ADD COLUMN label text COLLATE \"C\" NULL;", 'additive'],
+  ['a NOT NULL constraint added NOT VALID', 'ALTER TABLE orders ADD CONSTRAINT orders_customer_nn NOT NULL customer_id NOT VALID;', 'additive'],
+  ['an index on a table created in the same schema', 'CREATE TABLE billing.invoices (id int);\nCREATE INDEX invoices_id ON billing.invoices (id);', 'additive'],
+  ['a default cast to a multi-word type, and the stable now() by its quoted name', "ALTER TABLE orders ADD COLUMN ratio double precision DEFAULT 1::double precision, ADD COLUMN seen timestamptz DEFAULT \"now\"();", 'additive'],
+  ['an approved contraction drops the old column', 'ALTER TABLE orders DROP COLUMN legacy_status;', 'contraction'],
+];
+
+const REFUSED = [
+  ['DROP TABLE outside a contraction', 'DROP TABLE orders;', 'additive', /drop belongs in a migration classified contraction/u],
+  ['a type rewrite', 'ALTER TABLE orders ALTER COLUMN total TYPE bigint;', 'additive', /type change rewrites/u],
+  ['SET DATA TYPE', 'ALTER TABLE orders ALTER COLUMN total SET DATA TYPE numeric(12,2);', 'contraction', /type change rewrites/u],
+  ['a foreign key validated while it is added', 'ALTER TABLE orders ADD CONSTRAINT orders_customer_fk FOREIGN KEY (customer_id) REFERENCES customers (id);', 'additive', /NOT VALID/u],
+  ['VALIDATE in the migration that added it', 'ALTER TABLE orders ADD CONSTRAINT c_fk FOREIGN KEY (customer_id) REFERENCES customers (id) NOT VALID;\nALTER TABLE orders VALIDATE CONSTRAINT c_fk;', 'additive', /later migration/u],
+  ['an index built under a write lock', 'CREATE INDEX orders_customer_idx ON orders (customer_id);', 'additive', /CONCURRENTLY/u],
+  ['SET NOT NULL', 'ALTER TABLE orders ALTER COLUMN note SET NOT NULL;', 'additive', /exclusive lock/u],
+  ['a rename', 'ALTER TABLE orders RENAME COLUMN note TO remark;', 'additive', /rename/u],
+  ['a volatile default', 'ALTER TABLE orders ADD COLUMN token uuid DEFAULT gen_random_uuid();', 'additive', /volatile default/u],
+  ['a bigserial column', 'ALTER TABLE orders ADD COLUMN id2 bigserial;', 'additive', /serial type/u],
+  ['a sequence default', "ALTER TABLE orders ADD COLUMN n int DEFAULT nextval('s');", 'additive', /nextval\(\) in a default/u],
+  ['a stored generated column', 'ALTER TABLE orders ADD COLUMN t text GENERATED ALWAYS AS (upper(name)) STORED;', 'additive', /generated or identity column/u],
+  ['an identity column', 'ALTER TABLE orders ADD COLUMN i int GENERATED ALWAYS AS IDENTITY;', 'additive', /generated or identity column/u],
+  ['an inline UNIQUE', 'ALTER TABLE orders ADD COLUMN code text UNIQUE;', 'additive', /builds an index under a write lock/u],
+  ['an inline PRIMARY KEY', 'ALTER TABLE orders ADD COLUMN pk int PRIMARY KEY;', 'additive', /builds an index under a write lock/u],
+  ['an inline CHECK', 'ALTER TABLE orders ADD COLUMN q int CHECK (q > 0);', 'additive', /NOT VALID/u],
+  ['a uuidv7 default', 'ALTER TABLE orders ADD COLUMN u uuid DEFAULT uuidv7();', 'additive', /uuidv7\(\) in a default/u],
+  ['a NOT NULL constraint added valid', 'ALTER TABLE orders ADD CONSTRAINT nn NOT NULL customer_id;', 'additive', /NOT VALID/u],
+  ['a NOT NULL column without a default', 'ALTER TABLE orders ADD COLUMN n int NOT NULL;', 'additive', /add it nullable, backfill/u],
+  ['an unrecognised column option', 'ALTER TABLE orders ADD COLUMN n int STORAGE PLAIN;', 'additive', /not a recognised/u],
+  ['an index on a same-named table in another schema', 'CREATE TABLE a.orders (id int);\nCREATE INDEX orders_id ON b.orders (id);', 'additive', /CONCURRENTLY/u],
+  ['a partition of an existing parent', 'CREATE TABLE orders_2026 PARTITION OF orders FOR VALUES FROM (1) TO (2);', 'additive', /ACCESS EXCLUSIVE lock on the parent/u],
+  ['a quoted serial type', 'ALTER TABLE orders ADD COLUMN x "bigserial";', 'additive', /serial type/u],
+  ['a quoted volatile function', 'ALTER TABLE orders ADD COLUMN u uuid DEFAULT "gen_random_uuid"();', 'additive', /"gen_random_uuid"\(\) in a default/u],
+  ['a schema-qualified quoted sequence call', "ALTER TABLE orders ADD COLUMN n bigint DEFAULT pg_catalog.\"nextval\"('s'::regclass);", 'additive', /"nextval"\(\) in a default/u],
+  ['a volatile call after a cast', 'ALTER TABLE orders ADD COLUMN x5 boolean DEFAULT 0.5::float8 IS DISTINCT FROM random();', 'additive', /random\(\) in a default/u],
