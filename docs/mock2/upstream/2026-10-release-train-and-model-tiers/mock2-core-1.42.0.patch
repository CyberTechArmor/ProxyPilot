+export const SCHEMA = 1;
+export const SLOT_KINDS = ['build', 'battery', 'release'];
+export const SLOT_FULL = 75;
+export const DEFAULT_RECORDS = ['state/**'];
+export const BRANCH_RECORDS = ['state/inventory.json', 'state/design/**', 'state/states-catalog.json'];
+const MIGRATION_DIRS = new Set(['migrations', 'migration', 'drizzle']);
+const RUN_ID = /^[A-Za-z0-9._:-]{1,128}$/u;
+const ID = /^[A-Za-z0-9._:-]{1,64}$/u;
+
+/* git in a directory; read commands take no optional lock, so a queue read never collides with a commit. */
+export function gitRunner(cwd) {
+  const run = (args, { input, env, allowFail = false } = {}) => {
+    const r = spawnSync('git', args, { cwd, encoding: 'utf8', input, maxBuffer: 64 * 1024 * 1024, env: { ...process.env, GIT_OPTIONAL_LOCKS: '0', GIT_TERMINAL_PROMPT: '0', ...env } });
