+test('L42-11 pass records candidates in the git common directory; base prints the queue tip; a linked worktree reads the same record', (t) => {
+  const w = world(t);
+  assert.equal(queue(w.root, 'base').out.trim(), w.base, 'an empty queue: main is the tip');
+  let r = queue(w.root, 'pass', 'feature-a', w.a, '--battery', 'run-a', '--reserved', 'D-7');
+  assert.equal(r.status, 0, r.err);
+  assert.match(r.out, /queued: feature-a .* at position 1, built on the main branch/u);
+  r = queue(w.root, 'pass', 'feature-b', w.b, '--battery', 'run-b');
+  assert.equal(r.status, 0, r.err);
+  assert.match(r.out, /at position 2, built on feature-a/u);
+  const record = JSON.parse(readFileSync(join(w.root, '.git', 'mock2', 'queue.json'), 'utf8'));
+  assert.deepEqual(record.entries.map((e) => [e.branch, e.commit, e.battery, e.base]), [['feature-a', w.a, 'run-a', w.base], ['feature-b', w.b, 'run-b', w.a]]);
+  // Two candidates passed: a third build starts from the second (§M.10 item 1).
+  r = queue(w.root, 'base');
+  assert.equal(r.out.trim(), w.b);
+  assert.match(r.err, /the queue tip/u);
+  assert.equal(queue(w.root, 'base', '--for', 'feature-b').out.trim(), w.a, 'a queued candidate restacks onto the tip ahead of it');
+  // Another worktree of the same repository shares the record.
+  const linked = join(w.root, '..', `${w.root.split('/').at(-1)}-linked`);
+  git(w.root, 'worktree', 'add', '-q', '--detach', linked, 'main');
+  t.after(() => rmSync(linked, { recursive: true, force: true }));
+  r = queue(linked, 'list');
+  assert.equal(r.status, 0, r.err);
+  assert.match(r.out, /depth 2/u);
+  assert.match(r.out, /1\. feature-a .* waiting \d+ min; built on main/u);
+  assert.match(r.out, /2\. feature-b .* built on feature-a/u);
+  // A later pass keeps the place and replaces the commit.
+  git(w.root, 'switch', '-q', 'feature-a');
+  const a2 = commit(w.root, { 'src/a.js': 'export const fromA = 2;\n' }, 'fix: a');
+  git(w.root, 'switch', '-q', 'main');
+  r = queue(w.root, 'pass', 'feature-a', a2, '--battery', 'run-a2');
+  assert.equal(r.status, 0, r.err);
+  assert.match(r.out, /pass replaced \(place kept\): feature-a .* at position 1/u);
+});
