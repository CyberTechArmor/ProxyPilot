+
+// L42-11 (P11): the release-queue tool .mock2/bin/queue.mjs. Its record lives in the git common directory, so
+// every worktree shares it; base prints the tip a new build starts from; withdraw names the candidates built on
+// a withdrawn one with their restack command and the append-only artefacts that need renumbering; absorb
+// replays only the candidate's own commits onto a main branch that moved by candidates ahead and records-only
+// commits, and its dry run writes no ref. Nothing here is a gate: a refusal is the tool's own (exit 1).
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const QUEUE = join(site, 'core/mock2/templates/repo/.mock2/bin/queue.mjs');
+const ENV = { ...process.env, GIT_AUTHOR_NAME: 'builder', GIT_AUTHOR_EMAIL: 'builder@example.invalid', GIT_COMMITTER_NAME: 'builder', GIT_COMMITTER_EMAIL: 'builder@example.invalid', MOCK2_QUEUE_MAIN: '' };
+
+function git(cwd, ...args) {
+  const r = spawnSync('git', args, { cwd, encoding: 'utf8', env: ENV });
+  assert.equal(r.status, 0, `git ${args.join(' ')}: ${r.stderr}`);
+  return r.stdout.trim();
+}
+function write(root, files) {
+  for (const [path, text] of Object.entries(files)) { mkdirSync(dirname(join(root, path)), { recursive: true }); writeFileSync(join(root, path), text); }
+}
+function commit(root, files, message) { write(root, files); git(root, 'add', '-A'); git(root, 'commit', '-q', '-m', message); return git(root, 'rev-parse', 'HEAD'); }
+function queue(cwd, ...args) {
+  const r = spawnSync(process.execPath, [QUEUE, '--main', 'main', ...args], { cwd, encoding: 'utf8', env: ENV });
+  return { status: r.status, out: r.stdout, err: r.stderr };
+}
+const pkg = (version) => `${JSON.stringify({ name: 'demo', version }, null, 2)}\n`;
+
+/* main ← A ← B, each with a migration, a package version and (B) a reference to an id A reserved. */
+function world(t) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-queue-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  git(root, 'init', '-q', '-b', 'main');
+  const base = commit(root, { 'src/app.js': 'export const a = 1;\n', 'state/handoff.md': '# Handoff\n', 'src/db/migrations/0001_init.sql': 'create table t (id int);\n', 'package.json': pkg('1.0.0') }, 'base');
+  git(root, 'switch', '-q', '-c', 'feature-a');
+  const a = commit(root, { 'src/a.js': 'export const fromA = true;\n', 'src/db/migrations/0002_a.sql': 'alter table t add column a int;\n', 'package.json': pkg('1.1.0') }, 'feat: a');
+  git(root, 'switch', '-q', '-c', 'feature-b');
+  const b = commit(root, { 'src/b.js': '// decision D-7 applies\nexport const fromB = true;\n', 'src/db/migrations/0003_b.sql': 'alter table t add column b int;\n', 'package.json': pkg('1.2.0') }, 'feat: b');
+  git(root, 'switch', '-q', 'main');
+  return { root, base, a, b };
+}
+function refsSnapshot(root) {
+  const index = join(root, '.git', 'index');
+  return { refs: git(root, 'for-each-ref', '--format=%(refname) %(objectname)'), head: git(root, 'symbolic-ref', 'HEAD'), status: git(root, 'status', '--porcelain'),
+    index: existsSync(index) ? createHash('sha256').update(readFileSync(index)).digest('hex') : null,
+    queue: readFileSync(join(root, '.git', 'mock2', 'queue.json'), 'utf8') };
+}
