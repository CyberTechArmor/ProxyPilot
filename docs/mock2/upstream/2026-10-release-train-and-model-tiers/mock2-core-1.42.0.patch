+  writeFileSync(join(r.root, 'e2e/spec.txt'), 'changed\n');
+  fresh();
+  result = r.run();
+  assert.equal(result.status, 0, result.stdout + result.stderr);
+  assert.deepEqual(result.report.results.map((x) => [x.id, x.execution]), [['build', 'executed'], ['browser', 'executed'], ['smoke', 'executed']]);
+});
