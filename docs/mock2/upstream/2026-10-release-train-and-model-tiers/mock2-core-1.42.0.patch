+  if (m < 60) return `${m} min`;
+  const h = Math.floor(m / 60);
+  return h < 48 ? `${h} h ${m % 60} min` : `${Math.floor(h / 24)} d ${h % 24} h`;
+}
+
+/* Records files: the include globs, without the records a build commits on its own branch. A glob given with
+ * --records must stay under state/ (the records the release step commits, §M.4, §P.4): one that does not, or
+ * that would match everything, would let absorb carry code past the battery, so it is refused. */
+export function recordsMatcher(globs = DEFAULT_RECORDS) {
+  for (const glob of globs) {
+    if (typeof glob !== 'string' || !glob.startsWith('state/') || glob.split('/').some((part) => part === '..' || part === '.') || globToRegExp(glob).test('src/index.js'))
