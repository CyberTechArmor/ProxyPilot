+    }
+    const parent = nearestParent(git, record.entries, sha);
+    const builtOn = base ? git.commit(base) : parent ? parent.commit : git.run(['merge-base', sha, mainTip.commit]);
+    if (!builtOn || !git.isAncestor(builtOn, sha)) throw new QueueError(`--base ${base} is not an ancestor of ${short(sha)}`);
+    const entry = { place: record.nextPlace++, branch, commit: sha, battery, queuedAt: now, passedAt: now, parent: parent?.branch ?? null, base: builtOn,
