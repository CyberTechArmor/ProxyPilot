index 0000000000000000000000000000000000000000..cd3d4e277bded7c587377e030195743cbb16f3b9
--- /dev/null
+++ b/core/mock2/tests/readonly-helper.test.mjs
@@ -0,0 +1,109 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { chmodSync, chownSync, existsSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+// L42-15 (P15): the host-side reference read-only production query helper (gen.mjs readonly-query). It screens a
+// statement before connecting (backslashes, comments, double quotes, Unicode-escape strings, write/DDL/session
+// words, transaction control, catalog-function names), then runs it inside BEGIN READ ONLY … ROLLBACK in a
+// read-only-default session with statement, lock and idle timeouts, and prints numbers only. Without a database
+// the screen and the exact statements are proved through a fake client; MOCK2_TEST_PG=1 also starts a disposable
+// local cluster (initdb/pg_ctl on PATH or under /usr/lib/postgresql) and runs the helper's real-engine selftest.
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const tpl = join(site, 'core/mock2/templates/repo/.mock2');
+// A nested node --test reports to its parent through NODE_TEST_CONTEXT; the selftests here print their own TAP.
+const childEnv = (extra) => { const env = { ...process.env, ...extra }; delete env.NODE_TEST_CONTEXT; return env; };
+const { generate } = await import(pathToFileURL(join(tpl, 'bin/gen.mjs')).href);
+
+function generated(t) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-readonly-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  return Promise.resolve(generate({ generator: 'readonly-query', root })).then((r) => ({ root, r }));
+}
+
+test('L42-15 the generator writes the helper and its selftest outside any production path, marked host-side', async (t) => {
+  const { root, r } = await generated(t);
+  assert.deepEqual(r.files.map((f) => [f.to, f.action]), [['ops/host/readonly-query.mjs', 'wrote'], ['ops/host/readonly-query.selftest.mjs', 'wrote']]);
+  const helper = readFileSync(join(root, 'ops/host/readonly-query.mjs'), 'utf8');
+  assert.match(helper, /HOST-SIDE REFERENCE HELPER: installed by the host, never into a repository's production path\./u);
+  assert.match(helper, /pins\s+\*? ?its sha256 in the release prompt/u);
+  // The version it targets is the stack table's PostgreSQL major.
+  const stack = JSON.parse(readFileSync(join(site, 'core/cpr/stack.versions.json'), 'utf8'));
+  const major = stack.systems.postgresql.selected.split('.')[0];
+  const module = await import(pathToFileURL(join(root, 'ops/host/readonly-query.mjs')).href);
+  assert.equal(module.TARGET, `PostgreSQL ${major}`);
+  assert.match(helper, new RegExp(`Target: PostgreSQL ${major} \\(the stack table's selected ${stack.systems.postgresql.selected.replace('.', '\\.')}\\)`, 'u'));
+});
+
+test('L42-15 each refused construct is refused before connecting; a permitted read sends BEGIN READ ONLY … ROLLBACK with the three timeouts (fake client)', async (t) => {
+  const { root } = await generated(t);
+  const m = await import(pathToFileURL(join(root, 'ops/host/readonly-query.mjs')).href);
+  const cases = {
+    backslash: "SELECT count(*) FROM t WHERE a = 'x\\y'",
+    comment: 'SELECT count(*) FROM t -- x',
+    'block comment': 'SELECT /* x */ count(*) FROM t',
+    'double quote': 'SELECT count(*) FROM "t"',
+    'Unicode-escape string': "SELECT count(*) FROM t WHERE a = U&'x'",
+    write: 'UPDATE t SET a = 1',
+    'write in a CTE': 'WITH x AS (DELETE FROM t RETURNING 1) SELECT count(*) FROM x',
+    DDL: 'SELECT 1; CREATE TABLE u (a int)',
+    'DDL word': 'SELECT count(*) FROM t WHERE drop = 1',
+    session: 'SELECT count(*) FROM t WHERE reset = 1',
+    'transaction control': 'SELECT count(*) FROM t WHERE commit = 1',
+    'catalog function': 'SELECT pg_terminate_backend(1)',
+    'catalog schema': 'SELECT count(*) FROM pg_catalog.pg_roles',
+    'a query run from a string (ts_stat)': "select count(*) from ts_stat('select to_tsvector(dblink_exec(''x'',''delete from t'')::text)')",
+    'a query run from a string (ts_rewrite)': "SELECT count(*) FROM ts_rewrite('a'::tsquery, 'SELECT t, s FROM aliases')",
+    'a query run from a string (*_to_xml)': "SELECT count(*) FROM database_to_xml(true, false, '')",
+    'a query run from a string (crosstab)': "SELECT count(*) FROM crosstab('select dblink_exec(''x'', ''delete from t'')::text, 1, 1') AS c(a text, b int)",
+    'a query run from a string (connectby)': "SELECT count(*) FROM connectby('t', 'id', 'parent', '1', 0) AS c(id int, parent int, level int)",
+  };
+  for (const [what, sql] of Object.entries(cases)) {
+    let connects = 0;
+    await assert.rejects(m.readOnlyQuery(sql, { connect: () => { connects++; return { run: async () => [['1']] }; } }), /refused before connecting/u, what);
+    assert.equal(connects, 0, `${what}: connected`);
+  }
+  const sent = [];
+  const rows = await m.readOnlyQuery('SELECT count(*) FROM t', { lockTimeoutMs: 500, idleTimeoutMs: 4000, connect: () => ({ run: async (s) => { sent.push(...s); return [['3']]; } }) });
+  assert.deepEqual(rows, [['3']]);
+  assert.deepEqual(sent, ['SET default_transaction_read_only = on', 'SET statement_timeout = 5000', 'SET lock_timeout = 500', 'SET idle_in_transaction_session_timeout = 4000', 'BEGIN READ ONLY', 'SELECT count(*) FROM t', 'ROLLBACK']);
+  assert.equal(m.startupOptions({}), '-c default_transaction_read_only=on -c statement_timeout=5000 -c lock_timeout=1000 -c idle_in_transaction_session_timeout=10000');
+});
+
+test('L42-15 the helper\'s own selftest passes in a generated copy (screen and fake client; the real-engine case skips without a database)', async (t) => {
+  const { root } = await generated(t);
+  const r = spawnSync(process.execPath, ['--test', '--test-reporter=tap', 'ops/host/readonly-query.selftest.mjs'], { cwd: root, encoding: 'utf8', env: childEnv({ READONLY_QUERY_TEST_PG: '' }) });
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+  assert.match(r.stdout, /# pass 4/u);
+  assert.match(r.stdout, /# skipped 1/u);
+});
+
+/* A disposable cluster owned by an unprivileged user, on a Unix socket only. */
+function tool(name) {
+  const which = spawnSync('sh', ['-c', `command -v ${name} || ls /usr/lib/postgresql/*/bin/${name} 2>/dev/null | sort -V | tail -1`], { encoding: 'utf8' }).stdout.trim().split('\n')[0];
+  return which || null;
+}
+const wantReal = process.env.MOCK2_TEST_PG === '1';
+test('L42-15 real engine: a permitted read runs read-only and rolls back; a slow statement hits the statement timeout (MOCK2_TEST_PG=1)', { skip: !wantReal && 'set MOCK2_TEST_PG=1 where initdb and pg_ctl are available (a real-database run)' }, async (t) => {
+  const initdb = tool('initdb'), pgctl = tool('pg_ctl'), psql = tool('psql');
+  assert.ok(initdb && pgctl && psql, 'initdb, pg_ctl and psql are needed');
+  const { root } = await generated(t);
+  const data = mkdtempSync(join(tmpdir(), 'mock2-pg-'));
+  const asRoot = process.getuid?.() === 0;
+  const user = asRoot ? 'nobody' : process.env.USER;
+  if (asRoot) { const uid = Number(spawnSync('id', ['-u', 'nobody'], { encoding: 'utf8' }).stdout); const gid = Number(spawnSync('id', ['-g', 'nobody'], { encoding: 'utf8' }).stdout); chownSync(data, uid, gid); chmodSync(data, 0o700); }
+  const as = (cmd, args) => spawnSync(asRoot ? 'runuser' : cmd, asRoot ? ['-u', 'nobody', '--', cmd, ...args] : args, { encoding: 'utf8' });
+  let r = as(initdb, ['-D', join(data, 'db'), '-A', 'trust', '-U', user, '--no-sync']);
+  assert.equal(r.status, 0, r.stderr);
+  r = as(pgctl, ['-D', join(data, 'db'), '-l', join(data, 'log'), '-w', 'start', '-o', `-c listen_addresses='' -k ${data}`]);
+  assert.equal(r.status, 0, r.stderr + (existsSync(join(data, 'log')) ? readFileSync(join(data, 'log'), 'utf8') : ''));
+  t.after(() => { as(pgctl, ['-D', join(data, 'db'), '-m', 'immediate', 'stop']); rmSync(data, { recursive: true, force: true }); });
+  const version = spawnSync(psql, ['-X', '-A', '-t', '-c', 'SHOW server_version'], { encoding: 'utf8', env: { ...process.env, PGHOST: data, PGUSER: user, PGDATABASE: 'postgres' } }).stdout.trim();
+  t.diagnostic(`real engine: PostgreSQL ${version} (the helper targets the stack table's PostgreSQL 18)`);
+  r = spawnSync(process.execPath, ['--test', '--test-reporter=tap', 'ops/host/readonly-query.selftest.mjs'], { cwd: root, encoding: 'utf8', env: childEnv({ READONLY_QUERY_TEST_PG: '1', PGHOST: data, PGUSER: user, PGDATABASE: 'postgres', PSQL: psql }) });
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+  assert.match(r.stdout, /# pass 5/u);
+});
