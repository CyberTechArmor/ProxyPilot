+    assert.equal(missing.status, 1);
+    assert.match(missing.stdout, /state\/never\.md: not changed and not in HEAD/u);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-9 ledger rows: appended at the end, the header\'s cell count, a WARNING (never a refusal) for a number that is not the next', () => {
+  const table = '## Ledger\n\n| # | date | task |\n|---|---|---|\n| 1 | 2026-10-28 | a |\n';
+  assert.deepEqual(checkLedger(table, `${table}| 2 | 2026-10-29 | b |\n`).problems, []);
+  const dup = checkLedger(table, `${table}| 1 | 2026-10-29 | b |\n`);
+  assert.deepEqual(dup.problems, []);
+  assert.match(dup.warnings[0], /^WARNING: .* not the next integer \(2\); left as it is, never renumbered/u);
+  assert.match(checkLedger(table, table.replace('| 1 | 2026-10-28 | a |\n', '| 2 | 2026-10-29 | b |\n| 1 | 2026-10-28 | a |\n')).problems[0], /not at the end of the table/u);
+  assert.match(checkLedger(table, `${table}| 2 | 29 Oct | b |\n`).problems[0], /not YYYY-MM-DD/u);
+});
+
+test('L42-13 others: a listed uncommitted design record passes step 0; changed during the run it stops the records step; an unlisted file stops step 0', () => {
+  const dir = fixture();
+  try {
+    writeFileSync(join(dir, 'state/design/brief.md'), 'another session\'s design edit\n');
+    writeFileSync(join(dir, 'state/handoff.md'), `${readFileSync(join(dir, 'state/handoff.md'), 'utf8')}\n## design session\n\n- **Modified — this run's work:** state/design/brief.md\n`);
+    git(dir, 'add', 'state/handoff.md'); git(dir, 'commit', '-qm', 'handoff names the design session');
+    const listed = records(dir, 'others');
+    assert.equal(listed.status, 0, listed.stdout + listed.stderr);
+    assert.match(listed.stdout, /state\/design\/brief\.md {2}modified {2}sha256 [0-9a-f]{64} {2}owner: design session/u);
+    const line = listed.stdout.split('\n').find((l) => l.startsWith('--verify '));
+    const list = records(dir, 'others', '--list').stdout.trim();
+    assert.equal(line, `--verify ${list}`);
+    // Step 0: the listed record, unchanged.
+    assert.equal(records(dir, 'others', '--verify', list).status, 0);
+    // An unlisted record stops step 0.
+    writeFileSync(join(dir, 'state/notes.md'), 'unlisted\n');
+    const unlisted = records(dir, 'others', '--verify', list);
+    assert.equal(unlisted.status, 1);
+    assert.match(unlisted.stdout, /DIFFERS: state\/notes\.md: uncommitted \(\?\?\) and not on the list/u);
+    rmSync(join(dir, 'state/notes.md'));
+    // The records step: the release's own paths are not compared; the listed record changed → stop.
+    appendFileSync(join(dir, 'state/run-ledger.md'), `${ROW}\n`);
+    assert.equal(records(dir, 'others', '--verify', list, '--own', ...ALLOWED).status, 0, 'own records are neither compared nor unlisted');
+    appendFileSync(join(dir, 'state/design/brief.md'), 'changed during the run\n');
+    const changed = records(dir, 'others', '--verify', list, '--own', ...ALLOWED);
+    assert.equal(changed.status, 1);
+    assert.match(changed.stdout, /DIFFERS: state\/design\/brief\.md: changed since it was listed/u);
