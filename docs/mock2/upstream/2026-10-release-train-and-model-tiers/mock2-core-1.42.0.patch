+    const copy = join(common, 'mock2', 'cache', `${key}.json`);
+    let file = source;
+    if (existsSync(source)) {
+      try { mkdirSync(join(common, 'mock2', 'cache'), { recursive: true, mode: 0o700 }); copyFileSync(source, copy); file = copy; }
+      catch (error) { warnings.push(`cache file for ${item.check} not copied (${error.code ?? error.message}); the entry names the worktree's`); }
+    } else warnings.push(`cache file for ${item.check} is not in ${source}; the entry names where it was expected`);
+    out.push({ check: item.check, key, fingerprint: item.fingerprint ?? key, runId: item.runId ?? report.runId, file });
+  }
