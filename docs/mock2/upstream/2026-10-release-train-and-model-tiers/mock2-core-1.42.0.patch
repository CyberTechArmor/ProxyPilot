+  const warnings = [];
+  for (const item of listed) {
+    const key = item.key ?? item.fingerprint;
+    if (typeof item.check !== 'string' || !/^[0-9a-f]{16,128}$/u.test(String(key))) { warnings.push(`cache entry ${JSON.stringify(item.check ?? null)} has no usable key; left out`); continue; }
