+}
+
+/* ---------- withdraw ---------- */
+
+export function migrationKey(path) {
+  const parts = path.split('/');
+  for (let i = 0; i < parts.length - 1; i++) {
+    if (!MIGRATION_DIRS.has(parts[i])) continue;
+    const m = /^(\d+)/u.exec(parts[i + 1]);
+    if (m) return { dir: parts.slice(0, i + 1).join('/'), number: Number(m[1]), entry: parts[i + 1] };
+  }
+  return null;
+}
