+    return context.addedNotValid.has(name) ? no('VALIDATE in the same migration', `constraint ${name} is added NOT VALID in this migration: its lock is held to the end of the transaction, so VALIDATE goes in a later migration (§N.1)`) : ok('VALIDATE CONSTRAINT');
