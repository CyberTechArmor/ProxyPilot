+}
+
+/* ---------- pass, landed, list, base ---------- */
+
+export async function pass(git, { branch, commit, battery, cache: reportPath, base, reserved = [], adopt = false, main }) {
+  if (!branch || !git.ok(['check-ref-format', '--branch', branch])) throw new QueueError(`"${branch}" is not a branch name`);
