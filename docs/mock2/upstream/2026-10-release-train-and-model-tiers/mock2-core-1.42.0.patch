index 0000000000000000000000000000000000000000..22bbe43005011e05d0a2e77c198baee96a55f20c
--- /dev/null
+++ b/core/mock2/templates/repo/.mock2/generators/readonly-query/readonly-query.mjs.tpl
@@ -0,0 +1,181 @@
+#!/usr/bin/env node
+/*
+ * HOST-SIDE REFERENCE HELPER: installed by the host, never into a repository's production path.
+ * An operator copies this file (and its selftest) to the host's own tools directory, reviews it, and pins
+ * its sha256 in the release prompt that uses it (PRO current §N.11). It is not part of the application,
+ * is never built, deployed or imported by it, and Mock2 installs nothing on a host. The copy the
+ * generator wrote into the repository is the reviewed source; the host runs its own pinned copy.
+ *
+ * Production reads outside a release prompt go through this helper:
+ *   1. the statement is screened before anything connects (screen() below); a refused statement never
+ *      reaches the database;
+ *   2. it runs inside BEGIN READ ONLY … ROLLBACK, in a session whose default is read-only
+ *      (default_transaction_read_only on, at connection start and again by SET), with a statement
+ *      timeout, a lock timeout and an idle-in-transaction timeout;
+ *   3. it prints numbers only: a result cell that is not a number (or empty) is withheld and the run is
+ *      refused, since a production read reports counts, never row content (§N.11).
+ *
+ * Target: PostgreSQL 18 (the stack table's selected 18.6); every setting it uses exists since 9.6.
+ *
+ *   node readonly-query.mjs [--statement-timeout <ms>] [--lock-timeout <ms>] [--idle-timeout <ms>] [--sql "<statement>"]
+ *   (without --sql the statement is read from stdin)
+ *
+ * The connection is the standard client environment (PGSERVICE, PGHOST, PGPORT, PGDATABASE, PGUSER and a
+ * password file), never a password on the command line. It runs the psql client (PSQL names another path).
+ * Exit status: 0 the numbers were printed (tab-separated, one row per line); 1 refused (the screen or the
+ * numbers-only check, with the reason); 2 usage error; 3 the database refused or timed out (its message).
+ */
+import { spawn } from 'node:child_process';
+import { realpathSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+
+export const TARGET = 'PostgreSQL 18';
+export const DEFAULTS = Object.freeze({ statementTimeoutMs: 5000, lockTimeoutMs: 1000, idleTimeoutMs: 10000 });
+const MAX_LENGTH = 10000;
+
+/* Words a read never needs: writes, definitions, privileges, session and transaction control, locks and
+ * maintenance. Matched as whole words outside string literals, whatever their case. CASE … END is a
+ * read, so a bare END is not refused; END as transaction control is not reachable in a single SELECT. */
+const REFUSED_WORDS = [
+  'insert', 'update', 'delete', 'merge', 'upsert', 'truncate', 'create', 'alter', 'drop', 'grant', 'revoke',
+  'copy', 'call', 'do', 'execute', 'prepare', 'deallocate', 'refresh', 'reindex', 'vacuum', 'analyze', 'analyse',
+  'cluster', 'lock', 'listen', 'notify', 'unlisten', 'import', 'load', 'security', 'into',
+  'set', 'reset', 'discard', 'show',
+  'begin', 'commit', 'rollback', 'abort', 'savepoint', 'release', 'transaction', 'checkpoint',
+];
+/* Functions with an effect, or that run text as a statement: refused by name. Catalog functions are
+ * refused by their pg_ prefix (pg_sleep, pg_read_file, pg_terminate_backend, the pg_catalog schema). Those
+ * that execute a query given as a string: the *_to_xml family (query_to_xml, cursor_to_xml, table_to_xml,
+ * schema_to_xml, database_to_xml and their _and_xmlschema forms), ts_stat and ts_rewrite (their query
+ * argument), crosstab* and connectby (the tablefunc extension's source queries), and dblink*. The string itself
+ * is data to this screen, so the function is refused instead. */
+const REFUSED_FUNCTIONS = /\b(?:pg_\w*|set_config|current_setting|nextval|setval|lo_\w+|dblink\w*|\w*_to_xml\w*|ts_stat|ts_rewrite|crosstab\w*|connectby|txid_\w+)\b/iu;
+
+export class Refusal extends Error {}
+
+/* Screens one statement. Returns { ok: true, statement } or { ok: false, reason }. */
+export function screen(sql) {
+  const no = (reason) => ({ ok: false, reason });
+  if (typeof sql !== 'string' || !sql.trim()) return no('empty statement');
+  if (sql.length > MAX_LENGTH) return no(`longer than ${MAX_LENGTH} characters`);
+  if (sql.includes('\\')) return no('backslash (client commands and escape strings are not allowed)');
+  if (/--|\/\*/u.test(sql)) return no('comment (a comment can hide text from this screen)');
+  if (sql.includes('"')) return no('double quote (quoted identifiers are not allowed)');
+  if (/u&/iu.test(sql)) return no('Unicode-escape string (U&)');
+  if (sql.includes('$')) return no('dollar sign (dollar quoting and parameters are not allowed)');
+  if (/[\u0000-\u0008\u000b\u000c\u000e-\u001f\u007f]/u.test(sql)) return no('control character');
+  // String literals are data: removed before the words are read. An unterminated one is refused.
+  let bare = '';
+  for (let i = 0; i < sql.length; i++) {
+    if (sql[i] !== "'") { bare += sql[i]; continue; }
+    let j = i + 1;
+    for (;;) {
+      if (j >= sql.length) return no('unterminated string literal');
+      if (sql[j] === "'" && sql[j + 1] === "'") { j += 2; continue; }
+      if (sql[j] === "'") break;
+      j++;
+    }
+    if (/[eEbBxXnN]$/u.test(bare) && !/\w[eEbBxXnN]$/u.test(bare)) return no('prefixed string literal (E, B, X or N)');
+    bare += " '' ";
+    i = j;
+  }
+  const trimmed = bare.trim().replace(/;\s*$/u, '');
+  if (trimmed.includes(';')) return no('more than one statement');
+  if (!/^(?:select|with)\b/iu.test(trimmed)) return no('not a SELECT (or WITH … SELECT) statement');
+  const word = trimmed.toLowerCase().match(/[a-z_][a-z0-9_]*/gu)?.find((w) => REFUSED_WORDS.includes(w));
+  if (word) return no(`refused word: ${word.toUpperCase()}`);
+  const fn = REFUSED_FUNCTIONS.exec(trimmed);
+  if (fn) return no(`refused function: ${fn[0]}`);
+  if (/\bfor\s+(?:update|share|no\s+key|key)\b/iu.test(trimmed)) return no('row lock (FOR UPDATE / FOR SHARE)');
+  return { ok: true, statement: sql.trim().replace(/;\s*$/u, '') };
+}
+
+function timeouts(options = {}) {
+  const t = { ...DEFAULTS, ...Object.fromEntries(Object.entries(options).filter(([, v]) => v != null)) };
+  for (const [key, value] of Object.entries(t)) if (!Number.isInteger(value) || value < 1 || value > 3600000) throw new Refusal(`${key} must be a whole number of milliseconds between 1 and 3600000`);
+  return t;
+}
+
+/* The exact statements sent, in order: the session's read-only default and timeouts, then the read inside
+ * a read-only transaction that is rolled back. */
+export function sessionStatements(statement, options = {}) {
+  const t = timeouts(options);
+  return [
+    'SET default_transaction_read_only = on',
+    `SET statement_timeout = ${t.statementTimeoutMs}`,
+    `SET lock_timeout = ${t.lockTimeoutMs}`,
+    `SET idle_in_transaction_session_timeout = ${t.idleTimeoutMs}`,
+    'BEGIN READ ONLY',
+    statement,
+    'ROLLBACK',
+  ];
+}
+
+/* The same settings as connection-start options, so the session is read-only before its first statement. */
+export function startupOptions(options = {}) {
+  const t = timeouts(options);
+  return `-c default_transaction_read_only=on -c statement_timeout=${t.statementTimeoutMs} -c lock_timeout=${t.lockTimeoutMs} -c idle_in_transaction_session_timeout=${t.idleTimeoutMs}`;
+}
+
+const NUMBER = /^-?(?:\d+(?:\.\d*)?|\.\d+)(?:e[+-]?\d+)?$/iu;
+export function numbersOnly(rows) {
+  for (const row of rows) for (const cell of row) if (cell !== '' && !NUMBER.test(cell)) return false;
+  return true;
+}
+
+/* A client over the psql program: one connection, the statements on stdin, stop at the first error. */
+export function psqlClient({ env = process.env, psql = env.PSQL || 'psql', options = {} } = {}) {
+  return {
+    run(statements) {
+      return new Promise((resolve, reject) => {
+        const child = spawn(psql, ['-X', '-q', '-A', '-t', '-F', '\t', '-v', 'ON_ERROR_STOP=1', '--no-password'], {
+          env: { ...env, PGOPTIONS: `${env.PGOPTIONS ? `${env.PGOPTIONS} ` : ''}${startupOptions(options)}` }, stdio: ['pipe', 'pipe', 'pipe'] });
+        let out = '', err = '';
+        child.stdout.on('data', (c) => { out += c; });
+        child.stderr.on('data', (c) => { err += c; });
+        child.on('error', reject);
+        child.on('close', (code) => {
+          if (code !== 0) { reject(Object.assign(new Error(err.trim().split('\n').find((l) => /ERROR|FATAL/u.test(l)) || err.trim() || `psql exited ${code}`), { database: true })); return; }
+          resolve(out.split('\n').filter((l) => l !== '').map((l) => l.split('\t')));
+        });
+        child.stdin.end(statements.map((s) => `${s};`).join('\n') + '\n');
+      });
+    },
+  };
+}
+
+/* Screens, then (only when it passes) connects and runs the read. Returns the rows. */
+export async function readOnlyQuery(sql, { connect = (o) => psqlClient({ options: o }), ...options } = {}) {
+  const screened = screen(sql);
+  if (!screened.ok) throw new Refusal(`refused before connecting: ${screened.reason}`);
+  const statements = sessionStatements(screened.statement, options);
+  const client = await connect(options);
+  const rows = await client.run(statements);
+  if (!numbersOnly(rows)) throw new Refusal('the result holds a value that is not a number; it was withheld (numbers only, §N.11)');
+  return rows;
+}
+
+async function main(argv) {
+  const options = {};
+  let sql = null;
+  const flags = { '--statement-timeout': 'statementTimeoutMs', '--lock-timeout': 'lockTimeoutMs', '--idle-timeout': 'idleTimeoutMs' };
+  for (let i = 0; i < argv.length; i++) {
+    const value = argv[i + 1];
+    if (argv[i] === '--sql' && value != null) { sql = value; i++; }
+    else if (flags[argv[i]] && value != null) { options[flags[argv[i]]] = Number(value); i++; }
+    else { console.error('usage: node readonly-query.mjs [--statement-timeout <ms>] [--lock-timeout <ms>] [--idle-timeout <ms>] [--sql "<statement>"]'); return 2; }
+  }
+  if (sql == null) { sql = ''; for await (const chunk of process.stdin) sql += chunk; }
+  try {
+    const rows = await readOnlyQuery(sql, options);
+    for (const row of rows) console.log(row.join('\t'));
+    return 0;
+  } catch (error) {
+    console.error(`readonly-query: ${error.message}`);
+    return error instanceof Refusal ? 1 : error.database ? 3 : 2;
+  }
+}
+
+let direct = false;
+try { direct = !!process.argv[1] && realpathSync(process.argv[1]) === realpathSync(fileURLToPath(import.meta.url)); } catch { direct = false; }
+if (direct) main(process.argv.slice(2)).then((code) => { process.exitCode = code; });
diff --git a/core/mock2/templates/repo/.mock2/generators/readonly-query/readonly-query.selftest.mjs.tpl b/core/mock2/templates/repo/.mock2/generators/readonly-query/readonly-query.selftest.mjs.tpl
new file mode 100644
index 0000000000000000000000000000000000000000..3784945074bd92ada303f1ad09994184bc59ffe6
--- /dev/null
+++ b/core/mock2/templates/repo/.mock2/generators/readonly-query/readonly-query.selftest.mjs.tpl
@@ -0,0 +1,106 @@
+// HOST-SIDE: the selftest of readonly-query.mjs; installed beside it by the host, never into a repository's
+// production path. Run: node --test readonly-query.selftest.mjs
+// Without a database it proves the screen (every refused construct is refused before connecting) and the exact
+// statements a session sends, through a fake client. With READONLY_QUERY_TEST_PG=1 and the standard client
+// environment pointing at a disposable database (never production), it also proves on the real engine that a
+// permitted read runs read-only and is rolled back, a write inside the session is refused, and a slow statement
+// hits the statement timeout. Target: PostgreSQL 18.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { psqlClient, readOnlyQuery, Refusal, screen, sessionStatements } from './readonly-query.mjs';
+
+function fakeClient(rows = [['42']]) {
+  const calls = { connects: 0, statements: [] };
+  return { calls, connect: () => { calls.connects++; return { run: async (statements) => { calls.statements.push(...statements); return rows; } }; } };
+}
+
+const REFUSED = [
+  ['SELECT count(*) FROM orders WHERE note = \'a\\b\'', /backslash/u],
+  ['SELECT count(*) FROM orders -- hidden', /comment/u],
+  ['SELECT count(*) /* hidden */ FROM orders', /comment/u],
+  ['SELECT count(*) FROM "orders"', /double quote/u],
+  ["SELECT count(*) FROM orders WHERE note = U&'d\\0061'", /backslash|Unicode-escape/u],
+  ["SELECT count(*) FROM orders WHERE note = u&'x'", /Unicode-escape/u],
+  ['SELECT $$x$$', /dollar/u],
+  ['INSERT INTO orders VALUES (1)', /not a SELECT/u],
+  ['WITH gone AS (DELETE FROM orders RETURNING 1) SELECT count(*) FROM gone', /refused word: DELETE/u],
+  ['WITH x AS (UPDATE orders SET n = 1 RETURNING 1) SELECT count(*) FROM x', /refused word: UPDATE/u],
+  ['SELECT * INTO copy_of_orders FROM orders', /refused word: INTO/u],
+  ['SELECT count(*) FROM orders; DROP TABLE orders', /more than one statement/u],
+  ['SELECT 1; SET statement_timeout = 0', /more than one statement/u],
+  ['SELECT set_config(\'statement_timeout\', \'0\', false)', /refused function: set_config/u],
+  ['SELECT pg_sleep(60)', /refused function: pg_sleep/u],
+  ['SELECT count(*) FROM pg_catalog.pg_class', /refused function: pg_catalog/u],
+  ['SELECT nextval(\'orders_id_seq\')', /refused function: nextval/u],
+  ["select count(*) from ts_stat('select to_tsvector(dblink_exec(''x'',''delete from t'')::text)')", /refused function: ts_stat/u],
+  ["SELECT count(*) FROM ts_rewrite('a & b'::tsquery, 'SELECT t, s FROM aliases')", /refused function: ts_rewrite/u],
+  ["SELECT count(*) FROM schema_to_xml('public', true, false, '')", /refused function: schema_to_xml/u],
+  ["SELECT count(*) FROM crosstab('select dblink_exec(''x'', ''delete from t'')::text, 1, 1') AS c(a text, b int)", /refused function: crosstab/u],
+  ["SELECT count(*) FROM crosstab2('select 1, 2, 3')", /refused function: crosstab2/u],
+  ["SELECT count(*) FROM connectby('t', 'id', 'parent', '1', 0) AS c(id int, parent int, level int)", /refused function: connectby/u],
+  ["SELECT count(*) FROM query_to_xml_and_xmlschema('select 1', true, false, '')", /refused function: query_to_xml_and_xmlschema/u],
+  ['SELECT count(*) FROM orders FOR UPDATE', /refused word: UPDATE|row lock/u],
+  ['SELECT count(*) FROM orders FOR SHARE', /row lock/u],
+  ['SELECT 1 WHERE 1 = 1 AND begin', /refused word: BEGIN/u],
+  ['SELECT count(*) FROM orders WHERE note = \'unterminated', /unterminated/u],
+  ['', /empty/u],
+];
+
+test('every refused construct is refused before connecting', async () => {
+  for (const [sql, reason] of REFUSED) {
+    const screened = screen(sql);
+    assert.equal(screened.ok, false, `not refused: ${sql}`);
+    assert.match(screened.reason, reason, sql);
+    const fake = fakeClient();
+    await assert.rejects(readOnlyQuery(sql, { connect: fake.connect }), (error) => error instanceof Refusal && /refused before connecting/u.test(error.message));
+    assert.equal(fake.calls.connects, 0, `connected for: ${sql}`);
+  }
+});
+
+test('words inside string literals are data, and CASE … END is a read', () => {
+  assert.equal(screen("SELECT count(*) FROM orders WHERE status = 'delete me; drop'").ok, true);
+  assert.equal(screen('SELECT sum(CASE WHEN total > 10 THEN 1 ELSE 0 END) FROM orders;').ok, true);
+  assert.equal(screen('WITH recent AS (SELECT id FROM orders) SELECT count(*) FROM recent').ok, true);
+});
+
+test('a permitted read sends exactly the read-only session, BEGIN READ ONLY, the statement and ROLLBACK', async () => {
+  const fake = fakeClient([['17']]);
+  const rows = await readOnlyQuery('SELECT count(*) FROM orders;', { connect: fake.connect, statementTimeoutMs: 2000 });
+  assert.deepEqual(rows, [['17']]);
+  assert.deepEqual(fake.calls.statements, [
+    'SET default_transaction_read_only = on',
+    'SET statement_timeout = 2000',
+    'SET lock_timeout = 1000',
+    'SET idle_in_transaction_session_timeout = 10000',
+    'BEGIN READ ONLY',
+    'SELECT count(*) FROM orders',
+    'ROLLBACK',
+  ]);
+});
+
+test('numbers only: a result with row content is withheld', async () => {
+  const fake = fakeClient([['alice@example.invalid']]);
+  await assert.rejects(readOnlyQuery('SELECT count(*) FROM orders', { connect: fake.connect }), /numbers only/u);
+});
+
+const real = process.env.READONLY_QUERY_TEST_PG === '1';
+test('real engine: read-only, rolled back, timed out (READONLY_QUERY_TEST_PG=1, a disposable database)', { skip: !real && 'set READONLY_QUERY_TEST_PG=1 with the client environment pointing at a disposable database' }, async () => {
+  const admin = psqlClient({ options: {} });
+  // Set up outside the helper: the helper itself cannot write.
+  await new Promise((resolve, reject) => {
+    import('node:child_process').then(({ spawnSync }) => {
+      const r = spawnSync(process.env.PSQL || 'psql', ['-X', '-q', '-v', 'ON_ERROR_STOP=1', '-c', 'DROP TABLE IF EXISTS selftest_orders; CREATE TABLE selftest_orders (id int); INSERT INTO selftest_orders VALUES (1), (2), (3);'], { encoding: 'utf8' });
+      if (r.status === 0) resolve(); else reject(new Error(r.stderr));
+    });
+  });
+  assert.deepEqual(await readOnlyQuery('SELECT count(*) FROM selftest_orders'), [['3']]);
+  // The session refuses a write even when a statement gets past the screen.
+  await assert.rejects(admin.run(sessionStatements('INSERT INTO selftest_orders VALUES (4)')), /read-only transaction/u);
+  // The read runs in a read-only transaction, and ROLLBACK closes it: after it, a statement is its own
+  // transaction again (now() equals its statement time), which inside the open transaction it would not be.
+  const rows = await admin.run([...sessionStatements("SELECT CASE WHEN current_setting('transaction_read_only') = 'on' THEN 1 ELSE 0 END"),
+    'SELECT count(*) FROM (SELECT 1 WHERE now() = statement_timestamp()) AS outside_transaction']);
+  assert.deepEqual(rows, [['1'], ['1']]);
+  // A slow statement hits the statement timeout (sent past the screen, which refuses pg_sleep).
+  await assert.rejects(admin.run(sessionStatements('SELECT pg_sleep(5)', { statementTimeoutMs: 300 })), /statement timeout/u);
