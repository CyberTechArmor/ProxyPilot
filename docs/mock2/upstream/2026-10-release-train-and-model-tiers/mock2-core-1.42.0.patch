+ * What the service worker reads: its navigation denylist, generated from the server's list of non-app path
+ * prefixes (contracts/non-app-paths.mjs), never written by hand. A worker built with a plugin passes
+ * NAVIGATION_DENYLIST as its navigation-fallback denylist; a hand-written worker answers a navigation from the
+ * cached page only when servesAppShell(request) is true. Generated by gen.mjs non-app-paths.
+ */
+import { isNonAppPath, navigationDenylist } from '../../../contracts/non-app-paths.mjs';
+
+export const NAVIGATION_DENYLIST = navigationDenylist();
+
+export function servesAppShell(request) {
+  return request.mode === 'navigate' && request.method === 'GET' && !isNonAppPath(new URL(request.url).pathname);
+}
