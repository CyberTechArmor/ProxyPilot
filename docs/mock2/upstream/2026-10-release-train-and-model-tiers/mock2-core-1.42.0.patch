+}
+export const recordPath = (common) => join(common, 'mock2', 'queue.json');
+
+export function emptyRecord() {
+  return { schemaVersion: SCHEMA, note: 'Release queue (PRO current §M.10), written by .mock2/bin/queue.mjs; shared by every worktree.', nextPlace: 1, entries: [], landed: [], withdrawn: [] };
+}
+
+export function readRecord(common) {
+  const path = recordPath(common);
+  if (!existsSync(path)) return emptyRecord();
+  let value;
+  try { value = JSON.parse(readFileSync(path, 'utf8')); }
+  catch (error) { throw new QueueError(`${path} could not be read (${error.message}); fix or remove it by hand`); }
+  if (!value || value.schemaVersion !== SCHEMA || !Array.isArray(value.entries)) throw new QueueError(`${path} is not a version ${SCHEMA} queue record`);
+  value.landed ??= []; value.withdrawn ??= []; value.nextPlace ??= Math.max(0, ...value.entries.map((e) => e.place ?? 0)) + 1;
