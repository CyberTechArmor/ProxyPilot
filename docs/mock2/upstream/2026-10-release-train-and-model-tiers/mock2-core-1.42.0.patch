+    depth: record.entries.length, main: mainTip,
+    entries: record.entries.map((e, i) => ({ position: i + 1, place: e.place, branch: e.branch, commit: e.commit, battery: e.battery, queuedAt: e.queuedAt, waitMs: now - Date.parse(e.queuedAt),
