+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync, appendFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { checkLedger, placeholderLines } from '../templates/repo/.mock2/bin/records.mjs';
+
+// The records tool (1.42.0): `records.mjs commit` makes a release's records commit from an exact allowed list
+// (L42-9, PRO current §P.4), and `records.mjs others` lists other sessions' uncommitted record edits with their
+// hashes, which step 0 names and the records step checks unchanged (L42-13, §N.8).
+const TPL = fileURLToPath(new URL('../templates/repo/', import.meta.url));
+const RECORDS = join(TPL, '.mock2/bin/records.mjs');
+const ENV = { ...process.env, GIT_AUTHOR_NAME: 't', GIT_AUTHOR_EMAIL: 't@example.invalid', GIT_COMMITTER_NAME: 't', GIT_COMMITTER_EMAIL: 't@example.invalid' };
+const git = (dir, ...args) => spawnSync('git', args, { cwd: dir, encoding: 'utf8', env: ENV });
+const records = (dir, ...args) => spawnSync(process.execPath, [RECORDS, ...args], { cwd: dir, encoding: 'utf8', env: ENV });
+const RECORD = 'state/change-records/2026-10-29-release-r1.md';
+const ALLOWED = [RECORD, 'state/handoff.md', 'state/run-ledger.md', 'state/work.md'];
+const ROW = '| 1 | 2026-10-29 | 10:00 | 10:20 | 20 | terminal | not published | release r1 | 12 | 3 | 1 | AUTHORIZED TASK COMPLETE | | | r1 | | | | | | |';
+
+/* A repository with the template's records and tools on main, and a work branch for the release. */
+function fixture() {
+  const dir = mkdtempSync(join(tmpdir(), 'mock2-records-'));
+  git(dir, 'init', '-q', '-b', 'main');
+  cpSync(join(TPL, 'state'), join(dir, 'state'), { recursive: true });
+  cpSync(join(TPL, '.mock2/bin'), join(dir, '.mock2/bin'), { recursive: true });
+  mkdirSync(join(dir, 'state/design'), { recursive: true });
+  git(dir, 'add', '-A');
+  git(dir, 'commit', '-qm', 'init');
+  git(dir, 'switch', '-qc', 'release');
+  return dir;
+}
+function writeRecords(dir) {
+  mkdirSync(join(dir, 'state/change-records'), { recursive: true });
+  writeFileSync(join(dir, RECORD), '# Release r1\n\nenvironment mode read from the running container: production\n');
+  appendFileSync(join(dir, 'state/run-ledger.md'), `${ROW}\n`);
+  writeFileSync(join(dir, 'state/handoff.md'), readFileSync(join(dir, 'state/handoff.md'), 'utf8').replace('- **Turn id:**', '- **Release:** r1\n- **Turn id:**'));
+}
+const head = (dir) => git(dir, 'rev-parse', 'HEAD').stdout.trim();
+
+test('L42-9 commits only the allowed paths; another session\'s uncommitted line in a non-listed file stays uncommitted', () => {
+  const dir = fixture();
+  try {
+    writeRecords(dir);
+    appendFileSync(join(dir, 'state/rules.md'), 'another session\'s line\n');
+    const r = records(dir, 'commit', '--allowed', ...ALLOWED, '--require', `${RECORD}=environment mode read from the running container: production`, '--require', 'state/run-ledger.md=r1', '--base', 'main', '--message', 'records: release r1');
+    assert.equal(r.status, 0, r.stdout + r.stderr);
+    const named = git(dir, 'show', '--name-only', '--format=', 'HEAD').stdout.trim().split('\n').sort();
+    assert.deepEqual(named, [RECORD, 'state/handoff.md', 'state/run-ledger.md'].sort());
+    assert.match(git(dir, 'status', '--porcelain').stdout, /^ M state\/rules\.md$/mu, 'the other session\'s file is left uncommitted');
+    assert.match(r.stdout, /carried  state\/work\.md \(in HEAD, unchanged\)/u, 'an allowed path already carried is reported as carried');
+    assert.match(r.stdout, /^scan: secrets\.mjs --committed --base main against .*0 findings/mu);
+    assert.match(r.stdout, /^report: records commit [0-9a-f]{12} — 3 committed, 1 carried \(state\/work\.md\), scan .* — not pushed$/mu);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-9 refused before committing: a wrong handoff heading, a malformed or edited ledger row, a missing required text, a second trailing newline', () => {
+  const cases = [
+    ['heading', (dir) => writeFileSync(join(dir, 'state/handoff.md'), `# Hand-off notes\n${readFileSync(join(dir, 'state/handoff.md'), 'utf8').split('\n').slice(1).join('\n')}`), /title line is "# Hand-off notes", the template's is "# Handoff"/],
+    ['row cells', (dir) => appendFileSync(join(dir, 'state/run-ledger.md'), '| 2 | 2026-10-29 | short |\n'), /has 3 cells; the header has 21/],
+    ['row edited', (dir) => writeFileSync(join(dir, 'state/run-ledger.md'), readFileSync(join(dir, 'state/run-ledger.md'), 'utf8').replace(ROW, ROW.replace('| 1 |', '| 7 |'))), null],
+    ['require', () => {}, /does not contain "real-path smoke: "/],
+    ['newline', (dir) => appendFileSync(join(dir, RECORD), '\n'), /ends with more than one newline/],
+  ];
+  for (const [label, spoil, why] of cases) {
+    const dir = fixture();
+    try {
+      if (label === 'row edited') {
+        writeRecords(dir);
+        git(dir, 'add', '-A'); git(dir, 'commit', '-qm', 'earlier records');
+        spoil(dir);
+      } else { writeRecords(dir); spoil(dir); }
+      const before = head(dir);
+      const r = records(dir, 'commit', '--allowed', ...ALLOWED, '--require', label === 'require' ? `${RECORD}=real-path smoke: ` : `${RECORD}=environment mode`, '--message', 'records');
+      assert.equal(r.status, 1, `${label}: ${r.stdout}${r.stderr}`);
+      assert.match(r.stdout, /refused before committing/u, label);
+      assert.match(r.stdout, why ?? /existing rows changed, or a new row is not at the end of the table/u, label);
+      assert.equal(head(dir), before, `${label}: nothing committed`);
+    } finally { rmSync(dir, { recursive: true, force: true }); }
+  }
+});
+
+test('L42-9 a planted test credential fails the scan: the commit is named, nothing is pushed', () => {
+  const dir = fixture();
+  try {
+    writeRecords(dir);
+    // Built at run time so this file carries no credential shape.
+    appendFileSync(join(dir, RECORD), `key ${'AKIA'}${'QWERTYUIOPASDFGH'}\n`);
+    const r = records(dir, 'commit', '--allowed', ...ALLOWED, '--base', 'main', '--message', 'records: release r1');
+    assert.equal(r.status, 1, r.stdout + r.stderr);
+    assert.match(r.stdout, /AWS access key id/u);
+    assert.match(r.stdout, /STOP: the secret scan found 1 finding/u);
+    assert.match(r.stdout, /made but not fit to push: nothing to push/u);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-9 --dry-run checks and commits nothing; an allowed path neither changed nor in HEAD is refused', () => {
+  const dir = fixture();
+  try {
+    writeRecords(dir);
+    const before = head(dir);
+    const dry = records(dir, 'commit', '--allowed', ...ALLOWED, '--message', 'records', '--dry-run');
+    assert.equal(dry.status, 0, dry.stdout + dry.stderr);
+    assert.match(dry.stdout, /every check passed; nothing committed/u);
+    assert.equal(head(dir), before);
+    assert.equal(git(dir, 'diff', '--cached', '--name-only').stdout, '', 'nothing staged');
