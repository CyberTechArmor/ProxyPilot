+  const include = globs.map(globToRegExp);
+  const exclude = globs === DEFAULT_RECORDS ? BRANCH_RECORDS.map(globToRegExp) : [];
+  return (path) => include.some((re) => re.test(path)) && !exclude.some((re) => re.test(path));
+}
+
+const findEntry = (record, which) => {
+  const lower = String(which).toLowerCase();
+  const hex = /^[0-9a-f]{7,40}$/u.test(lower);
+  return record.entries.findIndex((e) => e.branch === which || (hex && (e.commit.startsWith(lower) || e.repinned?.commit?.startsWith(lower))));
+};
+
+/* The nearest queued candidate before position `before` whose commit `commit` contains. */
+function nearestParent(git, entries, commit, before = entries.length) {
+  for (let i = before - 1; i >= 0; i--) if (entries[i].commit !== commit && git.isAncestor(entries[i].commit, commit)) return entries[i];
+  return null;
+}
+
+/* The cache list from a battery run report. */
+export function cacheFromReport(report, worktree, common) {
+  const listed = Array.isArray(report.cache) ? report.cache : (report.results ?? [])
