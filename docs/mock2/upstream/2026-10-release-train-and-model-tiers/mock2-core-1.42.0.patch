+}
+
+export async function landed(git, which) {
+  return mutate(commonDir(git), (record) => {
+    const at = findEntry(record, which);
+    if (at === -1) throw refuse(`${which} is not in the queue`);
+    const [entry] = record.entries.splice(at, 1);
+    const now = Date.now();
+    record.landed.push({ branch: entry.branch, commit: entry.commit, repinned: entry.repinned?.commit ?? null, queuedAt: entry.queuedAt, landedAt: new Date(now).toISOString(), waitMs: now - Date.parse(entry.queuedAt) });
