+// builds it (adjust createApp's options to this application's).
+import { describe, it, expect } from 'vitest';
+import { APP_SHELL_PATHS, NON_APP_PATH_PREFIXES, denylistPrefixes, isNonAppPath, prefixDrift, serverNonAppPrefixes } from '../contracts/non-app-paths.mjs';
+import { NAVIGATION_DENYLIST } from '../web/src/{{app}}/navigation-denylist.mjs';
