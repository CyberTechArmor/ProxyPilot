+ *     drop outside a contraction, VALIDATE in the migration that added the constraint, and any form it
+ *     does not recognise.
+ * A false refusal is corrected by its own reviewed change with a test for the form; that is not weakening
+ * the guard. A refused migration is reshaped until it passes; the guard is never loosened to let it through.
+ *
+ * The manifest (MANIFEST below) has one line per migration, append-only, never edited for a released entry:
+ *   <file> | sha256:<64 hex> | <additive|transition|contraction|destructive> | <approval reference> | <lock footprint>
+ * The lock footprint names each existing table locked, the lock (blocks writes / blocks reads) and how long,
+ * or "none (new objects only)" (§N.1). Lines starting with # are comments.
+ */
+import { createHash } from 'node:crypto';
+
+export const CLASSIFICATIONS = ['additive', 'transition', 'contraction', 'destructive'];
+export const MANIFEST_FORMAT = '<file> | sha256:<64 hex> | <additive|transition|contraction|destructive> | <approval reference> | <lock footprint>';
+
+/* Tokens and statements. Comments and whitespace are dropped; strings stay one token. */
+export function tokenize(sql) {
+  const statements = [];
