+  const warnings = [];
+  const common = commonDir(git);
+  let cache = [];
+  if (reportPath) {
+    let report;
+    try { report = JSON.parse(readFileSync(resolve(git.cwd, reportPath), 'utf8')); }
+    catch (error) { throw new QueueError(`--cache ${reportPath} could not be read (${error.message})`); }
+    if (!['pass', 'known-baselines-only'].includes(report.verdict)) throw refuse(`the report ${reportPath} has verdict ${JSON.stringify(report.verdict ?? null)}: not a passed final battery; nothing recorded`);
