+      dependants.push({ branch: dep.branch, commit: dep.commit, command, after: direct ? null : parent.branch, artefacts });
+    }
+    record.withdrawn.push({ branch, commit: entry.commit, base: entry.base, at: new Date().toISOString(), reason, reserved: entry.reserved ?? [], dependants: dependants.map((d) => d.branch) });
+    record.withdrawn = record.withdrawn.slice(-200);
+    return { entry, dependants, releasedIds: entry.reserved ?? [] };
+  });
+}
+
+/* ---------- absorb ---------- */
+
+/* The commits a candidate ahead of position `index` stands for, as tested and as re-pinned, queued or landed. */
+function aheadCommits(record, index) {
+  const out = [];
+  for (const e of record.entries.slice(0, index)) { out.push({ branch: e.branch, commit: e.commit }); if (e.repinned?.commit) out.push({ branch: e.branch, commit: e.repinned.commit }); }
+  for (const l of record.landed) { out.push({ branch: l.branch, commit: l.commit }); if (l.repinned) out.push({ branch: l.branch, commit: l.repinned }); }
+  return out;
+}
+
+function identityEnv(git, commit) {
+  // The original commit's dates, committer's included: the same inputs give the same re-pin, so the commit a dry
+  // run prints is the commit --apply writes.
+  const [an, ae, ad, cd] = git.run(['log', '-1', '--format=%an%x00%ae%x00%aI%x00%cI', commit]).split('\0');
+  const env = { GIT_AUTHOR_NAME: an, GIT_AUTHOR_EMAIL: ae, GIT_AUTHOR_DATE: ad, GIT_COMMITTER_DATE: cd };
+  if (!git.ok(['config', 'user.name'])) env.GIT_COMMITTER_NAME = an;
+  if (!git.ok(['config', 'user.email'])) env.GIT_COMMITTER_EMAIL = ae;
+  return env;
+}
+
+export async function absorb(git, { branch, apply = false, records, main }) {
+  const isRecord = recordsMatcher(records?.length ? records : DEFAULT_RECORDS);
+  const common = commonDir(git);
+  const plan = () => {
+    const record = readRecord(common);
+    const index = record.entries.findIndex((e) => e.branch === branch);
+    if (index === -1) throw refuse(`${branch} is not in the queue`);
+    const entry = record.entries[index];
+    const tested = entry.commit, builtOn = entry.base;
+    const mainTip = mainRef(git, main);
+    if (!builtOn || !git.isAncestor(builtOn, tested)) throw refuse(`the entry's base ${short(builtOn)} is not an ancestor of its tested commit; pass it again with --base`);
+    // 1. How the main branch moved since the tested commit.
+    const known = aheadCommits(record, index);
+    const moved = git.run(['rev-list', '--reverse', '--topo-order', mainTip.commit, '--not', tested]).split('\n').filter(Boolean);
+    const movedBy = [];
+    for (const c of moved) {
+      const parents = git.run(['rev-list', '--parents', '-n', '1', c]).split(' ').slice(1);
+      const paths = parents.length ? git.changed(parents[0], c) : git.run(['ls-tree', '-r', '--name-only', '-z', c]).split('\0').filter(Boolean);
+      if (paths.length && paths.every(isRecord)) { movedBy.push({ commit: c, kind: 'records-only' }); continue; }
+      const owner = known.find((k) => git.isAncestor(c, k.commit));
+      if (owner) { movedBy.push({ commit: c, kind: 'candidate', branch: owner.branch }); continue; }
+      throw refuse(`the main branch moved by a code commit since ${short(tested)}: ${short(c)} "${git.subject(c)}" (${paths.filter((p) => !isRecord(p)).slice(0, 5).join(', ') || 'no file change'}). Absorb refused; the candidate needs a restack and a new battery (§M.10 item 3, §N.8)`);
+    }
+    // 2. Replay only the candidate's own commits onto the main branch.
+    const own = git.run(['rev-list', '--reverse', '--topo-order', tested, '--not', builtOn]).split('\n').filter(Boolean);
+    let current = mainTip.commit;
+    const replayed = [], dropped = [];
+    for (const c of own) {
+      const parents = git.run(['rev-list', '--parents', '-n', '1', c]).split(' ').slice(1);
+      if (parents.length !== 1) throw refuse(`${short(c)} is a merge commit; absorb replays single-parent commits only. Restack by hand`);
+      const paths = git.changed(parents[0], c);
+      if (paths.length && paths.every(isRecord) && paths.every((p) => git.blob(c, p) === git.blob(current, p))) { dropped.push({ commit: c, reason: 'records-only copy the main branch already carries' }); continue; }
+      const merged = git.run(['merge-tree', '--write-tree', '--name-only', '--no-messages', `--merge-base=${parents[0]}`, current, c], { allowFail: true });
+      if (merged.status === 1) {
+        const lines = merged.stdout.split('\n').filter(Boolean).slice(1);
+        throw refuse(`replaying ${short(c)} "${git.subject(c)}" conflicts in ${lines.join(', ') || 'unknown paths'}; nothing written. Records conflicts are reconciled by union by hand (§M.4)`);
+      }
+      if (merged.status !== 0) throw new QueueError(`git merge-tree failed (${(merged.stderr || '').trim().split('\n').at(-1) || `exit ${merged.status}`}); absorb needs git 2.40 or later`);
+      const tree = merged.stdout.split('\n')[0].trim();
+      if (tree === git.tree(current)) { dropped.push({ commit: c, reason: 'empty after the replay' }); continue; }
+      const message = git.run(['log', '-1', '--format=%B', c]);
+      current = git.run(['commit-tree', tree, '-p', current], { input: `${message}\n`, env: identityEnv(git, c) }).trim();
+      replayed.push({ from: c, to: current });
+    }
+    // 3. Prove the result differs from the tested commit only in records files.
+    const differing = git.changed(tested, current);
+    const outside = differing.filter((p) => !isRecord(p));
+    if (outside.length) throw refuse(`the absorbed tree differs from the tested commit ${short(tested)} outside the records: ${outside.slice(0, 10).join(', ')}${outside.length > 10 ? ` and ${outside.length - 10} more` : ''}; nothing written`);
+    return { branch, tested, base: builtOn, main: mainTip, movedBy, replayed, dropped, recordsDiffering: differing, repin: current, alreadyCurrent: current === tested };
+  };
+  if (!apply) return { ...plan(), applied: false };
+  return mutate(common, (record) => {
+    const result = plan();
+    const entry = record.entries.find((e) => e.branch === branch);
+    const local = git.commit(`refs/heads/${branch}`);
+    let refUpdated = false;
+    if (local) {
+      if (local !== result.tested && local !== entry.repinned?.commit && local !== result.repin) throw refuse(`refs/heads/${branch} is at ${short(local)}, neither the tested commit nor its re-pin: it changed after the battery; nothing written`);
+      const checkedOut = git.run(['worktree', 'list', '--porcelain']).split('\n\n').find((block) => block.split('\n').includes(`branch refs/heads/${branch}`));
+      if (checkedOut && local !== result.repin) throw refuse(`${branch} is checked out in ${checkedOut.split('\n')[0].replace(/^worktree /u, '')}; absorb does not move a checked-out branch. Re-pin: ${result.repin}`);
+      if (local !== result.repin) { git.run(['update-ref', '-m', `queue absorb ${short(result.tested)}`, `refs/heads/${branch}`, result.repin, local]); refUpdated = true; }
+    }
+    if (result.repin !== result.tested) entry.repinned = { commit: result.repin, from: result.tested, main: result.main.commit, at: new Date().toISOString() };
+    return { value: { ...result, applied: true, refUpdated, localBranch: Boolean(local) } };
+  });
+}
+
+/* ---------- slots ---------- */
+
+const slotDir = (common, kind) => join(common, 'mock2', 'slots', kind);
+
+export async function takeSlot(git, { kind, slots = 1, pid = process.ppid }) {
+  if (!SLOT_KINDS.includes(kind)) throw new QueueError(`slot kind must be ${SLOT_KINDS.join(', ')}`);
+  const root = slotDir(commonDir(git), kind);
+  let release;
+  try { release = await acquireSlot({ budgetDir: root, sharedSlots: slots, queueTimeoutMs: 0, noWait: true }, () => false); }
+  catch (error) {
+    if (/^not started: every shared slot/u.test(error.message)) throw new QueueError(`the ${kind} slot is full (${slots} of ${slots} taken); try later`, SLOT_FULL);
+    throw new QueueError(error.message.replace('shared resource budget configuration differs; use the established host budget or a deliberately separate budget directory', `the ${kind} slots were set up with another count; give the same --slots`));
+  }
+  const name = readdirSync(root).find((n) => /^slot-\d+\.lock$/u.test(n) && JSON.parse(readFileSync(join(root, n), 'utf8')).pid === process.pid);
+  const path = join(root, name);
+  const owner = JSON.parse(readFileSync(path, 'utf8'));
+  if (pid !== process.pid) atomicJson(path, { ...owner, pid, kind, by: process.pid });   // the slot lasts as long as that process
+  return { kind, token: owner.token, path, pid, release };
+}
+
+export function releaseSlot(git, { kind, token, pid = process.ppid }) {
+  if (!SLOT_KINDS.includes(kind)) throw new QueueError(`slot kind must be ${SLOT_KINDS.join(', ')}`);
+  const root = slotDir(commonDir(git), kind);
+  let names = [];
+  try { names = readdirSync(root).filter((n) => /^slot-\d+\.lock$/u.test(n)); } catch { /* none taken */ }
+  for (const name of names) {
+    let owner; try { owner = JSON.parse(readFileSync(join(root, name), 'utf8')); } catch { continue; }
+    if (token ? owner.token === token : owner.pid === pid) { unlinkSync(join(root, name)); return { kind, released: name }; }
+  }
+  throw refuse(`no ${kind} slot ${token ? `with token ${token}` : `held by pid ${pid}`}`);
+}
+
+export function listSlots(git) {
+  const common = commonDir(git);
+  return SLOT_KINDS.map((kind) => {
+    let names = []; try { names = readdirSync(slotDir(common, kind)).filter((n) => /^slot-\d+\.lock$/u.test(n)); } catch { /* none */ }
+    return { kind, taken: names.map((n) => { try { const o = JSON.parse(readFileSync(join(slotDir(common, kind), n), 'utf8')); return { slot: n, pid: o.pid, since: o.acquiredAt }; } catch { return { slot: n }; } }) };
+  });
+}
+
+/* ---------- command line ---------- */
+
+const USAGE = `usage: node .mock2/bin/queue.mjs pass <branch> <commit> --battery <runId> [--cache <report.json>] [--base <commit>] [--reserved <ids>] [--adopt]
+       node .mock2/bin/queue.mjs landed <commit|branch>
+       node .mock2/bin/queue.mjs list [--json]
+       node .mock2/bin/queue.mjs base [--for <branch>]
+       node .mock2/bin/queue.mjs withdraw <branch> [--reason <text>] [--json]
+       node .mock2/bin/queue.mjs absorb <branch> --dry-run|--apply [--records <glob>]… [--json]
+       node .mock2/bin/queue.mjs slot take|release|list [<build|battery|release>] [--slots <n>] [--pid <pid>] [--token <t>] [-- <command…>]
+       (every command takes --main <ref>)`;
+
+export function parseArguments(argv) {
+  const args = [...argv];
+  const dash = args.indexOf('--');
+  const command = dash === -1 ? [] : args.splice(dash).slice(1);
+  const flags = { records: [], reserved: [] };
+  const positional = [];
+  const valued = ['--battery', '--cache', '--base', '--reserved', '--reason', '--for', '--records', '--main', '--slots', '--pid', '--token'];
+  while (args.length) {
+    const a = args.shift();
+    if (valued.includes(a)) {
+      if (!args.length || args[0].startsWith('--')) throw new QueueError(`${a} needs a value\n${USAGE}`);
+      const v = args.shift(), key = a.slice(2);
+      if (key === 'records' || key === 'reserved') flags[key].push(v); else flags[key] = v;
+    } else if (['--json', '--dry-run', '--apply', '--adopt'].includes(a)) flags[a.slice(2)] = true;
+    else if (a === '--help' || a === '-h') flags.help = true;
+    else if (a.startsWith('-')) throw new QueueError(`unknown option ${a}\n${USAGE}`);
+    else positional.push(a);
+  }
+  return { positional, flags, command };
+}
+
+const say = (line) => process.stderr.write(`queue: ${line}\n`);
+
+export async function main(argv = process.argv.slice(2), cwd = process.cwd()) {
+  const { positional, flags, command } = parseArguments(argv);
+  if (flags.help || !positional.length) { console.log(USAGE); return flags.help ? 0 : 2; }
+  const git = gitRunner(cwd);
+  if (!git.ok(['rev-parse', '--git-dir'])) throw new QueueError('not inside a git repository');
+  const [verb, ...rest] = positional;
+  const want = (n) => { if (rest.length !== n) throw new QueueError(`${verb} takes ${n} argument${n === 1 ? '' : 's'}\n${USAGE}`); };
+  if (verb === 'pass') {
+    want(2);
+    const r = await pass(git, { branch: rest[0], commit: rest[1], battery: flags.battery, cache: flags.cache, base: flags.base, reserved: flags.reserved, adopt: flags.adopt, main: flags.main });
+    for (const w of r.warnings) say(`WARNING: ${w}`);
+    console.log(`${r.action === 'queued' ? 'queued' : 'pass replaced (place kept)'}: ${r.entry.branch} ${short(r.entry.commit)} at position ${r.place}, built on ${r.entry.parent ?? 'the main branch'} (base ${short(r.entry.base)})${r.entry.cache.length ? `; ${r.entry.cache.length} cache entr${r.entry.cache.length === 1 ? 'y' : 'ies'}` : ''}`);
+    return 0;
+  }
+  if (verb === 'landed') {
+    want(1);
+    const r = await landed(git, rest[0]);
+    console.log(`landed: ${r.entry.branch} ${short(r.entry.commit)} after ${duration(Date.now() - Date.parse(r.entry.queuedAt))} in the queue; depth now ${r.depth}`);
+    return 0;
+  }
+  if (verb === 'list') {
+    want(0);
+    const r = list(git, { main: flags.main });
+    if (flags.json) { console.log(JSON.stringify(r, null, 2)); return 0; }
+    console.log(`release queue: depth ${r.depth}; main ${r.main ? `${r.main.ref} ${short(r.main.commit)}` : 'unknown'}`);
+    for (const e of r.entries) console.log(`  ${e.position}. ${e.branch} ${short(e.commit)} battery ${e.battery}; waiting ${duration(e.waitMs)}; built on ${e.builtOn}${e.repinned ? `; re-pinned ${short(e.repinned)}` : ''}${e.restack ? `; restack: ${e.restack}` : ''}${e.revalidate ? `; revalidate ${e.revalidate}` : ''}`);
+    console.log(`landed: ${r.landed.count}${r.landed.medianWaitMs != null ? `, median wait of the last ${Math.min(20, r.landed.count)} ${duration(r.landed.medianWaitMs)}` : ''}`);
+    return 0;
+  }
+  if (verb === 'base') {
+    want(0);
+    const r = baseFor(git, { forItem: flags.for, main: flags.main });
+    say(`${r.why}: ${r.what}`);
+    console.log(r.commit);
+    return 0;
+  }
+  if (verb === 'withdraw') {
+    want(1);
+    const r = await withdraw(git, { branch: rest[0], reason: flags.reason ?? null, main: flags.main });
+    if (flags.json) { console.log(JSON.stringify(r, null, 2)); return 0; }
+    console.log(`withdrawn: ${r.entry.branch} ${short(r.entry.commit)}${flags.reason ? ` (${flags.reason})` : ''}; ${r.dependants.length ? `${r.dependants.length} candidate${r.dependants.length === 1 ? ' built on it restacks and revalidates' : 's built on it restack and revalidate'} in full:` : 'no queued candidate was built on it'}`);
+    for (const d of r.dependants) {
+      console.log(`  ${d.branch} ${short(d.commit)}${d.after ? ` (after ${d.after} is restacked)` : ''}:\n    ${d.command}`);
+      for (const a of d.artefacts) console.log(`    renumber: ${a.path ?? a.id} — ${a.reason}`);
+    }
+    if (r.releasedIds.length) console.log(`reserved by the withdrawn candidate: ${r.releasedIds.join(', ')}`);
+    return 0;
+  }
+  if (verb === 'absorb') {
+    want(1);
+    if (Boolean(flags['dry-run']) === Boolean(flags.apply)) throw new QueueError(`absorb takes exactly one of --dry-run and --apply\n${USAGE}`);
+    const r = await absorb(git, { branch: rest[0], apply: Boolean(flags.apply), records: flags.records, main: flags.main });
+    if (flags.json) { console.log(JSON.stringify(r, null, 2)); return 0; }
+    const counts = r.movedBy.reduce((n, m) => ({ ...n, [m.kind]: (n[m.kind] ?? 0) + 1 }), {});
+    console.log(`absorb ${r.branch}${r.applied ? '' : ' (dry run: no ref, index or queue change)'}: main ${r.main.ref} moved by ${r.movedBy.length} commit${r.movedBy.length === 1 ? '' : 's'} since the tested commit ${short(r.tested)} (${counts['records-only'] ?? 0} records-only, ${counts.candidate ?? 0} from candidates ahead${counts.candidate ? `: ${[...new Set(r.movedBy.filter((m) => m.branch).map((m) => m.branch))].join(', ')}` : ''})`);
+    console.log(`  replayed ${r.replayed.length} own commit${r.replayed.length === 1 ? '' : 's'}; dropped ${r.dropped.length}${r.dropped.map((d) => `\n    dropped ${short(d.commit)}: ${d.reason}`).join('')}`);
+    console.log(`  differs from the tested commit only in records: ${r.recordsDiffering.length ? r.recordsDiffering.join(', ') : '(no file)'}`);
+    if (r.applied) console.log(`  ${r.refUpdated ? `refs/heads/${r.branch} moved to the re-pin` : r.localBranch ? `refs/heads/${r.branch} already at the re-pin` : `no local branch ${r.branch}: only the queue record changed`}; push it to the candidate branch before the deploy`);
+    console.log(`re-pin: ${r.repin}`);
+    return 0;
+  }
+  if (verb === 'slot') {
+    const [action, kind] = rest;
+    if (action === 'list') { for (const s of listSlots(git)) console.log(`${s.kind}: ${s.taken.length ? s.taken.map((t) => `${t.slot} pid ${t.pid ?? '?'}`).join(', ') : 'free'}`); return 0; }
+    if (rest.length !== 2) throw new QueueError(`slot ${action ?? ''} needs a kind\n${USAGE}`);
+    const slots = flags.slots == null ? 1 : Number(flags.slots);
+    if (!Number.isInteger(slots) || slots < 1) throw new QueueError('--slots must be a positive whole number');
+    const pid = flags.pid == null ? undefined : Number(flags.pid);
+    if (pid !== undefined && (!Number.isInteger(pid) || pid < 1)) throw new QueueError('--pid must be a process id');
+    if (action === 'take') {
+      if (command.length) {
+        const held = await takeSlot(git, { kind, slots, pid: process.pid });
+        say(`holding the ${kind} slot while ${command[0]} runs`);
+        try {
+          const r = spawnSync(command[0], command.slice(1), { cwd, stdio: 'inherit' });
+          if (r.error) throw new QueueError(`${command[0]} could not start: ${r.error.message}`);
+          return r.status ?? 1;
+        } finally { held.release(); }
+      }
+      const held = await takeSlot(git, { kind, slots, pid: pid ?? process.ppid });
+      say(`${kind} slot taken for pid ${held.pid}; it is free again when that process ends, or with: node .mock2/bin/queue.mjs slot release ${kind} --token ${held.token}`);
+      console.log(held.token);
+      return 0;
+    }
+    if (action === 'release') { const r = releaseSlot(git, { kind, token: flags.token, pid: pid ?? process.ppid }); console.log(`released ${r.kind} ${r.released}`); return 0; }
+    throw new QueueError(`unknown slot action ${action}\n${USAGE}`);
+  }
+  throw new QueueError(`unknown command ${verb}\n${USAGE}`);
+}
+
+if (isMain(import.meta.url)) {
+  main().then((code) => { process.exitCode = code; }).catch((error) => {
+    console.error(`queue: ${error.message}`);
+    process.exitCode = error instanceof QueueError ? error.code : 2;
+  });
+}
