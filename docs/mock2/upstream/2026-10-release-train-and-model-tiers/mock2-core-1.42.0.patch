+
+test('L42-9 a commit that fails leaves the index as it was: an untracked listed path is unstaged again', () => {
+  const dir = fixture();
+  try {
+    writeRecords(dir);
+    mkdirSync(join(dir, 'hooks'));
+    writeFileSync(join(dir, 'hooks/pre-commit'), '#!/bin/sh\nexit 1\n', { mode: 0o755 });
+    git(dir, 'config', 'core.hooksPath', 'hooks');
+    const r = records(dir, 'commit', '--allowed', ...ALLOWED, '--message', 'records');
+    assert.equal(r.status, 1, r.stdout + r.stderr);
