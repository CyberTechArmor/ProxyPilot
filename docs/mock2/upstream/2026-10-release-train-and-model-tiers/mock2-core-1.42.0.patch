+  ['NOT VALID inside the expression is not NOT VALID', 'ALTER TABLE orders ADD CONSTRAINT c CHECK (NOT valid);', 'additive', /NOT VALID/u],
+  ['CREATE TABLE IF NOT EXISTS may find the table there', 'CREATE TABLE IF NOT EXISTS orders (id int);\nCREATE INDEX orders_id ON orders (id);', 'additive', /CONCURRENTLY/u],
+  ['a changed search path forgets created tables', 'CREATE TABLE orders (id int);\nSET search_path = billing;\nCREATE INDEX orders_id ON orders (id);', 'additive', /CONCURRENTLY/u],
+  ['a data change outside a transition', 'DELETE FROM orders;', 'additive', /transition/u],
+  ['an unrecognised form', 'VACUUM FULL orders;', 'additive', /not a recognised/u],
