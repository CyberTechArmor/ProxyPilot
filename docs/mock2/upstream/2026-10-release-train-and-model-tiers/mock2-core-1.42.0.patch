@@ -0,0 +1,382 @@
+#!/usr/bin/env node
+/*
+ * Mock2 records tool (1.42.0): a release's records commit from an exact allowed list (PRO current §P.4),
+ * and the list of other sessions' uncommitted record edits a release's step 0 names (§N.8).
+ *
+ * node .mock2/bin/records.mjs commit --allowed <path>… --message <m> [--require <file>=<text>]…
+ *                                    [--base <destination>] [--dry-run] [--json]
+ *   Re-reads each allowed path and, before committing anything, refuses (exit 1) when:
+ *   - an allowed path is neither changed nor in HEAD (§P.4: an allowed path missing from the commit
+ *     passes only when it is in HEAD and unchanged; it is then reported as carried by an earlier commit);
+ *   - `git diff --check` finds whitespace errors in the paths, or a file does not end with exactly one
+ *     newline;
+ *   - state/handoff.md's title line differs from the one HEAD carries (`# Handoff` when HEAD has none);
+ *   - state/run-ledger.md's rows in HEAD changed, a new row is not at the end of the table, or a new
+ *     row's cell count, `#` or date does not fit the header row of the file's own `## Ledger` table (a `#` that is not the next integer
+ *     is a WARNING: two sessions appending at once leave a duplicate that is not renumbered);
+ *   - a --require <file>=<text> file is not on the list or does not contain the text.
+ *   Then it commits the changed paths with `git commit --only -m <m> -- <paths>` (an untracked listed
+ *   path is added first, and unstaged again if the commit fails; nothing else is staged), checks
+ *   `git show --name-only HEAD` against the list (a path a commit hook added is named there), checks
+ *   each --require in HEAD, and runs `secrets.mjs --committed [--base <destination>]`. It prints
+ *   the commit, the carried paths and the scan's counts, and a `report:` line. It never pushes.
+ *   --dry-run runs every check and commits nothing.
+ *
+ * node .mock2/bin/records.mjs others [--under <dir>]… [--list] [--json]
+ *   Other sessions' uncommitted record paths (default under state/): modified, staged, deleted or
+ *   untracked, each with its sha256 (`deleted` for a removed file) and its owner from the handoff
+ *   section that names it, where one does. Prints a `--verify path=sha256 …` line a gate can paste;
+ *   --list prints only the `path=sha256 …` tokens (or `none`), for a gate's SAVE.
+ * node .mock2/bin/records.mjs others --verify <path=sha256|none>… [--own <path>…] [--under <dir>]…
+ *   Exit 0 when every listed path still has its hash and no other record path under the scope is
+ *   uncommitted; 1 on any difference, each named. --own names the paths this release itself writes
+ *   (its allowed list, at the records step): they are neither compared nor counted as unlisted. A
+ *   token may hold several space-separated entries (a saved value passed as one argument).
+ *
+ * node .mock2/bin/records.mjs placeholders <file|-> [--at <commit>]
+ *   Lines of a record (a file, the file as <commit> holds it, or standard input) that hold placeholder text: a `<word>` or `<…>` marker
+ *   or an unfilled `{{token}}` (a bare ellipsis in prose is not one). Exit 0 none, 1 found. Step 0 runs
+ *   it on the change record at the pin (§P.4: a prompt is ready only when its record holds none).
+ *
+ * Exit codes: 0 = done (or nothing differs); 1 = refused or a difference (the commit, if made, is named
+ * and not pushed); 2 = usage, or the tool could not run.
+ */
+import { spawnSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { copyFileSync, existsSync, lstatSync, mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { PLACEHOLDER, fsPath, isMain, repoRoot } from './tool-support.mjs';
+
+const HANDOFF = 'state/handoff.md';
+const LEDGER = 'state/run-ledger.md';
+const SECRETS = fileURLToPath(new URL('./secrets.mjs', import.meta.url));
+// The handoff template's own sub-headings: a session's section is the nearest heading that is not one.
+const HANDOFF_PARTS = new Set(['verification record', 'working tree', 'progress', 'finish on another surface', 'in force — do not reopen', 'already established — do not re-derive', 'continuation prompt']);
+
+function run(root, args, options = {}) {
