+const TYPE_TAILS = { DOUBLE: [['PRECISION']], CHARACTER: [['VARYING']], CHAR: [['VARYING']], BIT: [['VARYING']], NATIONAL: [['CHARACTER', 'VARYING'], ['CHARACTER'], ['CHAR', 'VARYING'], ['CHAR']],
+  TIMESTAMP: [['WITH', 'TIME', 'ZONE'], ['WITHOUT', 'TIME', 'ZONE']], TIME: [['WITH', 'TIME', 'ZONE'], ['WITHOUT', 'TIME', 'ZONE']] };
+
+/* Consumes one type name at i (a cast's target): a word or quoted name, schema-qualified or not, a known
+ * multi-word name, an optional (n[,m]) and any [] pairs. Returns the index after it, or -1. */
+function typeName(e, i) {
+  if (!e[i] || !['word', 'ident'].includes(e[i].type)) return -1;
+  const first = e[i];
+  i++;
+  while (e[i]?.value === '.' && ['word', 'ident'].includes(e[i + 1]?.type)) i += 2;
+  if (first.type === 'word') {
+    const tail = (TYPE_TAILS[first.value] ?? []).find((words) => words.every((w, n) => isWord(e[i + n], w)));
+    if (tail) i += tail.length;
+  }
+  if (e[i]?.value === '(') {
+    let j = i + 1;
+    while (e[j] && e[j].value !== ')' && (/^[0-9,]$/u.test(e[j].value))) j++;
+    if (e[j]?.value !== ')') return -1;
+    i = j + 1;
+    if (first.type === 'word' && (first.value === 'TIMESTAMP' || first.value === 'TIME')) { const tail = TYPE_TAILS.TIME.find((words) => words.every((w, n) => isWord(e[i + n], w))); if (tail) i += tail.length; }
