+  for (const path of ownAdded) {
+    const key = migrationKey(path);
+    if (!key || seen.has(`${key.dir}/${key.entry}`)) continue;
+    seen.add(`${key.dir}/${key.entry}`);
+    const before = withdrawnMigrations.filter((m) => m.key.dir === key.dir && m.key.number <= key.number);
+    if (before.length) found.push({ kind: 'migration', path, number: key.number, reason: `numbered after ${before.map((m) => m.path).join(', ')}, which leave${before.length === 1 ? 's' : ''} with the withdrawal: renumber at the restack (reserved anew)` });
