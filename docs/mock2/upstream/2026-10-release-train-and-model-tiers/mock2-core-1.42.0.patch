+++ b/core/mock2/tests/repeat-failure.test.mjs
@@ -0,0 +1,64 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { copyFileSync, mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// 1.42.0 P12 (tool part): a failing test with no covering known-failure entry that fails again within the
+// last 10 runs is named on a WARNING line; the exit status is unchanged.
+const bin = fileURLToPath(new URL('../templates/repo/.mock2/bin/', import.meta.url));
+
+function fixture(t, output) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-repeat-failure-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  mkdirSync(join(root, '.mock2/bin'), { recursive: true });
+  for (const file of ['check.mjs', 'check-support.mjs']) copyFileSync(join(bin, file), join(root, '.mock2/bin', file));
+  writeFileSync(join(root, '.gitignore'), '.mock2/cache/\n.mock2/evidence/\n.budget/\n.home/\nmode.txt\n');
+  writeFileSync(join(root, 'source.txt'), 'input\n');
+  writeFileSync(join(root, 'suite.cjs'), `const fail = require('fs').readFileSync('mode.txt', 'utf8').trim() === 'fail'; process.stdout.write(fail ? ${JSON.stringify(output)} : '# pass 11\\n# fail 0\\n'); process.exit(fail ? 1 : 0)`);
+  writeFileSync(join(root, '.mock2/checks.json'), JSON.stringify({ scheduler: { maxParallel: 1, sharedSlots: 2, budgetDir: '.budget' }, checks: [{ id: 'unit', run: 'node suite.cjs' }] }));
+  for (const args of [['init', '-q'], ['add', '.'], ['-c', 'user.name=t', '-c', 'user.email=t@example.invalid', 'commit', '-qm', 'fixture']]) assert.equal(spawnSync('git', args, { cwd: root }).status, 0);
+  const run = (mode) => {
+    writeFileSync(join(root, 'mode.txt'), mode);
+    const env = { ...process.env, HOME: join(root, '.home') };
+    delete env.MOCK2_BUDGET_DIR; delete env.MOCK2_SHARED_SLOTS;
+    const result = spawnSync(process.execPath, ['.mock2/bin/check.mjs', '--json'], { cwd: root, env, encoding: 'utf8', timeout: 30000 });
+    return { status: result.status, report: JSON.parse(result.stdout) };
+  };
+  const head = spawnSync('git', ['rev-parse', 'HEAD'], { cwd: root, encoding: 'utf8' }).stdout.trim();
+  return { root, run, head };
+}
+const repeated = (report) => report.warnings.filter((w) => /^repeat failure without an entry:/.test(w));
+const VITEST = 'FAIL src/queue.test.ts > drains under load\n      Tests  1 failed | 10 passed (11)\n';
+
+test('L42-12 the same failing test in two of five runs, with no entry, is named; the exit status is unchanged', (t) => {
+  const f = fixture(t, VITEST);
+  const first = f.run('fail');
+  assert.deepEqual(first.report.results[0].failedTests, ['src/queue.test.ts > drains under load']);
+  assert.deepEqual(repeated(first.report), []);
+  assert.deepEqual(repeated(f.run('pass').report), []);
+  assert.deepEqual(repeated(f.run('pass').report), []);
+  const fourth = f.run('fail');
+  assert.equal(fourth.status, 1);
+  assert.deepEqual(repeated(fourth.report), ['repeat failure without an entry: src/queue.test.ts > drains under load (2 of the last 10 runs) in unit; name it for repair, or record a known-failure entry proved under contention']);
+  assert.deepEqual(repeated(f.run('pass').report), []);
+});
+
+test('L42-12 node:test names are read too; a run with a covering entry gets the known-baseline label instead', (t) => {
+  const f = fixture(t, 'not ok 3 - drains under load\n# pass 10\n# fail 1\n');
+  f.run('fail');
+  assert.match(repeated(f.run('fail').report)[0] ?? '', /drains under load \(2 of the last 10 runs\)/);
+  writeFileSync(join(f.root, '.mock2/known-failures.json'), JSON.stringify({ entries: [{ id: 'load', check: 'unit', failed: 1, match: ['drains under load'], inputs: ['source.txt'], provenOn: f.head, since: new Date().toISOString().slice(0, 10), owner: 'test' }] }));
+  const covered = f.run('fail').report;
+  assert.deepEqual(covered.results[0].knownBaseline, ['load']);
+  assert.deepEqual(repeated(covered), []);
+});
+
+test('L42-12 failures more than 10 runs apart are not a repeat', (t) => {
+  const f = fixture(t, VITEST);
+  f.run('fail');
+  for (let index = 0; index < 9; index++) f.run('pass');
+  assert.deepEqual(repeated(f.run('fail').report), []);
+});
