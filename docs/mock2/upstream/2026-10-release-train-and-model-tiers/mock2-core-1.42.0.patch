+    assert.equal(records(dir, 'others', '--verify', 'none', '--own', ...ALLOWED, 'state/design/brief.md').status, 0);
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test('L42-13 placeholders: a record at a commit with placeholder text is not ready; a bare ellipsis is prose', () => {
