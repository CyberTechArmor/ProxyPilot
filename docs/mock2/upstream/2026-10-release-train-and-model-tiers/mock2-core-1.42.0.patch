+test('L42-1 a build\'s identity chains its prerequisites; one with neither identity nor reuse is refused', (t) => {
+  const codegen = { id: 'codegen', run: 'node -e "0"', identity: { inputs: ['e2e'], tools, env: [] } };
+  const build = { ...CHECKS[1], dependsOn: ['codegen'] };
+  const browser = { ...CHECKS[2], reuse: { ...CHECKS[2].reuse, inputs: ['web', 'browser.cjs'] } };
+  const r = runner(t, [{ id: 'codegen', run: 'node -e "0"' }, build, browser]);
