+/*
+ * The paths an Express application routes directly (app.get, app.post, …), for the non-app path drift test.
+ * Reads the router stack of Express 4 (app._router) and Express 5 (app.router). A router mounted with
+ * app.use(prefix, router) does not keep its prefix in Express 5, so it is counted in `mounts` and its prefix
+ * must be one the list already has (the test says so when there are mounts it cannot place).
+ * Generated by gen.mjs non-app-paths.
+ */
+export function expressRoutePaths(app) {
+  const stack = app?._router?.stack ?? app?.router?.stack ?? [];
+  const paths = [];
+  let mounts = 0;
+  for (const layer of stack) {
+    if (layer.route) paths.push(...[layer.route.path].flat());
+    else if (layer.handle?.stack) mounts++;
+  }
+  return { paths, mounts };
+}
