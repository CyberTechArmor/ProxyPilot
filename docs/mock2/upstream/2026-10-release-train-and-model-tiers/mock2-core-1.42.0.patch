+ */
+import { spawnSync } from 'node:child_process';
+import { copyFileSync, existsSync, mkdirSync, readFileSync, readdirSync, unlinkSync } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { acquireSlot, atomicJson } from './check-support.mjs';
+import { globToRegExp, isMain } from './tool-support.mjs';
+
+export class QueueError extends Error {
+  constructor(message, code = 2) { super(message); this.code = code; }
+}
+const refuse = (message) => new QueueError(message, 1);
