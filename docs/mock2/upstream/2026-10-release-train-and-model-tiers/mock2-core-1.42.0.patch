+      const escapes = c !== "'"; let j = escapes ? i + 2 : i + 1;
+      for (;;) {
+        if (j >= sql.length) throw new Error('unterminated string');
+        if (escapes && sql[j] === '\\') { j += 2; continue; }
+        if (sql[j] === "'" && sql[j + 1] === "'") { j += 2; continue; }
+        if (sql[j] === "'") break;
+        j++;
+      }
+      tokens.push({ type: 'string', value: sql.slice(i, j + 1) }); i = j + 1; continue;
+    }
