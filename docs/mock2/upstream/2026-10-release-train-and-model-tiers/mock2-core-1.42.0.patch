+++ b/core/mock2/tests/port-helper.test.mjs
@@ -0,0 +1,61 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, rmSync, symlinkSync, existsSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const PORT = fileURLToPath(new URL('../templates/repo/.mock2/bin/port.mjs', import.meta.url));
+const git = (cwd, ...args) => { const r = spawnSync('git', ['-c', 'user.name=Test', '-c', 'user.email=dev@example.invalid', '-c', 'commit.gpgSign=false', '-c', 'core.hooksPath=/dev/null', ...args], { cwd, encoding: 'utf8' }); assert.equal(r.status, 0, r.stderr); return r.stdout.trim(); };
+// The caller's environment without the port variable, so only what a case sets reaches the helper.
+const baseEnv = () => { const env = { ...process.env }; delete env.HARNESS_PORT; return env; };
+const port = (cwd, args = [], env = {}) => spawnSync(process.execPath, [PORT, ...args], { cwd, encoding: 'utf8', env: { ...baseEnv(), ...env } });
+
+function repo(t, ignore = true) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-port-')); t.after(() => rmSync(root, { recursive: true, force: true }));
+  const main = join(root, 'main'); mkdirSync(main); git(main, 'init', '-q', '-b', 'main');
+  writeFileSync(join(main, '.gitignore'), ignore ? '/.mock2/.local/\n' : 'node_modules\n'); git(main, 'add', '.gitignore'); git(main, 'commit', '-qm', 'base');
+  return { root, main, file: join(main, '.mock2', '.local', 'harness-port') };
+}
+
+test('L42-16 no environment and no file: exit non-zero, "no reserved port", no default', t => {
+  const r = repo(t); const result = port(r.main);
+  assert.notEqual(result.status, 0); assert.equal(result.stdout, ''); assert.match(result.stderr, /no reserved port/);
+});
+
+test('L42-16 the per-worktree file is printed; the environment overrides it', t => {
+  const r = repo(t); mkdirSync(join(r.main, '.mock2', '.local'), { recursive: true }); writeFileSync(r.file, '5173\n');
+  const fromFile = port(r.main); assert.equal(fromFile.status, 0); assert.equal(fromFile.stdout, '5173\n');
+  const fromEnv = port(r.main, [], { HARNESS_PORT: '5300' }); assert.equal(fromEnv.status, 0); assert.equal(fromEnv.stdout, '5300\n');
+  // From a subfolder the worktree's own file is found.
+  mkdirSync(join(r.main, 'src')); assert.equal(port(join(r.main, 'src')).stdout, '5173\n');
+});
+
+test('L42-16 --write writes the value, ignored by Git, and prints it', t => {
+  const r = repo(t); const result = port(r.main, ['--write', '5410']);
+  assert.equal(result.status, 0, result.stderr); assert.equal(result.stdout, '5410\n'); assert.equal(readFileSync(r.file, 'utf8'), '5410\n');
+  assert.equal(git(r.main, 'status', '--porcelain'), '');
+  assert.equal(port(r.main).stdout, '5410\n');
+});
+
+test('L42-16 fails closed: bad values, a link, a tracked file, an unignored file and a port another worktree records are refused', t => {
+  const r = repo(t);
+  for (const value of ['80', '70000', 'abc', '']) assert.equal(port(r.main, ['--write', value]).status, 2, value);
+  assert.equal(port(r.main, [], { HARNESS_PORT: 'next' }).status, 2);
+  assert.equal(existsSync(r.file), false);
+  // Another worktree of the same repository already records 5500.
+  const other = join(r.root, 'other'); git(r.main, 'worktree', 'add', '-qb', 'other', other);
+  assert.equal(port(other, ['--write', '5500']).status, 0);
+  const taken = port(r.main, ['--write', '5500']); assert.equal(taken.status, 2); assert.match(taken.stderr, /already recorded/);
+  // A link is not a port file.
+  mkdirSync(join(r.main, '.mock2', '.local'), { recursive: true }); writeFileSync(join(r.root, 'elsewhere'), '5600\n'); symlinkSync(join(r.root, 'elsewhere'), r.file);
+  assert.equal(port(r.main).status, 2); assert.equal(port(r.main, ['--write', '5601']).status, 2);
+  rmSync(r.file);
+  // Tracked: every worktree would share it.
+  writeFileSync(r.file, '5700\n'); git(r.main, 'add', '-f', r.file); git(r.main, 'commit', '-qm', 'tracked port');
+  const tracked = port(r.main); assert.equal(tracked.status, 2); assert.match(tracked.stderr, /tracked/);
+  // Not ignored: --write refuses and writes nothing.
+  const u = repo(t, false); const unignored = port(u.main, ['--write', '5800']);
+  assert.equal(unignored.status, 2); assert.match(unignored.stderr, /not ignored/); assert.equal(existsSync(u.file), false);
+});
diff --git a/core/mock2/tests/ratchet-seed.test.mjs b/core/mock2/tests/ratchet-seed.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6284fe58f9c2bb27510e8243b45d537450a277b2
--- /dev/null
+++ b/core/mock2/tests/ratchet-seed.test.mjs
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+// L42-17 (P17): a new state of an existing page seeds its undersized-control ratchet at the page's recorded count
+// and names the page; the count may not rise above that seed; a wholly new page's states seed at 0 (the
+// verification rule; PRO current §K.6). No template ships an undersized-control ratchet or a states-catalog count
+// (the states-catalog generator records state names only), so the rule is text only. This fixture fixes the
+// rule's data in the shape it describes — per page and viewport a recorded count; per state and viewport a seed,
+// a count and, when the state renders an existing page's shell, the page it was seeded from — and checks the
+// seeding and the rise against it, so a project that keeps such a ratchet has a worked reference.
+
+/* The seed of each viewport of a new state: the page's recorded count where the page exists, else 0. */
+function seedState(ratchet, { state, page, viewports }) {
+  const recorded = ratchet.pages[page];
+  return { state, page, seededFromPage: recorded ? page : null,
+    viewports: Object.fromEntries(viewports.map((v) => [v, { seed: recorded?.[v] ?? 0 }])) };
+}
+
+/* Findings for a change (review findings, never a stop): a count above its seed, a seed that is not the page's recorded count, an existing-page seed that does not name the page. */
+function findings(ratchet) {
+  const out = [];
+  for (const [state, entry] of Object.entries(ratchet.states)) {
+    const recorded = ratchet.pages[entry.page];
+    if (recorded && entry.seededFromPage !== entry.page) out.push(`${state}: renders page ${entry.page}'s shell; the record names the page`);
+    for (const [viewport, { seed, count }] of Object.entries(entry.viewports)) {
+      const expected = recorded?.[viewport] ?? 0;
+      if (entry.new && seed !== expected) out.push(`${state} ${viewport}: seeded at ${seed}, not at ${recorded ? `page ${entry.page}'s recorded count` : '0 (a new page)'} ${expected}`);
+      if (count > seed) out.push(`${state} ${viewport}: ${count} undersized controls, above its seed ${seed}`);
+    }
+  }
+  return out;
+}
+
+const base = () => ({
+  pages: { orders: { mobile: 3, desktop: 1 } },
+  states: { 'orders-list-ready': { page: 'orders', seededFromPage: 'orders', viewports: { mobile: { seed: 3, count: 3 }, desktop: { seed: 1, count: 1 } } } },
+});
+
+test('L42-17 a new state of an existing page seeds at that page\'s recorded count and names the page', () => {
+  const ratchet = base();
+  const seeded = seedState(ratchet, { state: 'orders-list-empty', page: 'orders', viewports: ['mobile', 'desktop'] });
+  assert.deepEqual(seeded, { state: 'orders-list-empty', page: 'orders', seededFromPage: 'orders', viewports: { mobile: { seed: 3 }, desktop: { seed: 1 } } });
+  ratchet.states['orders-list-empty'] = { ...seeded, new: true, viewports: { mobile: { seed: 3, count: 3 }, desktop: { seed: 1, count: 0 } } };
+  assert.deepEqual(findings(ratchet), [], 'at or below the seed: no finding');
+});
+
+test('L42-17 a wholly new page seeds at 0', () => {
+  const ratchet = base();
+  const seeded = seedState(ratchet, { state: 'invoices-list-ready', page: 'invoices', viewports: ['mobile'] });
+  assert.deepEqual(seeded, { state: 'invoices-list-ready', page: 'invoices', seededFromPage: null, viewports: { mobile: { seed: 0 } } });
+  ratchet.states['invoices-list-ready'] = { ...seeded, new: true, viewports: { mobile: { seed: 0, count: 2 } } };
+  assert.deepEqual(findings(ratchet), ['invoices-list-ready mobile: 2 undersized controls, above its seed 0']);
+});
+
+test('L42-17 the count may not rise above the seed; a seed taken from what the state happens to render is a finding', () => {
+  const ratchet = base();
+  ratchet.states['orders-detail-error'] = { page: 'orders', seededFromPage: 'orders', new: true, viewports: { mobile: { seed: 3, count: 4 } } };
+  ratchet.states['orders-list-error'] = { page: 'orders', seededFromPage: 'orders', new: true, viewports: { mobile: { seed: 5, count: 5 } } };
+  ratchet.states['orders-list-loading'] = { page: 'orders', seededFromPage: null, new: true, viewports: { mobile: { seed: 3, count: 3 } } };
+  assert.deepEqual(findings(ratchet), [
+    'orders-detail-error mobile: 4 undersized controls, above its seed 3',
+    'orders-list-error mobile: seeded at 5, not at page orders\'s recorded count 3',
+    'orders-list-loading: renders page orders\'s shell; the record names the page',
+  ]);
+});
