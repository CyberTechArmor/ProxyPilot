diff --git a/core/mock2/tests/sw-prefix.test.mjs b/core/mock2/tests/sw-prefix.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..b3a1b78fc6fca1ec05284cf3e20dee6fadbd1c08
--- /dev/null
+++ b/core/mock2/tests/sw-prefix.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { spawnSync } from 'node:child_process';
+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+// L42-5 (P5): a service worker's navigation denylist comes from the server's own list of non-app path prefixes,
+// and a drift test fails on any difference. No generator emitted a service worker or server routes, so the
+// template is gen.mjs non-app-paths: one shared module (contracts/non-app-paths.mjs) that the server's fallback and
+// the worker's denylist both read, and a drift test template. Here the generated drift test runs against a
+// fixture server (an Express 5-shaped router stack) through a minimal stand-in for its test runner's API.
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const { generate } = await import(pathToFileURL(join(site, 'core/mock2/templates/repo/.mock2/bin/gen.mjs')).href);
+
+const RUNNER = `import { describe, it } from 'node:test';
+import assert from 'node:assert/strict';
+export { describe, it };
+export function expect(actual) {
+  return { toBe: (e) => assert.equal(actual, e), toEqual: (e) => assert.deepEqual(actual, e), toMatch: (re) => assert.match(actual, re) };
+}
+`;
+// The fixture server: the foundation's direct routes, read from routes.json so a case can add one.
+const APP = `import { readFileSync } from 'node:fs';
+export function createApp() {
+  const paths = JSON.parse(readFileSync(new URL('../routes.json', import.meta.url), 'utf8'));
+  return { router: { stack: [{ name: 'query' }, ...paths.map((path) => ({ route: { path } })), { handle: { stack: [] } }] } };
+}
+`;
+const ROUTES = ['/healthz', '/readyz', '/api/session', '/api/setup', '/api/admin/users/:id', ['/', '/app', '/setup', '/login', '/admin']];
+
+async function world(t) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-sw-prefix-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  const r = await generate({ generator: 'non-app-paths', root });
+  const write = (path, text) => { mkdirSync(dirname(join(root, path)), { recursive: true }); writeFileSync(join(root, path), text); };
+  write('node_modules/vitest/package.json', JSON.stringify({ name: 'vitest', type: 'module', exports: './index.mjs' }));
+  write('node_modules/vitest/index.mjs', RUNNER);
+  write('src/app.js', APP);
+  write('src/package.json', JSON.stringify({ type: 'module' }));
+  write('tests/fakes/store.mjs', 'export const createFakeStore = () => ({});\n');
+  write('routes.json', JSON.stringify(ROUTES));
+  const env = { ...process.env }; delete env.NODE_TEST_CONTEXT;
+  const run = () => spawnSync(process.execPath, ['--test', '--test-reporter=tap', 'tests/non-app-paths.test.mjs'], { cwd: root, encoding: 'utf8', env });
+  return { root, r, write, run, read: (p) => readFileSync(join(root, p), 'utf8') };
+}
+
+test('L42-5 gen non-app-paths: the worker\'s denylist and the server read one module', async (t) => {
+  const w = await world(t);
+  assert.deepEqual(w.r.files.map((f) => [f.to, f.action]), [['contracts/non-app-paths.mjs', 'wrote'], ['web/src/app/navigation-denylist.mjs', 'wrote'], ['src/routes/route-paths.mjs', 'wrote'], ['tests/non-app-paths.test.mjs', 'wrote']]);
+  assert.match(w.read('web/src/app/navigation-denylist.mjs'), /import \{ isNonAppPath, navigationDenylist \} from '\.\.\/\.\.\/\.\.\/contracts\/non-app-paths\.mjs';/u);
+  assert.match(w.r.next.join('\n'), /serve the application's page only where !isNonAppPath\(req\.path\)/u);
+  const shared = await import(pathToFileURL(join(w.root, 'contracts/non-app-paths.mjs')).href);
+  const worker = await import(pathToFileURL(join(w.root, 'web/src/app/navigation-denylist.mjs')).href);
+  assert.deepEqual(shared.denylistPrefixes(worker.NAVIGATION_DENYLIST), [...shared.NON_APP_PATH_PREFIXES]);
+  assert.equal(worker.servesAppShell({ mode: 'navigate', method: 'GET', url: 'https://example.invalid/admin/users' }), true);
+  assert.equal(worker.servesAppShell({ mode: 'navigate', method: 'GET', url: 'https://example.invalid/api/session' }), false);
+  assert.equal(worker.servesAppShell({ mode: 'navigate', method: 'GET', url: 'https://example.invalid/apiary' }), true, 'segment boundary');
+});
+
+test('L42-5 the drift test passes while the lists agree, fails on an extra server prefix until the shared list has it', async (t) => {
+  const w = await world(t);
+  let r = w.run();
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+  assert.match(r.stdout, /# pass 3\n# fail 0/u);
+  // A new route a browser opens directly.
+  w.write('routes.json', JSON.stringify([...ROUTES, '/webhooks/inbound']));
+  r = w.run();
+  assert.equal(r.status, 1);
+  assert.match(r.stdout, /not ok \d+ - every non-app route the server answers is on the list/u);
+  assert.match(r.stdout, /\+   extra: \[\n\s*\+     '\/webhooks'/u);
+  // On the shared list: the worker's denylist follows, and both checks pass again.
+  w.write('contracts/non-app-paths.mjs', w.read('contracts/non-app-paths.mjs').replace("['/api', '/healthz', '/readyz']", "['/api', '/healthz', '/readyz', '/webhooks']"));
+  r = w.run();
+  assert.equal(r.status, 0, r.stdout + r.stderr);
+});
+
+test('L42-5 a worker list kept by hand drifts and fails; a listed prefix the server no longer routes fails too', async (t) => {
+  const w = await world(t);
+  w.write('web/src/app/navigation-denylist.mjs', 'export const NAVIGATION_DENYLIST = [/^\\/api(?:\\/|$)/u];\n');
+  let r = w.run();
+  assert.equal(r.status, 1);
+  assert.match(r.stdout, /not ok \d+ - the worker's navigation denylist is the server's list, entry for entry/u);
+  assert.match(r.stdout, /\+   missing: \[\n\s*\+     '\/healthz',\n\s*\+     '\/readyz'/u);
+  const fresh = await world(t);
+  fresh.write('routes.json', JSON.stringify(ROUTES.filter((p) => p !== '/readyz')));
+  r = fresh.run();
+  assert.equal(r.status, 1);
+  assert.match(r.stdout, /\+   missing: \[\n\s*\+     '\/readyz'/u);
+});
