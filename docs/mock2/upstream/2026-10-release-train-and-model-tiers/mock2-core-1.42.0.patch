+#!/usr/bin/env node
+/*
+ * The worktree's harness port (PRO current §M.5): read from the environment or the worktree's own untracked
+ * file, never discovered and never defaulted.
+ *
+ *   node .mock2/bin/port.mjs                 prints the port
+ *   node .mock2/bin/port.mjs --write <port>  records the port reserved for this worktree, then prints it
+ *
+ * The environment variable HARNESS_PORT wins; otherwise the file .mock2/.local/harness-port at the top of this
+ * worktree (the template's .gitignore ignores /.mock2/.local/, so each worktree keeps its own). A battery passes
+ * the port into its clone through battery.envFile (HARNESS_PORT=<port>), where the clone has no file.
+ *
+ * Fails closed. With neither it prints "no reserved port" and exits 1: there is no default port, because a
+ * harness that falls back to a shared default takes another worktree's port. A value that is not a whole number
+ * from 1024 to 65535, a port file that is a link or not a regular file, and a port file Git tracks (it would be
+ * the same in every worktree) are refused with exit 2. --write takes the port the coordinating agent reserved
+ * (it reserves nothing itself) and refuses, writing nothing, when the file would not be ignored by Git, when
+ * another worktree of this repository already records the same port, or when the target is a link. It never
+ * checks whether the port is free right now: the harness starts its server with a strict port, so a busy port
+ * fails there instead of moving.
+ *
+ * Exit status: 0 the port was printed (and written); 1 no reserved port; 2 refused or a usage error.
+ */
+import { spawnSync } from 'node:child_process';
+import { closeSync, existsSync, fsyncSync, lstatSync, mkdirSync, openSync, readFileSync, renameSync, rmSync, writeSync, constants } from 'node:fs';
+import { join, resolve } from 'node:path';
+import { randomUUID } from 'node:crypto';
+import { isMain } from './tool-support.mjs';
+
+export const PORT_ENV = 'HARNESS_PORT';
+export const PORT_FILE = '.mock2/.local/harness-port';
+
+export class PortError extends Error { constructor(message, status) { super(message); this.status = status; } }
+
+const git = (cwd, args) => {
+  const r = spawnSync('git', ['--no-optional-locks', ...args], { cwd, encoding: 'utf8', windowsHide: true });
+  return r.status === 0 ? r.stdout : null;
+};
+
+export function parsePort(value, from) {
+  const text = String(value).trim();
+  const port = /^\d{1,5}$/.test(text) ? Number(text) : NaN;
+  if (!Number.isInteger(port) || port < 1024 || port > 65535) throw new PortError(`${from} is not a port from 1024 to 65535: ${JSON.stringify(text.slice(0, 40))}`, 2);
+  return port;
+}
+
+export function worktreeRoot(cwd = process.cwd()) {
+  const top = git(cwd, ['rev-parse', '--show-toplevel']);
+  return top ? resolve(top.trim()) : resolve(cwd);
+}
+
+function readPortFile(path) {
+  const st = lstatSync(path);
+  if (st.isSymbolicLink() || !st.isFile()) throw new PortError(`${PORT_FILE} is not a regular file`, 2);
+  return parsePort(readFileSync(path, 'utf8'), PORT_FILE);
+}
+
+/* The port and where it came from: { port, source: 'env' | 'file' }. Throws PortError. */
+export function readPort({ cwd = process.cwd(), env = process.env } = {}) {
+  if (env[PORT_ENV] != null && env[PORT_ENV] !== '') return { port: parsePort(env[PORT_ENV], PORT_ENV), source: 'env' };
+  const root = worktreeRoot(cwd);
+  const path = join(root, ...PORT_FILE.split('/'));
+  if (!existsSync(path) && !(() => { try { return lstatSync(path).isSymbolicLink(); } catch { return false; } })()) {
+    throw new PortError(`no reserved port: set ${PORT_ENV} or run node .mock2/bin/port.mjs --write <port> with the port reserved for this worktree (PRO current §M.5)`, 1);
+  }
+  if (git(root, ['ls-files', '--error-unmatch', '--', PORT_FILE]) != null) throw new PortError(`${PORT_FILE} is tracked by Git, so every worktree would share it; remove it from the index (git rm --cached ${PORT_FILE})`, 2);
+  return { port: readPortFile(path), source: 'file' };
+}
+
+/* Every other worktree of this repository that records a port in its own file. */
+function otherWorktreePorts(root) {
+  const listed = git(root, ['worktree', 'list', '--porcelain']);
+  if (listed == null) return [];
+  const paths = listed.split('\n').filter((l) => l.startsWith('worktree ')).map((l) => resolve(l.slice(9)));
+  const found = [];
+  for (const tree of paths) {
+    if (tree === root) continue;
+    try { found.push({ tree, port: readPortFile(join(tree, ...PORT_FILE.split('/'))) }); } catch { /* none, or not readable: not a reservation */ }
+  }
+  return found;
+}
+
+export function writePort({ cwd = process.cwd(), value } = {}) {
+  const port = parsePort(value, '--write');
+  const root = worktreeRoot(cwd);
+  const dir = join(root, '.mock2', '.local');
+  const path = join(dir, 'harness-port');
+  for (const p of [join(root, '.mock2'), dir]) {
+    try { const st = lstatSync(p); if (st.isSymbolicLink() || !st.isDirectory()) throw new PortError(`${p} is not a real directory`, 2); } catch (error) { if (error instanceof PortError) throw error; }
+  }
+  try { if (lstatSync(path).isSymbolicLink() || !lstatSync(path).isFile()) throw new PortError(`${PORT_FILE} is not a regular file`, 2); } catch (error) { if (error instanceof PortError) throw error; }
+  const inGit = git(root, ['rev-parse', '--is-inside-work-tree']) != null;
+  if (inGit) {
+    if (git(root, ['ls-files', '--error-unmatch', '--', PORT_FILE]) != null) throw new PortError(`${PORT_FILE} is tracked by Git, so every worktree would share it; remove it from the index (git rm --cached ${PORT_FILE})`, 2);
+    if (git(root, ['check-ignore', '-q', '--no-index', '--', PORT_FILE]) == null) throw new PortError(`${PORT_FILE} is not ignored by Git; add /.mock2/.local/ to .gitignore (the release template's .gitignore has it)`, 2);
+    const taken = otherWorktreePorts(root).find((o) => o.port === port);
+    if (taken) throw new PortError(`port ${port} is already recorded by the worktree ${taken.tree}; reserve another`, 2);
+  }
+  mkdirSync(dir, { recursive: true, mode: 0o700 });
+  const temporary = join(dir, `.harness-port-${randomUUID()}.tmp`);
+  const fd = openSync(temporary, constants.O_WRONLY | constants.O_CREAT | constants.O_EXCL | (constants.O_NOFOLLOW || 0), 0o644);
+  try { writeSync(fd, `${port}\n`); fsyncSync(fd); } finally { closeSync(fd); }
+  try { renameSync(temporary, path); } catch (error) { rmSync(temporary, { force: true }); throw error; }
+  return { port, path };
+}
+
+export function runPortCli(argv = process.argv.slice(2), { cwd = process.cwd(), env = process.env, out = console.log, err = console.error } = {}) {
+  try {
+    if (argv.length === 1 && (argv[0] === '--help' || argv[0] === '-h')) { out('usage: node .mock2/bin/port.mjs [--write <port>]'); return 0; }
+    if (argv[0] === '--write') {
+      if (argv.length !== 2) throw new PortError('usage: node .mock2/bin/port.mjs --write <port>', 2);
+      const { port } = writePort({ cwd, value: argv[1] });
+      if (env[PORT_ENV] != null && env[PORT_ENV] !== '' && String(env[PORT_ENV]).trim() !== String(port)) err(`note: ${PORT_ENV}=${env[PORT_ENV]} in this environment overrides the file`);
+      out(String(port));
+      return 0;
+    }
+    if (argv.length) throw new PortError('usage: node .mock2/bin/port.mjs [--write <port>]', 2);
+    out(String(readPort({ cwd, env }).port));
+    return 0;
+  } catch (error) {
+    if (!(error instanceof PortError)) { err(`port.mjs: ${error.message}`); return 2; }
+    err(error.message);
+    return error.status;
+  }
+}
+
+if (isMain(import.meta.url)) process.exitCode = runPortCli();
