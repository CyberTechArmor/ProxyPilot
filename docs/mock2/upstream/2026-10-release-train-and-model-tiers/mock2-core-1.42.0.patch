+function fixture(t) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-early-stop-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  mkdirSync(join(root, '.mock2/bin'), { recursive: true });
+  for (const file of ['check.mjs', 'check-support.mjs']) copyFileSync(join(bin, file), join(root, '.mock2/bin', file));
+  writeFileSync(join(root, '.gitignore'), '.mock2/cache/\n.mock2/evidence/\n.budget/\n.home/\n');
+  writeFileSync(join(root, 'source.txt'), 'candidate\n');
+  // A slow heavy check; the first one edits a tracked file while it runs, as a records edit in the worktree would.
+  writeFileSync(join(root, 'slow.cjs'), "setTimeout(() => { if (process.argv[2] === 'edit') require('fs').writeFileSync('source.txt', 'edited during the run\\n'); }, 300); setTimeout(() => process.exit(0), 1500)");
+  writeFileSync(join(root, '.mock2/checks.json'), JSON.stringify({ scheduler: { maxParallel: 1, sharedSlots: 2, budgetDir: '.budget' }, checks: [
+    { id: 'first', run: 'node slow.cjs edit' },
+    { id: 'second', run: 'node slow.cjs' },
+    { id: 'cheap', run: 'node -e "0"', resource: 'none', dependsOn: ['first'] },
+  ] }));
+  for (const args of [['init', '-q'], ['add', '.'], ['-c', 'user.name=t', '-c', 'user.email=t@example.invalid', 'commit', '-qm', 'fixture']]) assert.equal(spawnSync('git', args, { cwd: root }).status, 0);
+  const run = (args = []) => {
+    spawnSync('git', ['checkout', '--', 'source.txt'], { cwd: root });
+    const env = { ...process.env, HOME: join(root, '.home') };
+    delete env.MOCK2_BUDGET_DIR; delete env.MOCK2_SHARED_SLOTS;
+    const result = spawnSync(process.execPath, ['.mock2/bin/check.mjs', '--json', ...args], { cwd: root, env, encoding: 'utf8', timeout: 30000 });
+    return { ...result, report: JSON.parse(result.stdout), byId: Object.fromEntries(JSON.parse(result.stdout).results.map((r) => [r.id, r])) };
+  };
+  return { root, run };
+}
+
+test('L42-3 a tracked file changed during the first heavy check: the second is not run and the path is named; cheap checks finish', (t) => {
+  const f = fixture(t);
+  const { status, report, byId } = f.run();
+  assert.equal(status, 1);
+  assert.equal(byId.first.execution, 'executed');
+  assert.equal(byId.second.execution, 'not-run');
+  assert.equal(byId.second.status, 'blocked');
+  assert.match(byId.second.reason, /^not started: candidate changed at \d{4}-\d\d-\d\dT[\d:.]+Z: source\.txt$/);
+  assert.equal(report.earlyStopped.path, 'source.txt');
+  assert.equal(report.earlyStopped.after, 'first');
+  // The check that saw the change is marked as the end-of-run comparison marks it.
+  assert.equal(byId.first.status, 'blocked');
+  assert.match(byId.first.reason, /candidate changed during verification/);
+  assert.equal(byId.cheap.execution, 'executed', 'a resource:none check still finishes');
+  assert.ok(report.elapsedMs < 2900, `about one check, not two: ${report.elapsedMs} ms`);
+  assert.equal(report.totals.candidateRechecks, 1);
+  assert.ok(Number.isFinite(report.totals.candidateRecheckMs));
+});
+
+test('L42-3 --no-early-stop keeps the single comparison at the end', (t) => {
+  const f = fixture(t);
+  const { status, report, byId } = f.run(['--no-early-stop']);
+  assert.equal(status, 1);
+  assert.equal(byId.second.execution, 'executed');
+  assert.equal(byId.second.status, 'blocked');
+  assert.match(byId.second.reason, /candidate changed during verification/);
+  assert.equal(report.earlyStopped, undefined);
+  assert.equal(report.configuration.earlyStop, false);
+  assert.equal(report.totals.candidateRechecks, 0);
+});
+
+test('L42-3 an unchanged candidate runs every heavy check, and the recheck is skipped when no heavy check waits', (t) => {
+  const f = fixture(t);
+  writeFileSync(join(f.root, 'slow.cjs'), 'setTimeout(() => process.exit(0), 50)');
+  spawnSync('git', ['-c', 'user.name=t', '-c', 'user.email=t@example.invalid', 'commit', '-qam', 'fast'], { cwd: f.root });
+  const { status, report } = f.run();
+  assert.equal(status, 0, JSON.stringify(report.results));
+  assert.equal(report.totals.candidateRechecks, 1, 'after first (second waits); not after second (nothing waits)');
+});
+
+test('L42-3 a recheck that cannot identify the candidate stops nothing and says so', { skip: process.platform === 'win32' }, (t) => {
+  const f = fixture(t);
+  // The first check hides the repository; the second puts it back before the end-of-run comparison.
+  writeFileSync(join(f.root, 'hide.cjs'), "require('fs').renameSync('.git', '.git-away'); setTimeout(() => process.exit(0), 300)");
+  writeFileSync(join(f.root, 'restore.cjs'), "require('fs').renameSync('.git-away', '.git')");
+  writeFileSync(join(f.root, '.mock2/checks.json'), JSON.stringify({ scheduler: { maxParallel: 1, sharedSlots: 2, budgetDir: '.budget' }, checks: [
+    { id: 'first', run: 'node hide.cjs' }, { id: 'second', run: 'node restore.cjs' }] }));
+  const { report, byId } = f.run();
+  assert.equal(byId.second.execution, 'executed');
+  assert.equal(report.earlyStopped, undefined);
+  assert.ok(report.warnings.some((w) => /candidate recheck after first could not run/.test(w)), JSON.stringify(report.warnings));
+});
