+        const ifNotExists = isWord(tokens[k], 'IF');
+        if (ifNotExists) k += 3;
+        if (includesWords(tokens, 'PARTITION', 'OF')) { no('table created as a partition', 'CREATE TABLE … PARTITION OF takes an ACCESS EXCLUSIVE lock on the parent: not a lock-friendly form'); continue; }
+        if (!ifNotExists) context.created.add(qualified(tokens, k).name);
+        ok('table created'); continue;
+      }
+      if (isWord(tokens[k], 'UNIQUE')) k++;
+      if (isWord(tokens[k], 'INDEX')) {
+        const concurrently = isWord(tokens[k + 1], 'CONCURRENTLY');
+        const on = tokens.findIndex((t) => isWord(t, 'ON'));
+        let target = on + 1; if (isWord(tokens[target], 'ONLY')) target++;
+        const table = qualified(tokens, target).name;
+        if (concurrently) ok('index built concurrently');
+        else if (context.created.has(table)) ok('index on a table this migration creates');
+        else no('index built under a write lock', `CREATE INDEX on existing table ${table} blocks its writes for the whole build: use CREATE INDEX CONCURRENTLY (outside a transaction)`);
+        continue;
+      }
+      if (isWord(tokens[k], 'DOMAIN') && includesWords(tokens, 'DEFAULT')) { no('domain with a default', 'a column of this domain added to an existing table evaluates the default for every row; a volatile one rewrites the table. Create the domain without a default'); continue; }
+      if (isWord(tokens[k], 'EXTENSION', 'TYPE', 'SCHEMA', 'SEQUENCE', 'VIEW', 'FUNCTION', 'PROCEDURE', 'DOMAIN', 'TRIGGER')) { ok(`${tokens[k].value.toLowerCase()} created`); continue; }
+      no(`CREATE ${tokens[k]?.value ?? ''}`.trim(), 'not a recognised lock-friendly form'); continue;
+    }
+    if (isWord(t0, 'COMMENT') && isWord(t1, 'ON')) { ok('comment'); continue; }
+    if (isWord(t0, 'ALTER') && isWord(t1, 'TYPE') && includesWords(tokens, 'ADD', 'VALUE')) { ok('enum value added'); continue; }
+    if (isWord(t0, 'ALTER') && isWord(t1, 'TABLE')) {
+      let k = 2; if (isWord(tokens[k], 'IF')) k += 2; if (isWord(tokens[k], 'ONLY')) k++;
+      const { next } = qualified(tokens, k);
+      context.constraint = null;
+      for (const action of actions(tokens.slice(next))) { const r = alterAction(action, context); results.push({ ...r, statement: text }); }
+      continue;
+    }
+    if (isWord(t0, 'DROP')) {
+      const what = (t1?.value ?? '').toLowerCase();
+      if (isWord(t1, 'INDEX') && !isWord(tokens[2], 'CONCURRENTLY')) { no('index dropped under a lock', 'DROP INDEX blocks the table: use DROP INDEX CONCURRENTLY, in a contraction'); continue; }
+      destructiveClass ? ok(`${what} dropped (${classification})`) : no(`DROP ${t1?.value ?? ''}`.trim(), `a drop belongs in a migration classified contraction or destructive, with its approval in the manifest (it is ${classification})`);
+      continue;
+    }
+    if (isWord(t0, 'TRUNCATE')) { destructiveClass ? ok(`truncate (${classification})`) : no('TRUNCATE', `removes every row: only in a migration classified destructive, approved (it is ${classification})`); continue; }
+    if (isWord(t0, 'INSERT', 'UPDATE', 'DELETE', 'WITH')) { classification === 'transition' || (destructiveClass && isWord(t0, 'DELETE')) ? ok(`data change (${classification})`) : no('data change', `a data change belongs in a migration classified transition (it is ${classification})`); continue; }
+    no(t0?.value ?? 'statement', 'not a recognised lock-friendly form');
+  }
+  return results;
+}
+
+export const sha256 = (text) => createHash('sha256').update(text).digest('hex');
+const placeholder = (value) => !value || /^(?:-|none|todo|tbd)$/iu.test(value) || /<[^>]*>/u.test(value);
+
+/* Parses the manifest text: { entries, problems }. */
+export function parseManifest(text) {
+  const entries = [], problems = [];
+  text.split(/\r?\n/u).forEach((line, index) => {
+    if (!line.trim() || line.trimStart().startsWith('#')) return;
+    const fields = line.split('|').map((f) => f.trim());
+    const at = `manifest line ${index + 1}`;
+    if (fields.length !== 5) { problems.push({ file: null, reason: `${at}: expected 5 fields (${MANIFEST_FORMAT})` }); return; }
+    const [file, hash, classification, approval, locks] = fields;
+    if (!/^sha256:[0-9a-f]{64}$/u.test(hash)) problems.push({ file, reason: `${at}: the hash must be sha256:<64 lowercase hex>` });
+    if (!CLASSIFICATIONS.includes(classification)) problems.push({ file, reason: `${at}: classification must be one of ${CLASSIFICATIONS.join(', ')}` });
+    if (placeholder(approval)) problems.push({ file, reason: `${at}: no approval reference (an unapproved entry is refused)` });
+    if (placeholder(locks)) problems.push({ file, reason: `${at}: no lock footprint (§N.1)` });
+    entries.push({ file, sha256: hash.replace(/^sha256:/u, ''), classification, approval, locks, line });
+  });
+  return { entries, problems };
+}
+
+/* The whole guard: every migration file has an unchanged, approved entry and only allowed statements; a
+ * released entry (a line of the previous manifest) is never edited or removed. files: { name: content }. */
+export function checkMigrations({ manifest, files, previousManifest = null }) {
+  const { entries, problems } = parseManifest(manifest);
+  const byFile = new Map(entries.map((e) => [e.file, e]));
+  for (const [file, content] of Object.entries(files)) {
+    const entry = byFile.get(file);
+    if (!entry) { problems.push({ file, reason: 'no manifest entry' }); continue; }
+    if (sha256(content) !== entry.sha256) { problems.push({ file, reason: `changed since its manifest entry (sha256 ${sha256(content).slice(0, 12)}…, recorded ${entry.sha256.slice(0, 12)}…): a recorded migration is never edited; add a new one` }); continue; }
+    for (const r of guardStatements(content, entry.classification)) if (!r.allowed) problems.push({ file, statement: r.statement, reason: `${r.form}: ${r.reason}` });
+  }
+  for (const e of entries) if (!(e.file in files)) problems.push({ file: e.file, reason: 'listed in the manifest but missing' });
+  if (previousManifest != null) {
+    const before = previousManifest.split(/\r?\n/u).filter((l) => l.trim() && !l.trimStart().startsWith('#'));
+    const now = manifest.split(/\r?\n/u).filter((l) => l.trim() && !l.trimStart().startsWith('#'));
+    before.forEach((line, i) => { if (now[i] !== line) problems.push({ file: line.split('|')[0].trim(), reason: 'a released manifest entry was edited, removed or reordered: the manifest is append-only' }); });
+  }
+  return { ok: problems.length === 0, problems };
+}
