@@ -0,0 +1,52 @@
+/*
+ * The server's list of non-app path prefixes: paths the server answers itself (the API, health and readiness,
+ * files), never with the application's page. ONE list, read by both sides (PRO current §E):
+ *   - the server: its app-shell fallback serves the page only for a path not on this list (isNonAppPath);
+ *   - the service worker: its navigation denylist is generated from this list (navigationDenylist), so a
+ *     cached worker never answers a direct link to one of these paths with the cached page.
+ * A new route a browser opens directly goes on this list; the drift test (tests/non-app-paths.test.mjs) fails
+ * on any difference between this list, the worker's denylist and the server's routes until it does.
+ * Generated by gen.mjs non-app-paths; project-owned from now on. The entries below are the application
+ * foundation's; keep them to what the server actually routes.
+ */
+export const NON_APP_PATH_PREFIXES = Object.freeze(['/api', '/healthz', '/readyz']);
+
+/* Paths the server answers with the application's page (its client-side routes). */
+export const APP_SHELL_PATHS = Object.freeze(['/', '/app', '/setup', '/login', '/admin']);
+
+const escape = (text) => text.replace(/[.*+?^${}()|[\]\\/]/gu, '\\$&');
+
+/* True when the path is a listed prefix or below one (segment boundary: /api and /api/x, not /apiary). */
+export function isNonAppPath(pathname, prefixes = NON_APP_PATH_PREFIXES) {
+  return prefixes.some((prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`));
+}
+
+/* The service worker's navigation denylist, generated from the list. */
+export function navigationDenylist(prefixes = NON_APP_PATH_PREFIXES) {
+  return prefixes.map((prefix) => new RegExp(`^${escape(prefix)}(?:/|$)`, 'u'));
+}
+
+/* The prefixes a denylist stands for (the inverse of navigationDenylist, for the drift test). */
+export function denylistPrefixes(denylist) {
+  return denylist.map((re) => {
+    const m = /^\^(.*)\(\?:\\\/\|\$\)$/u.exec(re.source);
+    return m ? m[1].replace(/\\(.)/gu, '$1') : `unrecognised pattern ${re.source}`;
+  });
+}
+
+/* The top-level prefixes of server route paths that are not the application's page. */
+export function serverNonAppPrefixes(routePaths, appShellPaths = APP_SHELL_PATHS) {
+  const out = new Set();
+  for (const path of routePaths) {
+    if (typeof path !== 'string' || appShellPaths.includes(path)) continue;
+    const first = path.split('/')[1];
+    if (first && !/^[*:(]/u.test(first)) out.add(`/${first}`);
+  }
+  return [...out].sort();
+}
+
+/* Every difference between two prefix lists: what each has that the other lacks. */
+export function prefixDrift(expected, actual) {
+  const a = new Set(expected), b = new Set(actual);
+  return { missing: [...a].filter((p) => !b.has(p)).sort(), extra: [...b].filter((p) => !a.has(p)).sort() };
+}
