+    const now = new Date().toISOString();
+    const at = record.entries.findIndex((e) => e.branch === branch);
+    if (at !== -1) {
+      const entry = record.entries[at];
+      entry.history = [...(entry.history ?? []), { commit: entry.commit, battery: entry.battery, passedAt: entry.passedAt }].slice(-20);
+      const parent = nearestParent(git, record.entries, sha, at);
+      Object.assign(entry, { commit: sha, battery, passedAt: now, cache, parent: parent?.branch ?? null,
+        base: base ? git.commit(base) : parent ? parent.commit : git.run(['merge-base', sha, mainRef(git, main).commit]) });
+      if (ids.length) entry.reserved = ids;
+      delete entry.restack; delete entry.repinned; delete entry.revalidate;
+      return { value: { action: 'replaced', entry, place: at + 1, warnings } };
+    }
+    const tipEntry = record.entries.at(-1);
+    const mainTip = mainRef(git, main);
+    const tip = tipEntry ? tipEntry.commit : mainTip.commit;
