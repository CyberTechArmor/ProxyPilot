+// The runner alone, in the repository: validator and slow-file escalation.
+function runner(t, checks) {
+  const root = mkdtempSync(join(tmpdir(), 'mock2-runner-reuse-'));
+  t.after(() => rmSync(root, { recursive: true, force: true }));
+  mkdirSync(join(root, '.mock2/bin'), { recursive: true });
+  for (const file of ['check.mjs', 'check-support.mjs']) copyFileSync(join(bin, file), join(root, '.mock2/bin', file));
+  for (const [name, text] of Object.entries(SCRIPTS)) writeFileSync(join(root, name), text);
+  for (const [dir, file] of [['web', 'page.txt'], ['e2e', 'spec.txt']]) { mkdirSync(join(root, dir)); writeFileSync(join(root, dir, file), 'x\n'); }
+  writeFileSync(join(root, '.gitignore'), '.mock2/cache/\n.mock2/evidence/\n.budget/\n.home/\ndist/\n');
+  git(root, 'init', '-q');
+  git(root, 'add', '.');
+  git(root, 'commit', '-q', '-m', 'base');
+  const configure = (value) => writeFileSync(join(root, '.mock2/checks.json'), JSON.stringify({ scheduler: { maxParallel: 1, sharedSlots: 2, budgetDir: '.budget' }, checks: value }));
+  configure(checks);
+  const run = (args = [], extra = {}) => {
+    const env = { ...process.env, HOME: join(root, '.home'), ...extra };
+    delete env.MOCK2_BUDGET_DIR; delete env.MOCK2_SHARED_SLOTS;
+    const result = spawnSync(process.execPath, ['.mock2/bin/check.mjs', '--json', ...args], { cwd: root, env, encoding: 'utf8', timeout: 30000 });
+    return { ...result, report: result.stdout ? JSON.parse(result.stdout) : null };
+  };
+  return { root, run, configure };
+}
+
+test('L42-1 the validator refuses identity with reuse, and buildInputs without a build that declares an identity', (t) => {
+  const r = runner(t, [{ ...CHECKS[1], reuse: CHECKS[2].reuse }]);
+  let result = r.run();
+  assert.equal(result.status, 2);
+  assert.match(result.stderr, /identity and reuse cannot both be set/);
+  r.configure([{ id: 'build', run: 'node build.cjs' }, CHECKS[2]]);
+  result = r.run();
+  assert.equal(result.status, 2);
+  assert.match(result.stderr, /buildInputs needs a dependsOn check that declares an identity/);
+  r.configure([{ ...CHECKS[1], identity: { inputs: ['web'] } }]);
+  assert.match(r.run().stderr, /identity requires explicit inputs, tools and env arrays/);
+  // In a worktree: the build always runs before an executing consumer; a cache hit then skips it.
+  r.configure([CHECKS[1], CHECKS[2]]);
+  const first = r.run();
+  assert.equal(first.status, 0, first.stdout + first.stderr);
+  assert.deepEqual(first.report.results.map((x) => x.execution), ['executed', 'executed']);
+  const again = r.run([], { MOCK2_RUN_ID: 'another-run', MOCK2_HOLD_TOKEN: 'another-hold' });
+  assert.deepEqual(again.report.results.map((x) => [x.status, x.execution]), [['not-applicable', 'not-run'], ['pass', 'reused']]);
+  assert.equal(again.status, 0);
+  assert.equal(again.report.verdict, 'pass');
+  // --no-reuse: everything executes, the build first.
+  assert.deepEqual(r.run(['--no-reuse']).report.results.map((x) => x.execution), ['executed', 'executed']);
+  // A dependant that does not declare buildInputs needs the artifact: the build runs.
+  r.configure([CHECKS[1], CHECKS[2], { id: 'size', run: 'node -e "require(\'fs\').readFileSync(\'dist/bundle.txt\')"', dependsOn: ['build'] }]);
+  rmSync(join(r.root, 'dist'), { recursive: true, force: true });
+  const mixed = r.run();
+  assert.equal(mixed.status, 0, mixed.stdout + mixed.stderr);
+  assert.equal(mixed.report.results[0].execution, 'executed');
+  assert.equal(mixed.report.results[2].status, 'pass');
+});
+
+const printing = (text, code = 0) => `node -e "process.stdout.write(${JSON.stringify(text).replace(/"/g, '\\"')}); process.exit(${code})"`;
+
+test('L42-1 a file that is the slowest and over half its check in three runs running is named for repair', (t) => {
+  const r = runner(t, [{ id: 'unit', run: printing(' ✓ src/visual.test.ts (32 tests) 45000ms\n ✓ src/b.test.ts (3 tests) 500ms\n      Tests  35 passed (35)\n') }]);
+  const named = (report) => report.warnings.filter((w) => /named for repair/.test(w));
+  assert.deepEqual(named(r.run().report), []);
+  assert.ok(r.run().report.warnings.some((w) => /the slowest test file, src\/visual\.test\.ts/.test(w)));
+  const third = r.run().report;
+  assert.equal(named(third).length, 1, JSON.stringify(third.warnings));
+  assert.match(named(third)[0], /^unit: named for repair: `src\/visual\.test\.ts` — 45s of \d+s in three runs running/);
+  assert.ok(!third.warnings.some((w) => /the slowest test file/.test(w)), 'the escalated line replaces the plain warning');
