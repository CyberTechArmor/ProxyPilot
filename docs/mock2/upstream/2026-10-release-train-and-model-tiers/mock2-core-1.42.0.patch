+}
+
+/* Runs change(record) under the record's lock and writes the result atomically when change returns true. */
+export async function mutate(common, change) {
+  const release = await acquireSlot({ budgetDir: join(common, 'mock2', 'queue-lock'), sharedSlots: 1, queueTimeoutMs: 30000 }, () => false);
+  try {
+    const record = readRecord(common);
+    const result = await change(record);
+    if (result?.write !== false) { record.updatedAt = new Date().toISOString(); atomicJson(recordPath(common), record); }
