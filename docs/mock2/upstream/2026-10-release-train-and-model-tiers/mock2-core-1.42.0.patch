+  r.configure([codegen, build, browser]);
+  assert.equal(r.run().status, 0);
+  // The prerequisite (no consumer of its own is cached) still runs; the build is skipped, the browser check reused.
+  assert.deepEqual(r.run().report.results.map((x) => [x.id, x.status, x.execution]), [['codegen', 'pass', 'executed'], ['build', 'not-applicable', 'not-run'], ['browser', 'pass', 'reused']]);
+  // A change only the prerequisite's identity covers changes the build's identity, so the browser check runs.
+  writeFileSync(join(r.root, 'e2e/spec.txt'), 'generated input changed\n');
