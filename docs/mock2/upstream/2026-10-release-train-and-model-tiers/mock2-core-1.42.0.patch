+import test, { before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync, appendFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { parsePrompt } from '../templates/repo/.mock2/bin/gates.mjs';
+import { findPlaceholder } from '../templates/repo/.mock2/bin/tool-support.mjs';
+
+// The release-prompt template and generator (1.42.0). A release of a recurring shape is written by filling
+// `.mock2/templates/release-prompt.md` with `gen.mjs release-prompt --shape <image|push|records>` (L42-7, PRO
+// current §P.6): the identity comes from the release queue's record and the pin, never from an earlier prompt;
+// markers are commands that derive them from the image built at the pin; the filled prompt holds no placeholder,
+// every gate parses under gates.mjs and step 0 dry-runs in a scratch clone. The template carries the
+// promoted-during-the-release branch (L42-10, §P.8), the release record's environment-mode field (L42-4), the
+// real-path smoke step (L42-6), the rollback-slot decision-or-question step (L42-18) and step 0's list of other
+// sessions' record edits (L42-13).
