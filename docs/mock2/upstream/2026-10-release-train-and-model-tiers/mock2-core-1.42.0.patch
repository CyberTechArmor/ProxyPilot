+// The release train (1.42.0), as text. Each item is a Rule, a Template or Guidance an agent follows; the tools it names
+// (gates.mjs, records.mjs, queue.mjs, port.mjs, doctor.mjs --brief, battery seeding, the runner's early stop) are
+// tested by their own files. This file checks the canonical text: PRO current §E, §F, §K.3, §K.6, §M.4, §M.5, §M.10,
+// §M.11, §N.1, §N.5, §N.7, §N.8, §N.11, §P.1–§P.6 and §P.8, the constitution's §1 and §11, the verification, PRO,
+// security and checklist rules, capacity §10, §13 and §16, the handoff and decisions templates and the entry block.
+// None of it is a gate.
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const read = (path) => readFileSync(join(site, path), 'utf8');
+const flat = (text) => text.replace(/\s+/gu, ' ');
+const tpl = 'core/mock2/templates/repo/';
+// Gate wording none of this text carries (rule 0), as sizing.test.mjs and background-agents.test.mjs check it.
+const GATE = /wait (?:for|until)|go-ahead|approv|before proceeding|confirm (?:first|before)/iu;
+
+function section(name, text, start, end) {
+  const at = text.indexOf(start);
+  assert.notEqual(at, -1, `${name}: no ${JSON.stringify(start.trim())}`);
+  const rest = text.slice(at + start.length);
+  const stop = typeof end === 'string' ? rest.indexOf(end) : rest.search(end);
+  return text.slice(at, stop === -1 ? text.length : at + start.length + stop);
+}
+function includesAll(name, text, phrases) {
+  const missing = phrases.filter((phrase) => !flat(text).includes(phrase));
+  assert.deepEqual(missing, [], `${name} lacks these phrases`);
+}
+function noGate(name, text) {
+  const match = GATE.exec(flat(text));
+  assert.equal(match, null, `${name} carries gate wording: ${match && match[0]}`);
+}
+const pro = () => read('core/cpr/CPR-v1.1-current.md');
