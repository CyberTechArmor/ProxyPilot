+});
+
+test('L42-1 a check further down that reads the artifact forces the build: build → browser (buildInputs) → smoke', (t) => {
+  const smokeRun = 'node -e "require(\'fs\').readFileSync(\'dist/bundle.txt\')"';
+  const r = runner(t, [CHECKS[1], CHECKS[2], { id: 'smoke', run: smokeRun, dependsOn: ['browser'] }]);
+  const fresh = () => rmSync(join(r.root, 'dist'), { recursive: true, force: true });
+  assert.equal(r.run().status, 0);
+  fresh();
+  // smoke executes (no reuse), so it needs the artifact: the build executes although browser is a hit.
+  let result = r.run();
+  assert.equal(result.status, 0, result.stdout + result.stderr);
+  assert.deepEqual(result.report.results.map((x) => [x.id, x.execution]), [['build', 'executed'], ['browser', 'reused'], ['smoke', 'executed']]);
+  // smoke opts into reuse too: once every transitive dependant is a hit, no one needs the artifact.
+  const smokeReuse = { deterministic: true, outputFree: true, inputs: ['e2e'], tools, env: [] };
+  r.configure([CHECKS[1], CHECKS[2], { id: 'smoke', run: smokeRun, dependsOn: ['browser'], reuse: smokeReuse }]);
+  assert.equal(r.run().status, 0);
+  fresh();
+  result = r.run();
+  assert.equal(result.status, 0, result.stdout + result.stderr);
+  assert.deepEqual(result.report.results.map((x) => [x.id, x.status]), [['build', 'not-applicable'], ['browser', 'pass'], ['smoke', 'pass']]);
