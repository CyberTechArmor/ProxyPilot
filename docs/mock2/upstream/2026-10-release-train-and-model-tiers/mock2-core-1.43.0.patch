+
+test('MT text: the routing rule, constitution, entry block and both prompts speak of role tier bindings, settings and scope (H13, H15–H18)', () => {
+  const files = {
+    'core/claude/rules/mock2-orchestration.md': ['mode, role tier bindings, settings and scope', '(`openai/economy`, never `economy`)', 'A model id is a registry edit through the host', 'an attempt keeps the route it started with', '(`observed`, `host-reported`, `configured`, `unavailable`, `inconsistent`)'],
