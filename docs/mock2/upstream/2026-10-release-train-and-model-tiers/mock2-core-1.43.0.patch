diff --git a/core/mock2/bin/generate-artifacts.py b/core/mock2/bin/generate-artifacts.py
index df49769297e6612cc74b33c051ecc79528bdcd43..e6c39d3797bc10cc6908376a57e2878055458af7 100644
--- a/core/mock2/bin/generate-artifacts.py
+++ b/core/mock2/bin/generate-artifacts.py
@@ -553,6 +553,14 @@ def generate(version):
     for name in sorted(os.listdir(cpr_src)):
         if name.endswith(".md"):
             copy_with_note(os.path.join(cpr_src, name), os.path.join(STD, name), f"core/cpr/{name}")
+    # The routing contract's JSON schemas and samples (1.43.0), copied byte for byte: the compatibility
+    # registry among the samples is what a project with no host registry routes through.
+    for sub in ("schemas", "samples"):
+        sub_src = os.path.join(cpr_src, sub)
+        if os.path.isdir(sub_src):
+            for name in sorted(os.listdir(sub_src)):
+                if name.endswith(".json"):
+                    copy_verbatim(os.path.join(sub_src, name), os.path.join(STD, sub, name))
 
     prof_src = os.path.join(CORE, "mock2", "profiles")
     if os.path.isdir(prof_src):
@@ -582,6 +590,9 @@ https://mock2.fractionate.ai — an SSH'd-into server, a fresh container, a lock
   provenance. **`CPR-v1.1-current.md` is the resolved baseline and wins where they disagree.**
 - `profile-cpr.md` — the PRO application profile: stack, layout, tokens, Host SDK conventions.
   It binds a repository that records `Profile: cpr`, and no other.
+- `Model-Routing.md` and `Work-Lifecycle.md` — the agent routing and work-lifecycle contracts, with
+  their JSON schemas in `schemas/` and non-normative samples in `samples/`. `samples/model-registry.legacy-1.40.json`
+  is the compatibility registry a project routes through when its host supplies no registry.
 
 Do not edit these files. `.mock2/bin/upgrade.mjs` replaces them when it can see they are
 unmodified, and reports them as conflicts when it cannot. Propose changes upstream.
