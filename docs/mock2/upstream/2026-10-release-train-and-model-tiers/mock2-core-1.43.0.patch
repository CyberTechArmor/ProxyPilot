+import type {WorkEvent} from './events.mjs';
+export interface LifecycleConfig {enabled:boolean;reason:string;warning?:boolean}
+export function lifecycleConfig(root:string,env?:Record<string,string|undefined>):LifecycleConfig;
+export function lifecycleEvent(workspaceId:string,taskId:string,type:string,data:Record<string,unknown>,context?:{runId?:string}):WorkEvent;
