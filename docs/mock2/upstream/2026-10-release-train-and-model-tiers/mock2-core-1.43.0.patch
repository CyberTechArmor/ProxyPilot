diff --git a/core/cpr/schemas/execution-record.v1.schema.json b/core/cpr/schemas/execution-record.v1.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..ea315990198d84079da67ebe36291f6c158e1186
--- /dev/null
+++ b/core/cpr/schemas/execution-record.v1.schema.json
@@ -0,0 +1,350 @@
+{
+  "$id": "https://mock2.fractionate.ai/standards/schemas/execution-record.v1.schema.json",
+  "$comment": "JSON Schema draft 2020-12. One record per model-call group within an attempt, or per call (granularity says which). Unknown values are null, never filled with the requested value. Provider metadata is attribution evidence, not cryptographic proof. See Model-Routing.md.",
+  "title": "Mock2 execution record v1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema",
+    "record_id",
+    "granularity",
+    "attempt_id",
+    "requested",
+    "registry_version",
+    "identity_evidence",
+    "observed_model",
+    "estimate",
+    "accounting_owner"
+  ],
+  "properties": {
+    "schema": {
+      "const": "mock2.execution/1"
+    },
+    "record_id": {
+      "type": "string",
+      "maxLength": 200
+    },
+    "granularity": {
+      "enum": [
+        "call-group",
+        "call"
+      ]
+    },
+    "work_item_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "plan_revision_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "job_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "attempt_id": {
+      "type": "string",
+      "maxLength": 128
+    },
+    "parent_task_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "child_task_ids": {
+      "type": "array"
+    },
+    "environment": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "actor": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "role": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "started_at": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "ended_at": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "event_ids": {
+      "type": "array"
+    },
+    "trace_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "requested": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "provider",
+        "tier",
+        "model"
+      ],
+      "properties": {
+        "provider": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "tier": {
+          "type": [
+            "string",
+            "null"
+          ],
+          "description": "qualified provider/tier, or null for an operator pin"
+        },
+        "model": {
+          "type": [
+            "string",
+            "null"
+          ]
+        }
+      }
+    },
+    "connection_ref": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "registry_version": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "policy_version": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "resolution_source": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "observed_model": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "identity_evidence": {
+      "enum": [
+        "observed",
+        "host-reported",
+        "configured",
+        "unavailable",
+        "inconsistent"
+      ]
+    },
+    "inconsistent_values": {
+      "type": "object",
+      "description": "present when identity_evidence is inconsistent: every value kept"
+    },
+    "requested_settings": {
+      "type": [
+        "object",
+        "null"
+      ]
+    },
+    "effective_settings": {
+      "type": [
+        "object",
+        "null"
+      ],
+      "description": "effort, processing or service tier, speed and output limit as reported; unknown stays null"
+    },
+    "provider_request_ids": {
+      "type": "array"
+    },
+    "provider_response_ids": {
+      "type": "array"
+    },
+    "input_tokens": {
+      "type": [
+        "integer",
+        "null"
+      ],
+      "minimum": 0,
+      "description": "uncached input tokens only: subtract cached reads when the provider counts them inside its input total; cache reads and writes go in their own fields"
+    },
+    "output_tokens": {
+      "type": [
+        "integer",
+        "null"
+      ],
+      "minimum": 0,
+      "description": "output tokens, including reasoning tokens"
+    },
+    "cache_read_tokens": {
+      "type": [
+        "integer",
+        "null"
+      ],
+      "minimum": 0
+    },
+    "cache_write_tokens": {
+      "type": [
+        "integer",
+        "null"
+      ],
+      "minimum": 0
+    },
+    "reasoning_tokens": {
+      "type": [
+        "integer",
+        "null"
+      ],
+      "minimum": 0
+    },
+    "chargeable_extras": {
+      "type": "array"
+    },
+    "estimate": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "amount",
+        "currency",
+        "pricing_source",
+        "pricing_effective_date",
+        "assumptions"
+      ],
+      "properties": {
+        "amount": {
+          "type": [
+            "number",
+            "null"
+          ],
+          "description": "null when pricing or an input or output token count is missing: unknown, never zero; full precision"
+        },
+        "currency": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "pricing_source": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "pricing_effective_date": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "assumptions": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          }
+        }
+      }
+    },
+    "billed": {
+      "type": [
+        "object",
+        "null"
+      ],
+      "additionalProperties": false,
+      "properties": {
+        "amount": {
+          "type": "number"
+        },
+        "currency": {
+          "type": "string"
+        },
+        "source": {
+          "type": "string"
+        },
+        "reconciled_at": {
+          "type": "string"
+        }
+      }
+    },
+    "accounting_owner": {
+      "type": "string",
+      "description": "record_id of the record that owns this cost; a view whose owner is another record is never counted twice"
+    },
+    "escalations": {
+      "type": "array"
+    },
+    "retries": {
+      "type": "array"
+    },
+    "fallbacks": {
+      "type": "array"
+    },
+    "review_finding_ids": {
+      "type": "array"
+    },
+    "candidate_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "authorization_ref": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "check_run_ids": {
+      "type": "array"
+    },
+    "deployment_record_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "recovery_record_id": {
+      "type": [
+        "string",
+        "null"
+      ]
+    },
+    "limitations": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      }
+    }
+  }
+}
diff --git a/core/cpr/schemas/model-registry.schema.json b/core/cpr/schemas/model-registry.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..326a31fd11369e6318f5163eced46fe1e6ccbbcf
--- /dev/null
+++ b/core/cpr/schemas/model-registry.schema.json
@@ -0,0 +1,448 @@
+{
+  "$id": "https://mock2.fractionate.ai/standards/schemas/model-registry.schema.json",
+  "$comment": "JSON Schema draft 2020-12. Mock2 model registry: host-owned and versioned; the only place concrete model ids live. Tiers are qualified by their provider (provider/tier) and bound by configuration, never by a family-to-tier rule. See Model-Routing.md.",
+  "title": "Mock2 model registry",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "registry_version",
+    "updated_at",
+    "providers"
+  ],
+  "properties": {
+    "$comment": {
+      "type": "string"
+    },
+    "non_normative": {
+      "type": "boolean",
+      "description": "true on samples and the compatibility registry"
+    },
+    "registry_version": {
+      "type": "string",
+      "maxLength": 64,
+      "description": "semantic version or date stamp; recorded on every execution"
+    },
+    "updated_at": {
+      "type": "string",
+      "maxLength": 64,
+      "description": "RFC 3339"
+    },
+    "default_provider": {
+      "type": "string",
+      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
+      "description": "provider for roles no settings layer names; absent means binding-missing, never a guessed provider"
+    },
+    "profiles": {
+      "type": "object",
+      "description": "named role-to-qualified-tier sets (the deprecated --profile alias and version-1 migration)",
+      "propertyNames": {
+        "type": "string",
+        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+      },
+      "additionalProperties": {
+        "type": "object",
+        "additionalProperties": false,
+        "properties": {
+          "coordinator": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "investigator": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "builder": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "reviewer": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "release-helper": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          }
+        }
+      }
+    },
+    "compatibility": {
+      "type": "object",
+      "description": "compatibility registry only: provenance, version-1 provider aliases (read only) and retired name-inference data"
+    },
+    "providers": {
+      "type": "object",
+      "propertyNames": {
+        "type": "string",
+        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+      },
+      "additionalProperties": {
+        "$ref": "#/$defs/provider"
+      }
+    }
+  },
+  "$defs": {
+    "provider": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "connections",
+        "tiers"
+      ],
+      "properties": {
+        "$comment": {
+          "type": "string"
+        },
+        "connections": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "id"
+            ],
+            "properties": {
+              "id": {
+                "type": "string",
+                "maxLength": 128
+              },
+              "endpoint_ref": {
+                "type": [
+                  "string",
+                  "null"
+                ],
+                "description": "opaque; never a secret"
+              },
+              "account_ref": {
+                "type": [
+                  "string",
+                  "null"
+                ],
+                "description": "opaque; never a secret"
+              }
+            }
+          }
+        },
+        "tiers": {
+          "type": "object",
+          "propertyNames": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "additionalProperties": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "connection",
+              "model",
+              "accepted_by",
+              "accepted_at"
+            ],
+            "properties": {
+              "$comment": {
+                "type": "string"
+              },
+              "connection": {
+                "type": "string"
+              },
+              "model": {
+                "type": "string",
+                "maxLength": 160
+              },
+              "settings_defaults": {
+                "type": "object",
+                "additionalProperties": false,
+                "properties": {
+                  "reasoning_effort": {
+                    "enum": [
+                      "none",
+                      "low",
+                      "medium",
+                      "high",
+                      "xhigh",
+                      "max",
+                      null
+                    ]
+                  },
+                  "max_output_tokens": {
+                    "type": [
+                      "integer",
+                      "null"
+                    ],
+                    "minimum": 0
+                  },
+                  "processing_tier": {
+                    "type": [
+                      "string",
+                      "null"
+                    ]
+                  },
+                  "required_capabilities": {
+                    "type": "array",
+                    "items": {
+                      "type": "string",
+                      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+                    },
+                    "maxItems": 32
+                  }
+                }
+              },
+              "accepted_by": {
+                "type": "string",
+                "description": "operator or policy id that accepted the binding"
+              },
+              "accepted_at": {
+                "type": "string",
+                "maxLength": 64
+              }
+            }
+          }
+        },
+        "role_defaults": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "coordinator": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "investigator": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "builder": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "reviewer": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "release-helper": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            }
+          }
+        },
+        "escalation": {
+          "type": "object",
+          "propertyNames": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "additionalProperties": {
+            "type": "array",
+            "items": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            }
+          },
+          "description": "same-provider escalation order of tier keys per role or job kind"
+        },
+        "catalog": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/catalogEntry"
+          }
+        },
+        "pricing": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/price"
+          }
+        },
+        "discovery": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "status"
+          ],
+          "properties": {
+            "status": {
+              "enum": [
+                "ok",
+                "failed",
+                "never"
+              ]
+            },
+            "last_attempt_at": {
+              "type": [
+                "string",
+                "null"
+              ]
+            },
+            "last_success_at": {
+              "type": [
+                "string",
+                "null"
+              ]
+            },
+            "error": {
+              "type": "string",
+              "maxLength": 200
+            }
+          }
+        }
+      }
+    },
+    "catalogEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "model",
+        "source",
+        "observed_at",
+        "lifecycle",
+        "classification"
+      ],
+      "properties": {
+        "model": {
+          "type": "string",
+          "maxLength": 160
+        },
+        "source": {
+          "enum": [
+            "api",
+            "manual"
+          ]
+        },
+        "observed_at": {
+          "type": "string",
+          "maxLength": 64
+        },
+        "family": {
+          "type": [
+            "string",
+            "null"
+          ],
+          "description": "provider family metadata, never a quality rating and never parsed from the id"
+        },
+        "lifecycle": {
+          "enum": [
+            "active",
+            "deprecated",
+            "retired",
+            "unknown"
+          ]
+        },
+        "shutdown_or_retire_at": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "capabilities": {
+          "type": [
+            "object",
+            "null"
+          ],
+          "additionalProperties": {
+            "enum": [
+              "supported",
+              "unsupported",
+              "unknown"
+            ]
+          }
+        },
+        "classification": {
+          "enum": [
+            "mapped",
+            "unclassified"
+          ]
+        },
+        "created_at": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "context_window": {
+          "type": [
+            "integer",
+            "null"
+          ],
+          "minimum": 0
+        },
+        "display_name": {
+          "type": [
+            "string",
+            "null"
+          ]
+        }
+      }
+    },
+    "price": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "model",
+        "currency",
+        "source",
+        "effective_date",
+        "per_million",
+        "processing_tier"
+      ],
+      "properties": {
+        "model": {
+          "type": "string",
+          "maxLength": 160
+        },
+        "currency": {
+          "type": "string",
+          "pattern": "^[A-Z]{3}$"
+        },
+        "source": {
+          "type": "string"
