@@ -0,0 +1,32 @@
+// Lifecycle evidence producer (Relay 1.3.0). The three schema-version-3 observations (record.added,
+// work.state.changed, execution.recorded) are written only when the repository turns relay.lifecycleEvidence on in
+// .mock2/checks.json, exactly like relay.checkEvidence: off by default, until every host the repository delivers to
+// reads Relay 1.3.0 or later (an older reader refuses them). MOCK2_RELAY=off records nothing;
+// MOCK2_RELAY_LIFECYCLE_EVIDENCE=1|0 overrides the setting for one process.
+import {readFileSync} from 'node:fs';
+import {join} from 'node:path';
+import {appendLocal,makeEvent} from './ledger.mjs';
+import {historyConfig} from './history.mjs';
+import {lifecycleTypes} from './events.mjs';
+export function lifecycleConfig(root,env=process.env){
+ if(env.MOCK2_RELAY==='off')return {enabled:false,reason:'MOCK2_RELAY=off'};
+ const override=env.MOCK2_RELAY_LIFECYCLE_EVIDENCE;
+ if(['1','0','true','false'].includes(override))return {enabled:override==='1'||override==='true',reason:'MOCK2_RELAY_LIFECYCLE_EVIDENCE='+override};
+ let checks;try{checks=JSON.parse(readFileSync(join(root,'.mock2','checks.json'),'utf8'));}catch{return {enabled:false,reason:'relay.lifecycleEvidence is off (no readable .mock2/checks.json)'};}
+ const relay=checks&&typeof checks==='object'&&!Array.isArray(checks)?checks.relay:undefined;
+ if(relay==null)return {enabled:false,reason:'relay.lifecycleEvidence is off'};
+ if(typeof relay!=='object'||Array.isArray(relay))return {enabled:false,reason:'relay must be an object; Relay lifecycle evidence is off',warning:true};
+ if(relay.lifecycleEvidence!=null&&typeof relay.lifecycleEvidence!=='boolean')return {enabled:false,reason:'relay.lifecycleEvidence must be true or false; Relay lifecycle evidence is off',warning:true};
+ return relay.lifecycleEvidence===true?{enabled:true,reason:'relay.lifecycleEvidence is on'}:{enabled:false,reason:'relay.lifecycleEvidence is off'};
+}
+export function lifecycleEvent(workspaceId,taskId,type,data,context={}){
+ if(!lifecycleTypes.includes(type))throw Error('Not a lifecycle evidence type: '+type);
+ return makeEvent(workspaceId,taskId,type,data,{...context,schemaVersion:3,minimumReaderVersion:'1.3.0'});
