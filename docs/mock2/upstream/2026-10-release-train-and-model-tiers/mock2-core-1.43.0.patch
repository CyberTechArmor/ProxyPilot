+test('MT-22 property: the resolved binding is always the resolved route or one named in a configured route', (t) => {
+  const f = fx(t); const rand = prng(2243); let routed = 0; let chained = 0;
+  for (let index = 0; index < 300; index += 1) {
+    const world = randomWorld(rand);
+    const named = world.qualifiedTiers;
+    const action = pick(rand, ['wait', 'ask', 'route', null]);
+    world.settings.budgets = { spend: [{ per: 'job', limit: (0.5 + rand() * 3).toFixed(2), currency: 'USD' }], unknown_price: pick(rand, ['treat-as-exhausted', 'allow']), ...(action ? { on_exhaust: action === 'route' ? { action, route: pick(rand, named) } : { action } } : {}) };
+    // Often route to the bound provider's economy tier, the usual cheaper target.
+    const bound = world.settings.roles.builder?.tier?.split('/')[0];
+    if (action === 'route' && bound && world.registry.providers[bound].tiers.economy && rand() < 0.6) world.settings.budgets.on_exhaust.route = `${bound}/economy`;
+    // Limits no route relieves (concurrency, retries, context) and one a capped target may relieve (output).
+    if (rand() < 0.1) world.settings.budgets.max_concurrency = 1;
+    if (rand() < 0.1) world.settings.budgets.max_retries = { transport: 1, repair_cycles: null };
+    if (rand() < 0.1) world.settings.budgets.max_context_tokens = 1000;
+    if (rand() < 0.1) world.settings.budgets.max_output_tokens = 1000;
+    // Chains: an on_exhaust hop followed by a retirement, outage or unavailability fallback of any kind.
+    for (const route of world.settings.routes.fallback) route.kind = pick(rand, ['provider-outage', 'retired-binding', 'budget', 'harness-substitution']);
+    f.write('project', world.settings);
+    const usage = { spend: [{ per: 'job', currency: 'USD', amount: rand() < 0.2 ? null : rand(), unpriced_calls: 0 }], concurrency: rand() < 0.5 ? 1 : 0, retries: { transport: rand() < 0.5 ? 1 : 0 } };
+    const estimate = { input_tokens: Math.floor(rand() * 1e6), output_tokens: Math.floor(rand() * 1e6), context_tokens: rand() < 0.5 ? 5000 : 500 };
+    world.job.retry = rand() < 0.5 ? 'transport' : undefined;
+    let availableModels = rand() < 0.4 ? Object.values(world.registry.providers).flatMap((p) => Object.values(p.tiers).map((x) => x.model)).filter(() => rand() < 0.6) : undefined;
+    const target = world.settings.budgets.on_exhaust?.route;
+    if (target && rand() < 0.6) {
+      const to = pick(rand, named.filter((key) => key !== target));
+      if (to) {
+        world.settings.routes.fallback.push({ from: target, to, cross_provider: target.split('/')[0] !== to.split('/')[0], permitted_for: 'builder', kind: 'provider-outage' });
+        const blocked = (() => { const [p, k] = target.split('/'); return world.registry.providers[p].tiers[k].model; })();
+        availableModels = Object.values(world.registry.providers).flatMap((p) => Object.values(p.tiers).map((x) => x.model)).filter((model) => model !== blocked);
+        f.write('project', world.settings);
+      }
+    }
+    const r = oc.resolveRole({ ...opts(f, world.registry), role: 'builder', budgetUsage: usage, availableModels, job: { ...world.job, estimate } });
+    const at = r.fallbacks?.findIndex((hop) => hop.kind === 'budget-on-exhaust') ?? -1;
+    if (at >= 0 && r.fallbacks.length > at + 1) chained += 1;
+    if (r.route && ['planned', 'planned-fallback'].includes(r.status) && at >= 0) {
+      // Every route dispatched after an on_exhaust hop was itself within the spend limit (or unknown under allow).
+      const p = oc.priceFor(world.registry, r.route.provider, r.route.model, r.route.settings.processing_tier);
+      const amount = p ? oc.estimateAmount(p, estimate).amount : null;
+      const used = usage.spend[0].amount;
+      if (amount === null || used === null) assert.equal(world.settings.budgets.unknown_price, 'allow', `case ${index}: unknown spend dispatched`);
+      else assert.ok(used + amount <= Number(world.settings.budgets.spend[0].limit), `case ${index}: ${r.route.tier} dispatched over budget`);
+    }
+    if (r.route && ['planned', 'planned-fallback'].includes(r.status)) {
+      const b = world.settings.budgets;
+      assert.ok(!(b.max_concurrency === 1 && usage.concurrency >= 1), `case ${index}: dispatched over the concurrency limit`);
+      assert.ok(!(b.max_retries && world.job.retry === 'transport' && usage.retries.transport >= 1), `case ${index}: dispatched over the retry limit`);
+      assert.ok(!(b.max_context_tokens && estimate.context_tokens > b.max_context_tokens), `case ${index}: dispatched over the context limit`);
+      if (b.max_output_tokens) assert.ok(Math.min(estimate.output_tokens, r.route.settings.max_output_tokens ?? Infinity) <= b.max_output_tokens, `case ${index}: dispatched over the output limit`);
+    }
+    if (!r.route) continue;
+    const allowed = new Set([r.requested_route?.tier, world.settings.budgets.on_exhaust?.route, ...(world.settings.routes.escalation.builder || []), ...(world.registry.providers[r.requested_route?.provider]?.escalation?.builder || []).map((tier) => `${r.requested_route.provider}/${tier}`), ...world.settings.routes.fallback.map((route) => route.to)].filter(Boolean));
+    assert.ok(allowed.has(r.route.tier), `case ${index}: ${r.route.tier} is not a configured route`);
+    if (r.resolution_source === 'budget-on-exhaust') { routed += 1; assert.ok(r.fallbacks.some((hop) => hop.kind === 'budget-on-exhaust' && hop.to.tier === world.settings.budgets.on_exhaust.route), `case ${index}`); }
+    for (const hop of r.fallbacks.filter((item) => item.kind === 'budget-on-exhaust' && item.cross_provider)) assert.ok(world.settings.routes.fallback.some((route) => route.from === hop.from.tier && route.to === hop.to.tier && route.cross_provider), `case ${index}: a cross-provider on_exhaust route needs a configured cross-provider route`);
+    if (r.budget && r.budget.action !== 'route') assert.equal(r.status, 'waiting');
+  }
+  assert.ok(routed >= 3 && chained > 0, `budget routes exercised: ${routed}, followed by a fallback: ${chained}`);
+});
