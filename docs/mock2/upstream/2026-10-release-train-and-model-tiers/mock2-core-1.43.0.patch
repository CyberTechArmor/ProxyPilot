+    '`builder · openai/economy · observed`', 'a 24-hour view is a reporting window, not a promise',
+    'A host that does not implement a part says so, and a documented contract is never reported as a running implementation.',
+  ]);
+  const lines = body.split('\n').filter((line) => line.trim()).length;
+  assert.ok(lines >= 70 && lines <= 110, `§AA is about eighty lines (${lines})`);
+  noGate('§AA', body, GATE_BUT_STAGE);
+  assert.ok(pro().trimEnd().endsWith(body.trimEnd()), '§AA is the last section');
+});
+
+test('MT text: §F, §I, §M.11, §P, §U and §R carry their one-line cross-references', () => {
