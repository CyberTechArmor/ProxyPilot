index 0000000000000000000000000000000000000000..2d25074de1d85e2e5b77452aa7443d1496e59b5a
--- /dev/null
+++ b/core/mock2/tests/model-tiers-text.test.mjs
@@ -0,0 +1,91 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readdirSync, readFileSync } from 'node:fs';
+import { join, relative } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// MT-20 (1.43.0): no current model release name in normative rule text, the routing guide, rule files or templates.
+// The denylist is generated, never written here: every model id the compatibility registry binds, plus the family
+// names the providers document, which 1.40.0 used to infer a provider from a model name (kept as data in the
+// registry's compatibility block). It runs over the whole tree except the compatibility registry, the 1.40.0
+// equivalence fixture, change records, history and release notes, and the generated copies (their canonical sources
+// are scanned). A second check finds the retired profile-based routing wording (H12–H19).
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const registry = JSON.parse(readFileSync(join(site, 'core/cpr/samples/model-registry.legacy-1.40.json'), 'utf8'));
+const ids = Object.values(registry.providers).flatMap((provider) => Object.values(provider.tiers).map((tier) => tier.model));
+const inference = Object.entries(registry.compatibility.retired_name_inference).filter(([key]) => key !== '$comment').map(([, value]) => value);
+const families = inference.flatMap((value) => value.family_names);
+const prefixes = inference.flatMap((value) => value.id_prefixes);
+const DENIED = [...new Set([...ids, ...families])];
+const escape = (text) => text.replace(/[.*+?^${}()|[\]\\]/gu, '\\$&');
+// A hyphen separates words: a family name followed or preceded by `-` and a version is caught. An id prefix (from the registry's data) catches any
+// release written as prefix-<letter or digit>; the agent tool name `claude-code` is allowed (000-READ-FIRST.md).
+// `<…>` placeholders are removed before matching.
+const NAMES = new RegExp([
+  `(?<![A-Za-z0-9_.])(?:${ids.map(escape).join('|')})(?![A-Za-z0-9_])`,
+  `(?<![A-Za-z0-9_])(?:${families.map(escape).join('|')})(?![A-Za-z_])`,
+  `(?<![A-Za-z0-9_])(?:${prefixes.map(escape).join('|')})(?!code\\b)[0-9a-z]`,
+].join('|'), 'iu');
+const unplaceheld = (line) => line.replace(/<[^<>\s]*>/gu, '');
+// Wording of the 1.40.0 profile model the standards text replaces with role tier bindings, settings and scope.
+const RETIRED = /built-in profile names|provider profiles?\b|profile, (?:a )?role(?:'s)? model|stronger in-profile worker|role models and effort|routing modes, profiles|profiles, role models/iu;
+
+// Files the standards-text pass of 1.43.0 rewrote are now held to the same check as every other file: no file
+// carries the retired wording. A later text pass that needs a grace period lists its files here.
+const PENDING_TEXT_REWRITE = [];
+
+const tpl = 'core/mock2/templates/repo/';
+const excluded = (path) => path.includes('/node_modules/') || path.startsWith('.git/')
+  || path === 'core/cpr/samples/model-registry.legacy-1.40.json' || path.endsWith('/standards/samples/model-registry.legacy-1.40.json')
+  || path === 'core/mock2/tests/fixtures/orchestration-1.40-profiles.json'
+  || path.startsWith('state/change-records/') || path === 'core/mock2/history.json' || path === 'release.json' || path === 'manifest.json'
+  || path === 'core/cpr/CPR-v1.1.md' || path === 'core/cpr/CPR-v1.1-addendum-A.md'
+  || path.endsWith('package-lock.json')
+  // generated copies, checked through their canonical sources
+  || path.startsWith(`${tpl}.mock2/standards/`) || path.startsWith(`${tpl}.mock2/features/relay/`) || path === `${tpl}.mock2/template-manifest.json`
+  || [`${tpl}CLAUDE.md`, `${tpl}AGENTS.md`, `${tpl}.github/copilot-instructions.md`].includes(path)
+  || path.startsWith(`${tpl}.github/agents/`) || path.startsWith(`${tpl}.github/prompts/`) || path.startsWith(`${tpl}.github/instructions/mock2-`) || path.startsWith(`${tpl}.claude/rules/mock2-`);
+function files(directory) {
+  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
+    const path = join(directory, entry.name);
+    if (entry.isDirectory()) return entry.name === 'node_modules' || entry.name === '.git' ? [] : files(path);
+    return /\.(?:md|mjs|js|cjs|ts|tsx|json|sh|ps1|py|html|css|ya?ml|toml|txt)$/u.test(entry.name) ? [path] : [];
+  });
+}
+const tree = files(site).map((path) => relative(site, path).replaceAll('\\', '/')).filter((path) => !excluded(path)).sort();
+
+test('MT-20 the denylist comes from the compatibility registry and the documented family names', () => {
+  assert.ok(ids.length >= 4 && families.length >= 4, `${ids.length} ids, ${families.length} families`);
+  assert.ok(DENIED.every((name) => NAMES.test(name) && NAMES.test(`use ${name.toUpperCase()} here`)));
+  assert.ok(prefixes.length >= 2, 'id prefixes come from the registry');
+  assert.ok(!NAMES.test(unplaceheld('placeholder <openai-economy-model-id> and <anthropic-flagship-model-id>')));
+  assert.ok(!NAMES.test('Claude Code, claude-code and the claude provider alias'));
+});
+
+test('MT-20 a synthetic file with hyphenated and future release names is caught', () => {
+  // Built from the registry's data so this file names no release itself: e.g. <prefix><family>-5-5, <family>-5, <prefix>7.
+  const [first, second] = prefixes;
+  const lines = [`Route review to ${second}${families[1]}-5-5.`, `The builder uses ${families[0]}-5 today.`, `Escalate to ${first}7 when stuck.`, `Pinned to ${families[1]}-4-1.`, `Old pin ${ids[0]}-preview.`];
+  assert.equal(lines[0].length > 20 && lines[2].includes(`${first}7`), true);
+  assert.deepEqual(lines.filter((line) => !NAMES.test(unplaceheld(line))), []);
+});
+
+test('MT-20 no current model release name outside the compatibility data, records and history', () => {
+  const found = [];
+  for (const path of tree) readFileSync(join(site, path), 'utf8').split('\n').forEach((line, index) => { if (NAMES.test(unplaceheld(line))) found.push(`${path}:${index + 1}`); });
+  assert.deepEqual(found, []);
+});
+
