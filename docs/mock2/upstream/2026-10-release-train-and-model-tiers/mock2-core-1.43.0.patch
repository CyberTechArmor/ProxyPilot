+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+// Provider-scoped model tiers (1.43.0), as standards text: requirement section 14, "Rule-text changes, file by file",
+// and H12–H20. The routing tool, its schemas, samples and contract documents are tested by model-tiers.test.mjs and the
+// orchestration tests; model-tiers-text.test.mjs checks that no file names a current model release (MT-20) or keeps the
+// retired profile-based wording. This file checks that each canonical text says what the tool implements. None of it is
+// a gate.
+const site = fileURLToPath(new URL('../../../', import.meta.url));
+const read = (path) => readFileSync(join(site, path), 'utf8');
+const flat = (text) => text.replace(/\s+/gu, ' ');
+const tpl = 'core/mock2/templates/repo/';
+// Gate wording (rule 0), as sizing.test.mjs and background-agents.test.mjs check it.
+const GATE = /wait (?:for|until)|go-ahead|approv|before proceeding|confirm (?:first|before)/iu;
+// The lifecycle text names its own stage "Approved plan and implementation authorization" and says a plan approval is
+// never deployment permission, so the lifecycle and routing text is held to the rest of the gate wording.
+const GATE_BUT_STAGE = /wait (?:for|until)|go-ahead|before proceeding|confirm (?:first|before)|new approval|approval (?:prompt|step|gate)/iu;
+const RETIRED_WORKER = /stronger worker|cheaper worker|stronger in-profile|provider profiles?\b/iu;
+
+function section(name, text, start, end) {
+  const at = text.indexOf(start);
+  assert.notEqual(at, -1, `${name}: no ${JSON.stringify(start.trim())}`);
+  const rest = text.slice(at + start.length);
+  const stop = typeof end === 'string' ? rest.indexOf(end) : rest.search(end);
+  return text.slice(at, stop === -1 ? text.length : at + start.length + stop);
+}
+function includesAll(name, text, phrases) {
+  const missing = phrases.filter((phrase) => !flat(text).includes(phrase));
+  assert.deepEqual(missing, [], `${name} lacks these phrases`);
+}
+function noGate(name, text, pattern = GATE) {
+  const match = pattern.exec(flat(text));
+  assert.equal(match, null, `${name} carries gate wording: ${match && match[0]}`);
+}
+const pro = () => read('core/cpr/CPR-v1.1-current.md');
+const sub = (id) => section(`§${id}`, pro(), `\n### ${id} `, /\n#{2,3} /u);
+const top = (letter, title) => section(`§${letter}`, pro(), `\n## ${letter}. ${title}`, /\n## [A-Z]{1,2}\. /u);
+const amended = (name, text) => section(`${name} 1.43.0`, text, '*Amended in 1.43.0:*', '\n\n');
+const orchestration = () => read(`${tpl}.mock2/orchestration.md`);
+
+test('MT text: the PRO amendment line names 1.43.0 first, with 1.42.0 as the previous amendment and no new gate', () => {
+  const text = pro();
+  const head = flat(text.slice(0, text.indexOf('\n---\n')));
+  includesAll('the amendment line', head, [
+    'Amended 2026-10-30, 1.43.0: provider-scoped model tiers, workflow and attribution (§AA, new)',
+    '(`openai/economy`, never `economy`)', 'no silent provider switch',
+    'It rewrites §M.12 and adds one line each to §F, §I, §M.11, §P, §U and §R. No new gate.',
+    'Previous amendment 2026-10-29, 1.42.0: the release train (§P.8, new)',
+  ]);
+  assert.ok(head.indexOf('1.43.0') < head.indexOf('Previous amendment 2026-10-29, 1.42.0'), 'the newest amendment comes first');
+});
