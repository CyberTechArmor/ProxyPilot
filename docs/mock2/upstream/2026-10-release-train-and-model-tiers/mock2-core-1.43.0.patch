diff --git a/core/mock2/templates/repo/.mock2/standards/schemas/model-registry.schema.json b/core/mock2/templates/repo/.mock2/standards/schemas/model-registry.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..326a31fd11369e6318f5163eced46fe1e6ccbbcf
--- /dev/null
+++ b/core/mock2/templates/repo/.mock2/standards/schemas/model-registry.schema.json
@@ -0,0 +1,448 @@
+{
+  "$id": "https://mock2.fractionate.ai/standards/schemas/model-registry.schema.json",
+  "$comment": "JSON Schema draft 2020-12. Mock2 model registry: host-owned and versioned; the only place concrete model ids live. Tiers are qualified by their provider (provider/tier) and bound by configuration, never by a family-to-tier rule. See Model-Routing.md.",
+  "title": "Mock2 model registry",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "registry_version",
+    "updated_at",
+    "providers"
+  ],
+  "properties": {
+    "$comment": {
+      "type": "string"
+    },
+    "non_normative": {
+      "type": "boolean",
+      "description": "true on samples and the compatibility registry"
+    },
+    "registry_version": {
+      "type": "string",
+      "maxLength": 64,
+      "description": "semantic version or date stamp; recorded on every execution"
+    },
+    "updated_at": {
+      "type": "string",
+      "maxLength": 64,
+      "description": "RFC 3339"
+    },
+    "default_provider": {
+      "type": "string",
+      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
+      "description": "provider for roles no settings layer names; absent means binding-missing, never a guessed provider"
+    },
+    "profiles": {
+      "type": "object",
+      "description": "named role-to-qualified-tier sets (the deprecated --profile alias and version-1 migration)",
+      "propertyNames": {
+        "type": "string",
+        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+      },
+      "additionalProperties": {
+        "type": "object",
+        "additionalProperties": false,
+        "properties": {
+          "coordinator": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "investigator": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "builder": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "reviewer": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "release-helper": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}/[a-z0-9][a-z0-9._-]{0,63}$"
+          }
+        }
+      }
+    },
+    "compatibility": {
+      "type": "object",
+      "description": "compatibility registry only: provenance, version-1 provider aliases (read only) and retired name-inference data"
+    },
+    "providers": {
+      "type": "object",
+      "propertyNames": {
+        "type": "string",
+        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+      },
+      "additionalProperties": {
+        "$ref": "#/$defs/provider"
+      }
+    }
+  },
+  "$defs": {
+    "provider": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "connections",
+        "tiers"
+      ],
+      "properties": {
+        "$comment": {
+          "type": "string"
+        },
+        "connections": {
+          "type": "array",
+          "items": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "id"
+            ],
+            "properties": {
+              "id": {
+                "type": "string",
+                "maxLength": 128
+              },
+              "endpoint_ref": {
+                "type": [
+                  "string",
+                  "null"
+                ],
+                "description": "opaque; never a secret"
+              },
+              "account_ref": {
+                "type": [
+                  "string",
+                  "null"
+                ],
+                "description": "opaque; never a secret"
+              }
+            }
+          }
+        },
+        "tiers": {
+          "type": "object",
+          "propertyNames": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "additionalProperties": {
+            "type": "object",
+            "additionalProperties": false,
+            "required": [
+              "connection",
+              "model",
+              "accepted_by",
+              "accepted_at"
+            ],
+            "properties": {
+              "$comment": {
+                "type": "string"
+              },
+              "connection": {
+                "type": "string"
+              },
+              "model": {
+                "type": "string",
+                "maxLength": 160
+              },
+              "settings_defaults": {
+                "type": "object",
+                "additionalProperties": false,
+                "properties": {
+                  "reasoning_effort": {
+                    "enum": [
+                      "none",
+                      "low",
+                      "medium",
+                      "high",
+                      "xhigh",
+                      "max",
+                      null
+                    ]
+                  },
+                  "max_output_tokens": {
+                    "type": [
+                      "integer",
+                      "null"
+                    ],
+                    "minimum": 0
+                  },
+                  "processing_tier": {
+                    "type": [
+                      "string",
+                      "null"
+                    ]
+                  },
+                  "required_capabilities": {
+                    "type": "array",
+                    "items": {
+                      "type": "string",
+                      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+                    },
+                    "maxItems": 32
+                  }
+                }
+              },
+              "accepted_by": {
+                "type": "string",
+                "description": "operator or policy id that accepted the binding"
+              },
+              "accepted_at": {
+                "type": "string",
+                "maxLength": 64
+              }
+            }
+          }
+        },
+        "role_defaults": {
+          "type": "object",
+          "additionalProperties": false,
+          "properties": {
+            "coordinator": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "investigator": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "builder": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "reviewer": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            },
+            "release-helper": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            }
+          }
+        },
+        "escalation": {
+          "type": "object",
+          "propertyNames": {
+            "type": "string",
+            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+          },
+          "additionalProperties": {
+            "type": "array",
+            "items": {
+              "type": "string",
+              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+            }
+          },
+          "description": "same-provider escalation order of tier keys per role or job kind"
+        },
+        "catalog": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/catalogEntry"
+          }
+        },
+        "pricing": {
+          "type": "array",
+          "items": {
+            "$ref": "#/$defs/price"
+          }
+        },
+        "discovery": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "status"
+          ],
+          "properties": {
+            "status": {
+              "enum": [
+                "ok",
+                "failed",
+                "never"
+              ]
+            },
+            "last_attempt_at": {
+              "type": [
+                "string",
+                "null"
+              ]
+            },
+            "last_success_at": {
+              "type": [
+                "string",
+                "null"
+              ]
+            },
+            "error": {
+              "type": "string",
+              "maxLength": 200
+            }
+          }
+        }
+      }
+    },
+    "catalogEntry": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "model",
+        "source",
+        "observed_at",
+        "lifecycle",
+        "classification"
+      ],
+      "properties": {
+        "model": {
+          "type": "string",
+          "maxLength": 160
+        },
+        "source": {
+          "enum": [
+            "api",
+            "manual"
+          ]
+        },
+        "observed_at": {
+          "type": "string",
+          "maxLength": 64
+        },
+        "family": {
+          "type": [
+            "string",
+            "null"
+          ],
+          "description": "provider family metadata, never a quality rating and never parsed from the id"
+        },
+        "lifecycle": {
+          "enum": [
+            "active",
+            "deprecated",
+            "retired",
+            "unknown"
+          ]
+        },
+        "shutdown_or_retire_at": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "capabilities": {
+          "type": [
+            "object",
+            "null"
+          ],
+          "additionalProperties": {
+            "enum": [
+              "supported",
+              "unsupported",
+              "unknown"
+            ]
+          }
+        },
+        "classification": {
+          "enum": [
+            "mapped",
+            "unclassified"
+          ]
+        },
+        "created_at": {
+          "type": [
+            "string",
+            "null"
+          ]
+        },
+        "context_window": {
+          "type": [
+            "integer",
+            "null"
+          ],
+          "minimum": 0
+        },
+        "display_name": {
+          "type": [
+            "string",
+            "null"
+          ]
+        }
+      }
+    },
+    "price": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "model",
+        "currency",
+        "source",
+        "effective_date",
+        "per_million",
+        "processing_tier"
+      ],
+      "properties": {
+        "model": {
+          "type": "string",
+          "maxLength": 160
+        },
+        "currency": {
+          "type": "string",
+          "pattern": "^[A-Z]{3}$"
+        },
+        "source": {
+          "type": "string"
+        },
+        "effective_date": {
+          "type": "string",
+          "maxLength": 64
+        },
+        "per_million": {
+          "type": "object",
+          "additionalProperties": false,
+          "required": [
+            "input",
+            "cached_input_read",
+            "cache_write",
+            "output"
+          ],
+          "properties": {
+            "input": {
+              "type": [
+                "number",
+                "null"
+              ],
+              "minimum": 0
+            },
+            "cached_input_read": {
+              "type": [
+                "number",
+                "null"
+              ],
+              "minimum": 0
+            },
+            "cache_write": {
+              "type": [
+                "number",
+                "null"
+              ],
+              "minimum": 0
+            },
+            "output": {
+              "type": [
+                "number",
+                "null"
+              ],
+              "minimum": 0
+            }
+          }
+        },
+        "processing_tier": {
+          "type": "string",
+          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
+        }
+      }
+    }
+  }
+}
