diff --git a/core/mock2/tests/model-tiers-review.test.mjs b/core/mock2/tests/model-tiers-review.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..28314bbcd62b4d3346d3f8569b58d1adba3b36db
--- /dev/null
+++ b/core/mock2/tests/model-tiers-review.test.mjs
@@ -0,0 +1,277 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync, mkdirSync, writeFileSync, readFileSync, rmSync, copyFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, dirname } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import * as oc from '../templates/repo/.mock2/bin/orchestration-config.mjs';
+import { planAdapter } from '../templates/repo/.mock2/bin/orchestration-adapters.mjs';
+
+// Independent review of 1.43.0 routing (H1–H3, M1–M9, L1–L7 and the nits): each finding's reproduction as a test.
+// Two fake providers, pa and pb, with placeholder model ids; no network and no paid call.
+delete process.env.MOCK2_MODEL_REGISTRY; delete process.env.MOCK2_ORCHESTRATION_ENVIRONMENT;
+const here = (path) => fileURLToPath(new URL(path, import.meta.url));
+const cli = here('../templates/repo/.mock2/bin/orchestrate.mjs');
+const COMPAT = here('../../cpr/samples/model-registry.legacy-1.40.json');
+const entry = (model, extra = {}) => ({ model, source: 'manual', observed_at: '2026-10-01', family: null, lifecycle: 'active', shutdown_or_retire_at: null, capabilities: { tools: 'supported' }, classification: 'mapped', ...extra });
+const price = (model, input, output, extra = {}) => ({ model, currency: 'USD', source: 's', effective_date: '2026-10-01', per_million: { input, cached_input_read: input / 10, cache_write: input, output }, processing_tier: 'standard', ...extra });
+const tier = (connection, model, extra = {}) => ({ connection, model, accepted_by: 'op', accepted_at: '2026-10-01', ...extra });
+const defaults = { coordinator: 'economy', investigator: 'economy', builder: 'economy', reviewer: 'flagship', 'release-helper': 'economy' };
+function reg() {
+  return { registry_version: 'r1', updated_at: '2026-10-01T00:00:00Z', default_provider: 'pa', providers: {
+    pa: { connections: [{ id: 'ca' }], tiers: { economy: tier('ca', 'pa-eco', { settings_defaults: { reasoning_effort: 'medium' } }), flagship: tier('ca', 'pa-flag', { settings_defaults: { reasoning_effort: 'high' } }) }, role_defaults: { ...defaults }, escalation: { builder: ['economy', 'flagship'] }, catalog: [entry('pa-eco'), entry('pa-flag')], pricing: [price('pa-eco', 1, 2), price('pa-flag', 10, 20)] },
+    pb: { connections: [{ id: 'cb' }], tiers: { economy: tier('cb', 'pb-eco'), flagship: tier('cb', 'pb-flag') }, role_defaults: { ...defaults }, catalog: [entry('pb-eco'), entry('pb-flag')], pricing: [price('pb-eco', 0.001, 0.001), price('pb-flag', 50, 100)] } } };
+}
+function fx(t) {
+  const base = mkdtempSync(join(tmpdir(), 'mock2-review-'));
+  const projectRoot = join(base, 'project'); const homeDir = join(base, 'home');
+  mkdirSync(join(projectRoot, '.mock2'), { recursive: true }); mkdirSync(join(homeDir, '.mock2'), { recursive: true });
+  t.after(() => rmSync(base, { recursive: true, force: true }));
+  const write = (path, value) => { mkdirSync(dirname(path), { recursive: true }); writeFileSync(path, JSON.stringify(value)); return path; };
+  return { base, projectRoot, homeDir, project: (value) => write(join(projectRoot, '.mock2', 'orchestration.json'), value), user: (value) => write(join(homeDir, '.mock2', 'orchestration.json'), value), write };
+}
+const resolveAt = (f, registry, extra) => oc.resolveRole({ projectRoot: f.projectRoot, homeDir: f.homeDir, registry, role: 'builder', ...extra });
+const big = { estimate: { input_tokens: 1e6, output_tokens: 1e6 } };
+const close = (a, b) => Math.abs(a - b) < 1e-12;
+
+test('H1 an on_exhaust route to another provider is used only through a configured, permitted cross-provider route, and is recorded', (t) => {
+  const f = fx(t); const budgets = { spend: [{ per: 'job', limit: '0.01', currency: 'USD' }], on_exhaust: { action: 'route', route: 'pb/economy' } };
+  f.project({ version: 2, budgets });
+  const refused = resolveAt(f, reg(), { job: big });
+  assert.deepEqual([refused.status, refused.route.provider, refused.waiting_reason], ['waiting', 'pa', 'capacity']); assert.match(refused.reason, /no provider switch is silent/u);
+  f.project({ version: 2, budgets, routes: { fallback: [{ from: 'pa/economy', to: 'pb/economy', cross_provider: true, permitted_for: 'reviewer' }] } });
+  assert.equal(resolveAt(f, reg(), { job: big }).status, 'waiting', 'not permitted for the builder');
+  f.project({ version: 2, budgets, routes: { fallback: [{ from: 'pa/economy', to: 'pb/economy', cross_provider: true, permitted_for: 'builder' }] } });
+  const routed = resolveAt(f, reg(), { job: big });
+  assert.deepEqual([routed.status, routed.route.tier, routed.resolution_source, routed.requested_route.provider], ['planned-fallback', 'pb/economy', 'budget-on-exhaust', 'pa']);
+  assert.deepEqual([routed.fallback.kind, routed.fallback.cross_provider, routed.fallback.from.tier, routed.fallback.to.tier], ['budget-on-exhaust', true, 'pa/economy', 'pb/economy']);
+  const record = oc.buildExecutionRecord({ pin: oc.pinAttempt(routed, { attemptId: 'a' }), registry: reg() });
+  assert.deepEqual([record.requested.provider, record.fallbacks.length, record.fallbacks[0].kind, record.fallbacks[0].from.provider], ['pb', 1, 'budget-on-exhaust', 'pa']);
