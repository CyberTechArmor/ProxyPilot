 func (manager *HttpManagerCtx) Start() {
+	// ProxyPilot A7: a bind of "unix:<path>" serves on a Unix socket (mode 0600)
+	// instead of TCP, so the server opens no network listener, loopback included.
+	if socketPath, ok := strings.CutPrefix(manager.config.Bind, "unix:"); ok {
+		_ = os.Remove(socketPath)
